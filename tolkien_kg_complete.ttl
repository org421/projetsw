    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Nearest Haven: LórienPlayable: Items (minor, major, gold ring)Automatic-attacks: Wolves — 3 strikes with 7 prowess"@en,
        "Refugio más cercano: LórienJugable: Objetos (menores, mayores, anillos de oro)Ataques Automáticos: Lobos — 3 golpes de poder 7"@es,
        "Havre le plus proche : LórienJouable : Objet (mineur, majeur, anneau d’or)Attaques automatiques :Loups — 3 coups avec 7 en prouesse"@fr ;
    meccg_prop:quote "“… four mighty piers of many-sided stone were welded into one, but near the summit they opened into gaping horns, their pinnacles sharp as the points of spears…” —LotRIII"@en,
        "“… cuatro poderosos pilares de piedra facetada se fundían en uno, que apuntaba al cielo, pero cerca de la cima se abrían y se separaban como cuernos, de pináculos puntiagudos como puntas de lanza… ” —SdlA II"@es,
        "[...] quatre puissants piliers de pierre à plusieurs côtés étaient soudés en un seul, mais près du sommet, ils s’ouvraient en cornes écartées aux pinacles aussi aigus que des fers de lance [...] —SdAIII"@fr ;
    meccg_prop:rarity "F2" ;
    tolkien_prop:depicts tolkien:Isengard .

meccg:TW-406 a schema1:Place,
        meccg_class:Card,
        meccg_class:Site ;
    rdfs:label "Seestadt"@de,
        "Lake-town"@en,
        "Ciudad del Lago"@es,
        "Järvikaupunki"@fi,
        "Ville du Lac"@fr,
        "Pontelagolungo"@it,
        "湖の町"@ja,
        "Lake-town"@nl ;
    dc:creator "Eric David Anderson" ;
    dc:identifier "TW-406" ;
    schema1:about tolkien:Lake-town ;
    schema1:creator "Eric David Anderson" ;
    schema1:name "Lake-town" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "Laketown.jpg" ;
    meccg_prop:cardSet "TW" ;
