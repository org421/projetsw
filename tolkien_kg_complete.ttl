        "Valle"@es,
        "Le Val"@fr,
        "Dale"@nl ;
    dc:creator "Angus McBride" ;
    dc:identifier "LE-363" ;
    schema1:about tolkien:Dale ;
    schema1:creator "Angus McBride" ;
    schema1:name "Dale" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "Dale.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Nearest Darkhaven: Dol GuldurPlayable: Items (gold ring)Automatic-attacks:Men — each character faces 1 strike with 5 prowess (detainment against covert company)"@en,
        "Refugio Oscuro más cercano: Dol GuldurJugable: Objetos (anillos de oro)Ataques Automáticos:Hombres — cada personaje se enfrenta a 1 golpe de poder 5 (de retención contra compañías encubiertas)"@es,
        "Havre Noir le plus proche : Dol GuldurJouable : Objet (anneau d'or)Attaques automatiques :Humains — chaque personnage affronte 1 coup avec 5 en prouesse (dilatoire contre une compagnie voilée)."@fr ;
    meccg_prop:quote "“‘You should see the waterways of Dale… and the mountains, and the pools… and the stone-paved roads of many colors!’” —LotRII"@en,
        "“ʻ¡Tendría usted que ver los canales de Valle… y las montañas y las fuentes… y las calzadas de piedra de distintos colores!ʼ” —SdlA II"@es,
        "“Il faudrait que vous voyiez les canaux du Val, Frodon, et les montagnes, et les fontaines ! Vous devriez voir les routes pavées de diverses couleurs !” —SdAII"@fr ;
    meccg_prop:rarity "F2" ;
    tolkien_prop:depicts tolkien:Dale .

meccg:LE-364 a schema1:Place,
        meccg_class:Card,
