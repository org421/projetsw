    meccg_prop:mind "3" ;
    meccg_prop:prowess "0" ;
    meccg_prop:quote "“Some of Frodo’s friends came to stay and help him with the packing…” —LotRI"@en,
        "“Algunos amigos de Frodo llegaron para ayudarle a embalar…” —SdlA I"@es,
        "Des amis de Frodon vinrent en séjour pour l’aider à emballer […] —SdAI"@fr ;
    meccg_prop:race "Hobbit" ;
    meccg_prop:rarity "U2" ;
    meccg_prop:skills "Scout" ;
    tolkien_prop:depicts tolkien:Folco_Boffin .

