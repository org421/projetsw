    meccg_prop:marshallingPoints "2" ;
    meccg_prop:mind "5" ;
    meccg_prop:prowess "2" ;
    meccg_prop:quote "“Thus the shadow deepened, and the thought of death darkened the hearts of the people.” —LotR"@en,
        "“Así, la sombra creció y el pensamiento de la muerte oscurecía el corazón de la gente.” —SdlA Apéndices"@es,
        "“Ainsi l’ombre s’approfondissait, et la pensée de la mort assombrissait le cœur des gens.” —SdA"@fr ;
    meccg_prop:race "Dúnadan" ;
    meccg_prop:rarity "U" ;
