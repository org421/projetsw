    dc:creator "Chris Trevas" ;
    dc:identifier "AS-12" ;
    schema1:creator "Chris Trevas" ;
    schema1:name "Knights of the Prince" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "8" ;
    meccg_prop:cardImage "KnightsofthePrince.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Dúnedain. Four strikes. Detainment against hero companies. Playable at Anfalas, Belfalas, Lamedon, Lebennin, or Anórien; or at sites in these regions. Unless the attack is canceled, all untapped characters in defending company are tapped following this attack."@en,
        "Único. Dúnedain. Cuatro golpes. Retención contra compañías de héroes. Jugable en: Anfalas, Belfalas, Lamedon, Lebennin, o Anórien; o en los lugares de dichas regiones. A menos que el ataque sea cancelado, todos los personajes de la compañía defensora son girados después del ataque."@es,
        "Unique. Dúnedain. 4 coups. Dilatoire contre les compagnies de héros. Peuvent être joués en association avec l’Anfalas, le Belfalas, le Lamedon, le Lebennin ou l’Anórien ainsi qu’aux sites de ces régions. À moins que l’attaque soit annulée, tous les personnages défenseurs désengagés de la compagnie sont engagés à la suite de cette attaque."@fr ;
    meccg_prop:marshallingPoints "3*" ;
    meccg_prop:prowess "10" ;
    meccg_prop:quote "“… tall men and proud with sea-grey eyes.” —LotRV"@en,
        "“… hombres altos y orgullosos, con los ojos grises como el mar.” —SdlA III"@es,
        "[...] des hommes fiers et de grande taille, aux yeux gris de mer. —SdAV"@fr ;
    meccg_prop:race "Dúnedain" ;
    meccg_prop:rarity "R2" .

meccg:AS-120 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Nûriags"@de,
        "Nûriags"@en,
        "Nûriags"@es,
        "Nûriags"@fr,
        "Nûriags"@nl ;
    dc:creator "Chris Trevas" ;
    dc:identifier "AS-120" ;
    schema1:creator "Chris Trevas" ;
    schema1:name "Nûriags" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "Nuriags.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Playable at Variag Camp  if the influence check is greater than 9. Standard Modifications: Haradrim (+2), Southrons (-2)."@en,
        "Única. Jugable en el Campamento Variag si el chequeo de influencia es superior a 9. Modificaciones Estándar: Haradrim (+2), Sureños (-2)."@es,
        "Unique. Peuvent être joués au Camp Variag si le test d’influence est supérieur à 9.Modificateurs standards : Haradrim (+2), Suderons (-2)."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:quote "“They swift masters of the steppe, following  the course of nearly traceless paths and always  knowing where to find sweet water.” —Kuduk Lore"@en,
        "“Son los rápidos amos de la estepa, que siguen el curso de senderos imposibles de distinguir y siempre saben dónde encontrar agua dulce” —Sabiduría Kuduk"@es,
        "Ils sont les maîtres rapides de la steppe, suivant le cours de chemins presque sans trace et sachant toujours où trouver de l’eau douce. —Légende kuduk"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "U2" .

meccg:AS-121 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Orks von Dol Guldur"@de,
        "Orcs of Dol Guldur"@en,
        "Orcos de Dol Guldur"@es,
        "Orques de Dol Guldur"@fr,
        "Orcs of Dol Guldur"@nl ;
    dc:creator "Omar Rayyan" ;
    dc:identifier "AS-121" ;
    schema1:creator "Omar Rayyan" ;
    schema1:name "Orcs of Dol Guldur" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "OrcsofDolGuldur.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Playable at Dol Guldur  if the influence check is greater than 8.Once in play, the number required to influence this faction is 0.Standard Modifications: Orcs of Moria (-2), Orcs of the Red Eye (+2)."@en,
        "Única. Jugable en Dol Guldur si el chequeo de influencia es superior a 8.Una vez en juego, el número necesario para influir esta facción es 0. Modificaciones Estándar: Orcos de Moria (-2), Orcos del Ojo Rojo (+2)."@es,
        "Unique. Peuvent être joués à Dol Guldur si le test d’influence est supérieur à 8. Modificateurs standards : Orques de la Moria (-2), Orques de l’Œil Rouge (+2). Une fois en jeu, le nombre requis pour influencer cette faction est 0."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:quote "“Three times Lórien had been assailed from Dol Guldur…” —LotR"@en,
        "“Tres veces había sido atacado Lórien desde Dol Guldur...” —SdlA Apéndices"@es,
        "Par trois fois, la Lórien avait résisté aux attaques de Dol Guldur [...] —SdA"@fr ;
    meccg_prop:race "Orc" ;
    meccg_prop:rarity "R2" .

meccg:AS-122 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Alte schwarze Axt"@de,
        "Ancient Black Axe"@en,
        "Antigua Hacha Negra"@es,
        "Ancienne hache noire"@fr,
        "Ancient Black Axe"@nl ;
    dc:creator "Audrey Corman" ;
    dc:identifier "AS-122" ;
    schema1:creator "Audrey Corman" ;
    schema1:name "Ancient Black Axe" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "AncientBlackAxe.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Playable at any Under-deeps Shadow-hold [{S}]. Weapon. +2 direct influence. Warrior only: +3 prowess (to a maximum of 11); -1 to strike’s body; tap this item to make a character at the same site automatically pass a corruption check. When this item becomes tapped, bearer makes a corruption check."@en,
        "Única. Jugable en un Bastión de la Sombra [{S}] de las Profundidades.Arma. +2 a la influencia directa. Solo guerreros: +3 al poder (hasta un máximo de 11); -1 a la resistencia del golpe; gira este objeto para hacer que un personaje que se encuentre en el mismo lugar pase un chequeo de corrupción automáticamente. Cuando este objeto es girado, el portador debe hacer un chequeo de corrupción."@es,
        "Unique. Arme. Peut être jouée à n’importe quel fief de l’ombre [{S}] des Abîmes. +2 à l’influence directe. Guerrier seulement : +3 à la prouesse (maximum 11) ; -1 à l’endurance du coup ; engagez cet objet pour qu’un personnage au même site réussisse automatiquement un test de corruption. Lorsque cet objet est engagé, le porteur fait un test de corruption."@fr ;
    meccg_prop:marshallingPoints "4" ;
    meccg_prop:rarity "R2" .

meccg:AS-123 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Zwergenring von Thélors Volk"@de,
        "Dwarven Ring of Thélor’s Tribe"@en,
        "Anillo Enano de la Tribu de Thélor"@es,
        "Anneau Nain de la tribu de Thélor"@fr,
        "Dwarven Ring of Thélor's Tribe"@nl ;
    dc:creator "Christina Wald" ;
    dc:identifier "AS-123" ;
    schema1:creator "Christina Wald" ;
    schema1:name "Dwarven Ring of Thélor’s Tribe" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "DwarvenRingofThelorsTribe.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Dwarven Ring. Playable only with a gold ring and after a test indicates a Dwarven Ring. Values in parentheses apply to a Dwarf bearer. Tap a Dwarf bearer to search your play deck and/or your discard pile for any one or two minor items; place these items in your hand and reshuffle your play deck. Bearer then makes a corruption check modified by +2."@en,
        "Único. Anillo Enano. Solo puede ser jugado con un anillo de oro y después de que un examen indique un Anillo Enano. Los valores entre paréntesis se aplican a un portador Enano. Gira un portador Enano para buscar en tu mazo de juego y/o tu pila de descartes uno o dos objetos menores; coloca estos objetos en tu mano y vuelve a barajar el mazo de juego. El portador debe hacer un chequeo de corrupción modificado con un +2."@es,
        "Unique. Anneau Nain. Ne peut être joué qu’avec un anneau d’or et après qu’une vérification ait indiqué un anneau Nain. Les valeurs entre parenthèses ou crochets s’appliquent à un porteur Nain. Engagez un porteur Nain pour chercher dans votre pioche (remélangez-la) et/ou votre pile de défausse 1 ou 2 objets mineurs ; mettez ces objets dans votre main. Le porteur fait alors un test de corruption modifié de +2."@fr ;
    meccg_prop:marshallingPoints "4" ;
    meccg_prop:rarity "U2" .

meccg:AS-124 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Zwergenring von Thrárs Volk"@de,
        "Dwarven Ring of Thrár’s Tribe"@en,
        "Anillo Enano de la Tribu de Thrár"@es,
        "Anneau Nain de la tribu de Thrár"@fr,
        "Dwarven Ring of Thrár's Tribe"@nl ;
    dc:creator "Quinton Hoover" ;
    dc:identifier "AS-124" ;
    schema1:creator "Quinton Hoover" ;
    schema1:name "Dwarven Ring of Thrár’s Tribe" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "DwarvenRingofThrarsTribe.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Dwarven Ring. Playable only with a gold ring and after a test indicates a Dwarven Ring. Values in parentheses apply to a Dwarf bearer. Tap a Dwarf bearer to search your play deck and/or your discard pile for any one or two minor items; place these items in your hand and reshuffle your play deck. Bearer then makes a corruption check modified by +2."@en,
        "Único. Anillo Enano. Solo puede ser jugado con un anillo de oro y después de que un examen indique un Anillo Enano. Los valores entre paréntesis se aplican a un portador Enano. Gira un portador Enano para buscar en tu mazo de juego y/o tu pila de descartes uno o dos objetos menores; coloca estos objetos en tu mano y vuelve a barajar el mazo de juego. El portador debe hacer un chequeo de corrupción modificado con un +2."@es,
        "Unique. Anneau Nain. Ne peut être joué qu’avec un anneau d’or et après qu’une vérification ait indiqué un anneau Nain. Les valeurs entre parenthèses ou crochets s’appliquent à un porteur Nain. Engagez un porteur Nain pour chercher dans votre pioche (remélangez-la) et/ou votre pile de défausse 1 ou 2 objets mineurs ; mettez ces objets dans votre main. Le porteur fait alors un test de corruption modifié de +2."@fr ;
    meccg_prop:marshallingPoints "4" ;
    meccg_prop:rarity "U2" .

meccg:AS-125 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Senkblei der Orks"@de,
        "Goblin Earth-plumb"@en,
        "Sonda de Trasgo"@es,
        "Fil à plomb Gobelin"@fr,
        "Goblin Earth-plumb"@nl ;
    dc:creator "Audrey Corman" ;
    dc:identifier "AS-125" ;
    schema1:creator "Audrey Corman" ;
    schema1:name "Goblin Earth-plumb" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "GoblinEarthplumb.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Playable only on an Orc or Troll. +1 to all rolls required for bearer’s company to move to adjacent Under-deeps sites."@en,
        "Solo se puede jugar sobre un Orco o un Troll. +1 a todas las tiradas de la compañía del portador necesarias para moverse a Lugares de las Profundidades adyacentes."@es,
        "Ne peut être joué que sur un Orque ou un Troll. +1 à tous les jets nécessaires à la compagnie du porteur pour se déplacer vers un site des Abîmes adjacent."@fr ;
    meccg_prop:quote "“Now goblins are cruel, wicked, and bad-hearted. They make no beautiful things, but they make many clever ones… . It is not unlikely that they invented some of the machines that have since troubled the world…” —Hob"@en,
        "“Ahora bien, los trasgos son crueles, malvados y de mal corazón. No hacen nada bonito, pero sí muchas cosas ingeniosas… Es probable que ellos hayan inventado algunas de las máquinas que desde entonces preocupan al mundo…” —Hob"@es,
        "Les gobelins sont cruels, méchants, et ils ont le cœur mauvais. Ils ne fabriquent pas de belles choses, mais ils en font d’habiles [...] Il n’est pas invraisemblable qu’ils aient inventé certains des engins qui ont depuis jeté le trouble dans le monde. —Hob"@fr ;
    meccg_prop:rarity "C2" .

meccg:AS-126 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Helm der Furcht"@de,
        "Helm of Fear"@en,
        "Yelmo del Miedo"@es,
        "Heaume de la peur"@fr,
        "Helm of Fear"@nl ;
    dc:creator "N. Taylor Blanchard" ;
    dc:identifier "AS-126" ;
    schema1:creator "N. Taylor Blanchard" ;
    schema1:name "Helm of Fear" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "HelmofFear.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Playable at a tapped or untapped Barad-dûr and only on your Ringwraith (does not tap the site). This item only affects a Ringwraith. Tap this item to cancel an attack against the Ringwraith’s company. May not cancel combat with a hero company. All body checks against the bearer are modified by -1.Cannot be included in a Balrog's deck."@en,
        "Único. Jugable en Barad-dûr, girado o enderezado sobre tu Espectro del Anillo (no gira el lugar). Este objeto solo afecta a un Espectro del Anillo. Gira este objeto para cancelar un ataque contra la compañía del Espectro del Anillo. No puede cancelar un combate contra una compañía de héroes. Todos los chequeos de resistencia contra el portador son modificados con un -1. No se puede incluir en un mazo Balrog."@es,
        "Unique. Peut être joué à Barad-dûr engagé ou non et uniquement sur votre Spectre (n’engage pas le site). Cet objet n’affecte qu’un Spectre. Engagez cet objet pour annuler une attaque contre la compagnie qui contient votre Spectre. Ne peut annuler un combat contre une compagnie de héros. -1 à tous les tests d’endurance contre le porteur. Ne peut être inclus dans le paquet d’un joueur Balrog."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:quote "“… a helm like a crown that flickered with a perilous light.” —LotRIV"@en,
        "“… un yelmo como una corona que parpadeaba con una luz peligrosa.” —SdlA II"@es,
        "[...] un heaume semblable à une couronne, qui scintillait d’une inquiétante lumière. —SdAIV"@fr ;
    meccg_prop:rarity "U2" .

meccg:AS-127 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Alter Eisenschild"@de,
        "Iron Shield of Old"@en,
        "Antiguo Escudo de Hierro"@es,
        "Bouclier de fer des temps anciens"@fr,
        "Iron Shield of Old"@nl ;
    dc:creator "Audrey Corman" ;
    dc:identifier "AS-127" ;
    schema1:creator "Audrey Corman" ;
    schema1:name "Iron Shield of Old" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "IronShieldofOld.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Shield. Playable at any Under-deeps Shadow-hold [{S}] or Ruins & Lairs [{R}]. +2 to all rolls required for bearer’s company to move to adjacent Under-deeps sites. Warrior only: tap this item to make one strike against its bearer ineffectual (i. e., the strike neither succeeds nor fails)."@en,
        "Escudo. Jugable en un Bastión de la Sombra [{S}] o unas Ruinas y Guaridas [{R}] de las Profundidades. +2 a todas las tiradas realizadas por la compañía del portador para moverse a los Lugares de las Profundidades adyacentes. Solo guerreros: gira este objeto para hacer que un golpe contra su portador no tenga efecto (es decir, no tiene éxito ni falla)."@es,
        "Bouclier. Peut être joué à n’importe quel fief de l’ombre [{S}] ou ruines et antres [{R}] des Abîmes. +2 à tous les jets nécessaires à la compagnie du porteur pour se déplacer vers un site des Abîmes adjacent. Guerrier seulement : Engagez cet objet pour rendre inoffensif un coup contre le porteur (c’est-à-dire qu’il n’échoue pas mais ne réussit pas)."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:quote "“Morgoth’s troops were shod with iron and iron-shielded…” —Kuduk Lore"@en,
        "“Las tropas de Morgoth estaban protegidas con hierro y equipadas con hierro…” —Sabiduría Kuduk"@es,
        "Les troupes de Morgoth étaient cuirassées de fer de la tête aux pieds [...] —Légende kuduk"@fr ;
    meccg_prop:rarity "C2" .

meccg:AS-128 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Halsschmuck von Girion"@de,
        "Necklace of Girion"@en,
        "Collar de Girion"@es,
        "Collier de Girion"@fr,
        "Necklace of Girion"@nl ;
    dc:creator "Audrey Corman" ;
    dc:identifier "AS-128" ;
    schema1:creator "Audrey Corman" ;
    schema1:name "Necklace of Girion" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "NecklaceofGirion.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Playable at The Lonely Mountain. Bearer receives +3 direct influence against Men and Man factions. If bearer is at a Border-hold [{B}] during the site phase, he can make a corruption check, and, if successful, discard this item to play up to 3 non-unique minor and/or major items with his company. Characters need not tap to receive these items."@en,
        "Único. Jugable en La Montaña Solitaria. El portador recibe +3 a la influencia directa contra Hombres y facciones de Hombres. Si el portador se encuentra en un Bastión Fronterizo [{B}] durante la fase de lugares, puede hacer un chequeo de corrupción y, si tiene éxito, descartar este objeto para poner en juego hasta 3 objetos menores y/o mayores que no sean únicos en su compañía. Los personajes no necesitan girarse para recibir dichos objetos."@es,
        "Unique. Peut être joué au Mont Solitaire. Le porteur reçoit +3 à l’influence directe sur les Humains et les factions d’Humains. Si le porteur se trouve à un fief frontalier [{B}] pendant la phase de site, il peut faire un test de corruption et, s’il réussit, vous pouvez défausser cet objet pour jouer jusqu’à 3 objets mineurs et/ou majeurs non uniques avec sa compagnie. Les personnages n’ont pas besoin de s’engager pour recevoir ces objets."@fr ;
    meccg_prop:marshallingPoints "3" ;
    meccg_prop:rarity "R2" .

meccg:AS-129 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Alter Schatz"@de,
        "Old Treasure"@en,
        "Viejas Joyas"@es,
        "Vieux trésor"@fr,
        "Old Treasure"@nl ;
    dc:creator "N. Taylor Blanchard" ;
    dc:identifier "AS-129" ;
    schema1:creator "N. Taylor Blanchard" ;
    schema1:name "Old Treasure" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "OldTreasure.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Hoard item. +1 direct influence. Discard this item to give +4 direct influence to bearer until the end of the turn."@en,
        "Objeto de botín. +1 a la influencia directa. Descarta este objeto para dar +4 a la influencia directa del portador hasta el final del turno."@es,
        "Objet de trésor. +1 à l’influence directe. Défaussez cet objet pour donner +4 à l’influence directe de son porteur jusqu’à la fin du tour."@fr ;
    meccg_prop:quote "“‘… somewhere where there’s good loot nice and handy…’” —LotRIV"@en,
        "“ʻ… en algún lugar donde haya un buen botín a mano…ʼ” —SdlA II"@es,
        "“[...] quelque part où il y aurait un bon butin facile et à portée [...]” —SdAIV"@fr ;
    meccg_prop:rarity "C2" .

meccg:AS-13 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Herrin des Goldenen Waldes"@de,
        "Lady of the Golden Wood"@en,
        "La Dama del Bosque Dorado"@es,
        "Dame de la forêt d'or"@fr,
        "Lady of the Golden Wood"@nl ;
    dc:creator "Rebecca Guay" ;
    dc:identifier "AS-13" ;
    schema1:creator "Rebecca Guay" ;
    schema1:name "Lady of the Golden Wood" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "10" ;
    meccg_prop:cardImage "LadyoftheGoldenWood.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Elf. Manifestation of Galadriel. One strike. Detainment against hero companies. As a creature, may be played keyed to Wold & Foothills; or at sites in this region. As a permanent-event, all effects are automatically canceled which allow a minion player to search through or look at any portion of his play deck or discard pile outside of the normal sequence of play. Discard when any play deck is exhausted."@en,
        "Única. Elfo. Manifestación de Galadriel. Un golpe. Retención contra compañías de héroes.Como criatura, puede ser jugada situada en Páramo y Colinas; o en los lugares de dicha región.Como suceso permanente, anula todos los efectos que permitan a un jugador servidor buscar o mirar en cualquier parte de su mazo de juego o pila de descartes fuera de la secuencia normal de juego. Descartar cuando se agote cualquier mazo de juego."@es,
        "Unique. Elfe. Manifestation de Galadriel. 1 coup. Dilatoire contre les compagnies de héros. En tant que créature, peut être jouée en association avec le Plateau ainsi qu’aux sites de cette région. En tant qu’événement permanent, annule automatiquement tout effet qui amènent un joueur séide à chercher ou regarder dans tout ou partie de sa pioche ou de sa pile de défausse en dehors de la séquence normale de jeu. Défaussez quand l’une des pioches est épuisée."@fr ;
    meccg_prop:marshallingPoints "3*" ;
    meccg_prop:prowess "12" ;
    meccg_prop:race "Elves" ;
    meccg_prop:rarity "R2" .

meccg:AS-130 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Ungelesene Schriften"@de,
        "Records Unread"@en,
        "Registros sin Leer"@es,
        "Archives non lues"@fr,
        "Records Unread"@nl ;
    dc:creator "Audrey Corman" ;
    dc:identifier "AS-130" ;
    schema1:creator "Audrey Corman" ;
    schema1:name "Records Unread" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "RecordsUnread.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Cannot be included with a starting company. Discard: to untap a Shadow-hold [{S}] or to make Information playable at any Shadow-hold [{S}]. Cannot be duplicated in a given company."@en,
        "No puede ser incluido en una compañía inicial. Descarta: para enderezar un Bastión de la Sombra [{S}] o para hacer que se pueda jugar Información en cualquier Bastión de la Sombra [{S}]. No puede ser duplicado en una misma compañía."@es,
        "Ne peuvent être incluses dans une compagnie de départ. Défaussez cet objet pour désengager un fief de l’ombre [{S}] ou pour rendre les informations jouables à n’importe quel fief de l’ombre [{S}]. Ne peuvent être doublées dans une compagnie donnée."@fr ;
    meccg_prop:quote "“‘And yet there lie in his hoards many records that few now can read… for their scripts and tongues have become dark to later men.’” —LotRII"@en,
        "“ʻY sin embargo hay allí en sus archivos muchos documentos que ya pocos son capaces de leer, ni siquiera los maestros, pues la escritura y la lengua se han vuelto oscuras para los hombres más recientes.ʼ”—SdlA I"@es,
        "“Et pourtant il y avait dans ses archives bien des documents que peu de gens peuvent encore lire [...] car l’écriture et la langue en sont devenues obscures pour les hommes des temps plus récents.” —SdAII"@fr ;
    meccg_prop:rarity "C2" .

meccg:AS-131 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Geheimes Buch"@de,
        "Secret Book"@en,
        "Libro Secreto"@es,
        "Livre secret"@fr,
        "Secret Book"@nl ;
    dc:creator "Audrey Corman" ;
    dc:identifier "AS-131" ;
    schema1:creator "Audrey Corman" ;
    schema1:name "Secret Book" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "SecretBook.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Cannot be included with a starting company. Discard: to untap a Free-hold [{F}] or Border-hold [{B}] or to make Information playable at any Ruins & Lairs [{R}]. Cannot be duplicated in a given company."@en,
        "No puede ser incluido en una compañía inicial. Descarta: para enderezar un Bastión Libre [{F}] o un Bastión Fronterizo [{B}] o para hacer que se pueda jugar Información en cualquier Ruinas y Guaridas [{R}]. No puede ser duplicado en una misma compañía."@es,
        "Ne peut être inclus dans une compagnie de départ. Défaussez cet objet pour désengager un fief libre [{F}] ou un fief frontalier [{B}] ou pour rendre les informations jouables à n’importe quel site de ruines et antres [{R}]. Ne peut être doublé dans une compagnie donnée."@fr ;
    meccg_prop:quote "“‘I must be the only one in the Shire, besides you Frodo, that has ever seen the old fellow’s  secret book.’” —LotRI"@en,
        "“ʻDebo ser la única persona en toda la Comarca, además de ti, Frodo, que ha visto el libro secreto del viejo Bilbo.ʼ” —SdlA I"@es,
        "“Je dois être le seul dans la Comté, à part toi Frodon, à avoir jamais vu le livre secret du vieux bonhomme.” —SdAI"@fr ;
    meccg_prop:rarity "C2" .

meccg:AS-132 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Feuerpeitsche"@de,
        "Thong of Fire"@en,
        "Látigo de Fuego"@es,
        "Fouet de feu"@fr,
        "Thong of Fire"@nl ;
    dc:creator "Pascal Yung" ;
    dc:identifier "AS-132" ;
    schema1:creator "Pascal Yung" ;
    schema1:name "Thong of Fire" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "ThongofFire.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Hoard item. Weapon. May only be borne by a character with a prowess of 6 or more. Warrior only: +1 body; +1 prowess; if bearer chooses not to tap against a strike, he receives no prowess penalty."@en,
        "Único. Objeto de botín. Arma. Solo puede portarlo un personaje con un poder de 6 o más. Solo guerreros: +1 a la resistencia; +1 al poder; si el portador decide no girarse contra un golpe, no recibe ninguna penalización al poder."@es,
        "Unique. Objet de trésor. Arme. Ne peut être porté que par un personnage ayant une prouesse de 6 ou plus. Guerrier seulement : +1 à la prouesse ; +1 à l’endurance ; si le porteur ne s’engage pas pour affronter un coup, il ne reçoit aucune pénalité à la prouesse."@fr ;
    meccg_prop:marshallingPoints "3" ;
    meccg_prop:quote "“The fallen Fire-spirits of the Elder Days bore sorcerous weapons, all lost when the hosts of the West claimed the victory…” —Kuduk Lore"@en,
        "“Los espíritus de fuego caídos durante los Días Antiguos empuñaban armas embrujadas, todas las cuales se perdieron cuando las huestes del Oeste alcanzaron la victoria final…” —Sabiduría Kuduk"@es,
        "Les esprits du feu déchus des jours anciens portaient des armes ensorcelées, toutes perdues lorsque les armées de l’Ouest ont revendiqué la victoire [...] —Légende kuduk"@fr ;
    meccg_prop:rarity "R2" .

meccg:AS-133 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Versklavender Ring"@de,
        "Thrall-ring"@en,
        "Anillo Esclavo"@es,
        "Anneau d’emprise"@fr,
        "Thrall-ring"@nl ;
    dc:creator "Ronald Chironna" ;
    dc:identifier "AS-133" ;
    schema1:creator "Ronald Chironna" ;
    schema1:name "Thrall-ring" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "Thrallring.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Mind Ring. -1 to mind to a minimum of 1, +1 to direct influence. Cannot be duplicated on a given character."@en,
        "Anillo Mental. -1 a la mente hasta un mínimo de 1, +1 a la influencia directa del portador. No puede ser duplicado sobre un mismo personaje."@es,
        "Anneau d’esprit. -1 à l’esprit (minimum 1), +1 à l’influence directe. Ne peut être utilisé par un joueur Sorcier Déchu pour mettre en jeu un personnage dont l’esprit est supérieur à 5. Ne peut être doublé sur un personnage donné."@fr ;
    meccg_prop:quote "“As it encircles the finger it ensnares the mind.” —Kuduk Lore"@en,
        "“En cuanto rodea el dedo, esclaviza la mente del portador.” —Sabiduría Kuduk"@es,
        "En encerclant le doigt, il enserre l’esprit. —Légende kuduk"@fr ;
    meccg_prop:rarity "R2" .

meccg:AS-134 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Thrórs Landkarte"@de,
        "Thrór’s Map"@en,
        "Mapa de Thrór"@es,
        "Carte de Thrór"@fr,
        "Thror's Map"@nl ;
    dc:creator "Jeffrey Reitz" ;
    dc:identifier "AS-134" ;
    schema1:creator "Jeffrey Reitz" ;
    schema1:name "Thrór’s Map" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "ThrorsMap.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Discard Thrór’s Map to untap a site with a Dragon automatic-attack."@en,
        "Único. Descarta el Mapa de Thrór para enderezar un lugar con un ataque automático de Dragón."@es,
        "Unique. Défaussez la Carte de Thrór pour désengager un site avec une attaque automatique de Dragon."@fr ;
    meccg_prop:quote "“‘He was witless and wandering, and had forgotten almost everything except the map and the key.’” —Hob"@en,
        "“ʻHabía perdido el juicio e iba de un lado para otro, y había olvidado casi todo excepto el mapa y la llave.ʼ”—Hob"@es,
        "“Il avait perdu la raison ; il divaguait et avait presque tout oublié, hormis la carte et la clef [...]” —Hob"@fr ;
    meccg_prop:rarity "U2" .

meccg:AS-135 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Ring der Treue"@de,
        "Troth-ring"@en,
        "Anillo de Fidelidad"@es,
        "Anneau d’étranglement"@fr,
        "Troth-ring"@nl ;
    dc:creator "Steve Otis" ;
    dc:identifier "AS-135" ;
    schema1:creator "Steve Otis" ;
    schema1:name "Troth-ring" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "Trothring.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Mind Ring. -1 to mind to a minimum of 1, -1 to all body checks against bearer. Cannot be duplicated on a given character."@en,
        "Anillo Mental. -1 a la mente hasta un mínimo de 1, -1 a todos los chequeos de resistencia contra el portador. No puede ser duplicado sobre un mismo personaje."@es,
        "Anneau d’esprit. -1 à l’esprit (minimum 1), -1 à tous les tests d’endurance contre le porteur. Ne peut être utilisé par un joueur Sorcier Déchu pour mettre en jeu un personnage dont l’esprit est supérieur à 5. Ne peut être doublé sur un personnage donné."@fr ;
    meccg_prop:quote "“Those who hunger for dominion are themselves enslaved. Power makes a dangerous supper.” —Kuduk Lore"@en,
        "“Quienes ansían dominar a los demás acaban esclavizados ellos mismos. El poder supone un alimento muy peligroso.” —Sabiduría Kuduk"@es,
        "Ceux qui ont soif de domination sont eux-mêmes asservis. Le pouvoir est un ami dangereux. —Légende kuduk"@fr ;
    meccg_prop:rarity "R2" .

meccg:AS-136 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Benutze deine Beine"@de,
        "Usriev of Treachery"@en,
        "Usriev Traidor"@es,
        "Usriev de la traîtrise"@fr,
        "Usriev of Treachery"@nl ;
    dc:creator "Pat Morrissey" ;
    dc:identifier "AS-136" ;
    schema1:creator "Pat Morrissey" ;
    schema1:name "Usriev of Treachery" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "UsrievofTreachery.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Hoard item. Weapon. May only be born by a character with a prowess of 5 or more. Warrior only: +1 prowess to a maximum of 8 (+2 against Elves to a maximum of 9); if you assign a strike to the bearer, you may choose to assign a second strike to the bearer. The bearer faces an additional strike sequence."@en,
        "Objeto de botín. Arma. Solo puede portarlo un personaje con un poder de 5 o más. Solo guerreros: +1 al poder hasta un máximo de 8 (+2 contra Elfos hasta un máximo de 9); si asignas un golpe al portador, puedes optar por asignar un segundo golpe al portador. El portador se enfrenta a una secuencia de golpes adicional."@es,
        "Objet de trésor. Arme. Ne peut être portée que par un personnage ayant une prouesse de 5 ou plus. Guerrier seulement : +1 à la prouesse (maximum 8) ou +2 contre les Elfes (maximum 9) ; si vous assignez un coup au porteur, vous pouvez choisir d’assigner un second coup au porteur. Le porteur affronte une séquence de coup supplémentaire. Vous ne pouvez utiliser cet objet pour assigner un troisième coup au porteur."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:rarity "C3" .

