    meccg_prop:quote "“There the Dúnedain were few, and power had been seized by an evil lord of the Hillmen, who was in secret league with Angmar.” —LotR"@en,
        "“Allí los Dúnedain eran pocos, y el poder estaba en manos de un Jefe malvado de los Hombres de las Colinas, que tenia un pacto secreto con Angmar.” —SdlA Apéndices"@es,
        "Les Dúnedain y étaient peu nombreux et un mauvais seigneur des Hommes des Collines avait pris le pouvoir, et il entretenait de secrètes intelligences avec l’Angmar. —SdA"@fr ;
    meccg_prop:rarity "CB" .

meccg:TW-38 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Ghule"@de,
        "Ghouls"@en,
        "Necrófagos"@es,
        "Naukuhuulet"@fi,
