    meccg_prop:cardImage "UmbareanCorsairs.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. Playable at Gobel Mírlond  if the influence check is greater than 8. Standard Modifications: Black Númenóreans (+2), Southrons (+2)."@en,
        "Única. Jugable en Gobel Mírlondsi el chequeo de influencia es superior a 8.Modificaciones Estándar:Númenóreanos Negros (+2), Sureños (+2)."@es,
        "Uniques. Peuvent être joués à Gobel Mírlond si le test d’influence est supérieur à 8. Modificateurs standards : Númenóréens Noirs (+2), Suderons (+2)."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:quote "“Umbar remained at war with Gondor for many lives of men, a threat to its coastlands and to all traffic on the sea.” —LotR"@en,
        "“Umbar estuvo en guerra con Gondor durante el curso de muchas vidas humanas, amenazando las costas y todo el tráfico por mar.” —SdlA Apéndices"@es,
        "Umbar resta en guerre avec le Gondor pendant de nombreuses générations, une menace pour ses côtes et pour tout le trafic maritime. —SdA"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "U" .

meccg:LE-29 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
