    meccg_prop:cardImage "Wormsbane.jpg" ;
    meccg_prop:cardSet "TD" ;
    meccg_prop:cardSetName "The Dragons" ;
    meccg_prop:cardText "Unique. Weapon. +2 to prowess to a maximum of 9 (+4 to prowess to a maximum of 12 and -2 to strike’s body against a Dragon or Drake strike)."@en,
        "Único. Arma. +2 al poder hasta un máximo de 9 (+4 al poder hasta un máximo de 12 y -2 a la resistencia del golpe contra un golpe de Dragón o Draque)."@es,
        "Unique. Arme. +2 en prouesse (maximum 9) ou +4 en prouesse (maximum 12) et -2 à l’endurance du coup contre un coup de Dragon ou de Drake."@fr ;
    meccg_prop:marshallingPoints "4" ;
    meccg_prop:prowess "+2" ;
    meccg_prop:quote "“… and among them were several swords of various makes, shapes, and sizes.” —Hob"@en,
        "“… y entre ellos muchas espadas de diversa factura, forma y tamaño.” —Hob"@es,
        "[...] et parmi tout cela il y avait différentes épées de diverses factures, formes et tailles. —Hob"@fr ;
    meccg_prop:rarity "R2" .

meccg:TD-173 a schema1:Place,
        meccg_class:Card,
        meccg_class:Site ;
    rdfs:label "Buhr Widu"@de,
        "Buhr Widu"@en,
        "Buhr Widu"@es,
        "Buhr Widu"@fr,
        "ブア・ウィドゥ"@ja,
        "Buhr Widu"@nl ;
    dc:creator "Eric David Anderson" ;
    dc:identifier "TD-173" ;
    schema1:creator "Eric David Anderson" ;
    schema1:name "Buhr Widu" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "BuhrWidu.jpg" ;
    meccg_prop:cardSet "TD" ;
    meccg_prop:cardSetName "The Dragons" ;
    meccg_prop:cardText "Nearest Haven: LórienPlayable: Items (minor, major)Automatic-attacks: Troll — 1 strike with 10 prowess Special: This site is always returned to the location deck, never to the discard pile."@en,
        "Refugio más cercano: LórienJugable: Objetos (menores, mayores)Ataques Automáticos: Troll — 1 golpe de poder 10Especial: Este lugar siempre es devuelto al mazo de localizaciones, nunca a la pila de descartes."@es,
        "Havre le plus proche : LórienJouable : Objet (mineur, majeur)Attaques automatiques :Troll — 1 coup avec 10 en prouesse"@fr ;
    meccg_prop:quote "“… from their tree-felling they created the grassy East Bight, where stood Buhr Widu, their lord’s hold and capital.” —Kuduk Lore"@en,
        "“… a partir de los árboles caídos crearon el verde Linde Este, donde elevaron Buhr Widu, la Fortaleza y capital de su señor.” —Sabiduría Kuduk"@es,
        "[...] sur leurs coupes de bois, ils créèrent l’herbeuse Crique Orientale, où se trouvait Buhr Widu, capitale et forteresse de leur seigneur. —Légende kuduk"@fr ;
    meccg_prop:rarity "U2" .

meccg:TD-175 a schema1:Place,
        meccg_class:Card,
        meccg_class:Site ;
    rdfs:label "Framsburg"@de,
        "Framsburg"@en,
        "Framsburgo"@es,
        "Framsbourg"@fr,
        "フラムの町"@ja,
        "Framsburg"@nl ;
    dc:creator "Douglass Chaffee" ;
