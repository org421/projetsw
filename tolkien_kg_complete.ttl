    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Playable at Grey Havens if the influence check is greater than 9. Standard Modifications: Dúnedain (+1), Elves (+2)."@en,
        "Única. Jugable en los Puertos Grisessi el chequeo de influencia es superior a 9.Modificadores Estándar:Dúnedain (+1), Elfos (+2)."@es,
        "Uniques. Peuvent être joués aux Havres Gris si le test d’influence est supérieur à 9.Modificateurs standard : Dúnedain (+1), Elfes (+2)."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:quote " “Requiem: ‘To the memory of Roger Zelazny.’” —Elizabeth T. Danforth"@en,
        "“Réquiem: ‘A la memoria de Roger Zelazny.’” —Elizabeth T. Danforth"@es,
        "Requiem : “À la mémoire de Roger Zelazny.” —Élizabeth T. Danforth"@fr ;
    meccg_prop:race "Elf" ;
    meccg_prop:rarity "R" .

meccg:TW-227 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Ent-Trunk"@de,
        "Ent-draughts"@en,
        "Caldo de Ent"@es,
        "Enttijuoma"@fi,
        "Breuvages d'Ent"@fr,
        "Pozioni degli Ent"@it,
        "エントの飲みもの"@ja,
        "Ent-draughts"@nl ;
    dc:creator "Randy Gallegos" ;
    dc:identifier "TW-227" ;
    schema1:creator "Randy Gallegos" ;
    schema1:name "Ent-draughts" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:body "-" ;
    meccg_prop:cardImage "Entdraughts.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Only playable at Wellinghall in addition to an ally or faction that has been successfully played at Wellinghall this turn. +1 to prowess. This item may not be stolen, transferred, or stored. Cannot be duplicated on a given character."@en,
        "Jugable en la Sala del Manantial si un aliado o facción ha sido jugado con éxito en la Sala del Manantial este turno. +1 al poder. Este objeto no puede ser robado, transferido, o almacenado. No puede ser duplicado en un mismo personaje."@es,
        "Ne peuvent être joués qu’à la Salle du Jaillissement en plus d’un allié ou d’une faction qui a été joué avec succès au même site ce tour. +1 à la prouesse. Cet objet ne peut pas être volé, transféré ou mis en réserve. Ne peuvent être doublés sur un personnage donné."@fr ;
    meccg_prop:prowess "+1" ;
    meccg_prop:quote "“… and yet there was some scent or savour in it which they could not describe…” —LotRIII"@en,
        "“… sin embargo tenía también un aroma o sabor que ellos no podían describir…” —SdlA II"@es ;
    meccg_prop:rarity "U" .

meccg:TW-228 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Ents von Fangorn"@de,
        "Ents of Fangorn"@en,
        "Ents de Fangorn"@es,
        "Fangornin Entit"@fi,
