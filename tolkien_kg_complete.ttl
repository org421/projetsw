    meccg_prop:cardImage "Pippin.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Unless he is one of the starting characters, he may only be brought into play at his home site. All of his corruption checks are modified by +2."@en,
        "Único. A menos que sea uno de los personajes iniciales, solo puede entrar en juego en su lugar natal. Todos sus chequeos de corrupción son modificados con un +2."@es,
        "Unique. À moins qu’il ne soit un des personnages de départ, il ne peut être mis en jeu qu’à son site natal. +2 à tous ses tests de corruption."@fr ;
    meccg_prop:directInfluence "1" ;
    meccg_prop:homeSite "Bag End" ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:mind "4" ;
    meccg_prop:prowess "1" ;
    meccg_prop:quote "“… then there came a faint glow… and it held his eyes, so that now he could not look away.” —LotRIII"@en,
        "“De súbito una llama tenue se encendió y se agitó en el corazón de la esfera, atrayendo la mirada de Pippin, de tal modo que no le era posible desviarla.” —SdlA II"@es,
        "Puis vinrent un léger rayonnement et un mouvement au centre, et elle retenait le regard de Pippin de telle façon qu’il ne pouvait plus le détourner. —SdAIII "@fr ;
    meccg_prop:race "Hobbit" ;
    meccg_prop:rarity "U" ;
    meccg_prop:skills "Scout" .

