    meccg_prop:cardText "Site Path From Grey Havens: {f}{c}{c}{c}{c}{w}Site Path From Lórien: {w}{b}{f}{f}{b}{w}"@en,
        "Itinerario desde los Puertos Grises: {f}{c}{c}{c}{c}{w}Itinerario desde Lórien: {w}{b}{f}{f}{b}{w}"@es,
        "Itinéraire depuis les Havres Gris : {f}{c}{c}{c}{c}{w}Itinéraire depuis la Lórien : {w}{b}{f}{f}{b}{w}"@fr ;
    meccg_prop:quote "“‘It is long since the people of Nimrodel left the woodlands of Lórien, and yet one may see that not all sailed from Amroth’s haven west over water.’” —LotRV"@en,
        "“‘Hace ya mucho tiempo el pueblo de Nimrodel abandonó los bosques de Lórien, pero se puede ver aún que no todos dejaron el puerto de Amroth y navegaron rumbo al Oeste.’” —SdlA III"@es,
        "“Il y a longtemps que les gens de Nimrodel ont quitté les forêts de la Lórien, mais on peut encore voir que tous ne partirent pas du Havre d’Amroth pour faire voile vers l’ouest.” —SdAV "@fr ;
    meccg_prop:rarity "CB" ;
    tolkien_prop:depicts tolkien:Edhellond .

