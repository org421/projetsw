    rdfs:label "Totsümpfe"@de,
        "Dead Marshes"@en,
        "Ciénagas de los Muertos"@es,
        "Marais des Morts"@fr,
        "Dead Marshes"@nl ;
    dc:creator "Ted Nasmith" ;
    dc:identifier "LE-364" ;
    schema1:about tolkien:Dead_Marshes ;
    schema1:creator "Ted Nasmith" ;
    schema1:name "Dead Marshes" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "DeadMarshes.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Nearest Darkhaven: Dol GuldurPlayable: Items (minor, major)Automatic-attacks:Undead — 2 strikes with 8 prowess; each character wounded must make a corruption check modified by -2Special: Non-Nazgûl creatures played at this site attack normally, not as detainment."@en,
        "Refugio Oscuro más cercano: Dol GuldurJugable: Objetos (menores, mayores)Ataques Automáticos:Muertos Vivientes — 2 golpes de poder 8;cada personaje herido debe hacer un chequeo de corrupción modificado con un -2Especial: Las criaturas que no sean Nazgûl jugadas en este lugar atacan de forma normal, no como retención."@es,
        "Havre Noir le plus proche : Dol GuldurJouable : Objet (mineur, majeur)Attaques automatiques :Non-morts — 2 coups avec 8 en prouesse ; chaque personnage blessé doit faire un test de corruption modifié de -2."@fr ;
    meccg_prop:quote "“‘… the Marshes have grown… swallowed up the graves… always creeping, creeping.’” —LotRIV"@en,
        "“ʻPero las ciénagas crecieron desde entonces, engulleron las tumbas; reptando, reptando siempre.ʼ” —SdlA II"@es,
        "“[...] les Marais se sont étendus [...] ils ont avalé les tombes ; ils rampent toujours davantage.” —SdAI"@fr ;
    meccg_prop:rarity "U" ;
    tolkien_prop:depicts tolkien:Dead_Marshes .

