        "Haudh-in-Gwanûr"@en,
        "Haudh-in-Gwanûr"@es,
        "Haudh-in-Gwanûr"@fr,
        "ハウズ＝イン＝グワァヌア"@ja,
        "Haudh-in-Gwanûr"@nl ;
    dc:creator "Pamela Shanteau" ;
