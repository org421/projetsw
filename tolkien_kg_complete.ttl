    meccg_prop:cardImage "ToSatisfytheQuestioner.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable during the site phase on an untapped character at a Free-hold [{F}]. Tap the character and site. No marshalling points are received and the character may not untap until this card is stored at a Darkhaven [{DH}] during his organization phase."@en,
        "Jugable durante la fase de lugares sobre un personaje enderezado que se encuentre en un Bastión Libre [{F}]. Gira el personaje y el lugar. No recibes puntos de victoria y el personaje no puede ser enderezado hasta que esta carta sea almacenada en un Refugio Oscuro [{DH}] durante su fase de organización."@es,
        "Peut être joué pendant la phase de site sur un personnage désengagé à un fief libre [{F}]. Engagez le personnage et le site. Tant que cette carte n’est pas mise en réserve à un Havre Noir [{K}] pendant sa phase d’organisation, aucun point de rassemblement n’est reçu et le personnage ne peut pas se désengager."@fr ;
    meccg_prop:marshallingPoints "(3)" ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-247 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Unter seinem Schlag"@de,
        "Under His Blow"@en,
        "Eludir su Golpe"@es,
        "Sous son coup"@fr,
        "Under His Blow"@nl ;
    dc:creator "John Howe" ;
    dc:identifier "LE-247" ;
    schema1:creator "John Howe" ;
    schema1:name "Under His Blow" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "UnderHisBlow.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Untapped character does not tap against one strike."@en,
        "Un personaje enderezado no se gira contra un golpe."@es,
        "Un personnage désengagé ne s’engage pas contre un coup. "@fr ;
    meccg_prop:quote "“Diving under Aragorn’s blow with the speed of a striking snake he charged…” —LotRII"@en,
        "“Eludiendo la espada de Aragorn con la rapidez de una serpiente, cargó contra la Compañía, apuntando a Frodo con la lanza. El golpe alcanzó a Frodo en el lado derecho…” —SdlA I"@es,
        "Plongeant sous le coup d’Aragorn avec la rapidité d’un serpent à l’attaque, il chargea [...] —SdAII "@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-248 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Ûvatha entfesselt"@de,
        "Ûvatha Unleashed"@en,
        "Ûvatha Desencadenado"@es,
        "Ûvatha déchaîné"@fr,
        "Ûvatha Unleashed"@nl ;
    dc:creator "Quinton Hoover" ;
    dc:identifier "LE-248" ;
    schema1:creator "Quinton Hoover" ;
    schema1:name "Ûvatha Unleashed" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "UvathaUnleashed.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on Ûvatha the Ringwraith’s own company (if Ûvatha is your Ringwraith) at the end of his movement/hazard phase. His company may move to an additional site this turn. A site card may be played and another movement/hazard phase immediately follows for his company."@en,
        "Jugable sobre la compañía de Ûvatha el Espectro del Anillo (como tu Espectro del Anillo) al final de su fase de movimiento/adversidades. Su compañía puede moverse a un lugar adicional este turno. Se puede jugar una nueva carta de lugar e inmediatamente debe resolverse otra fase de movimiento/adversidades para esta compañía."@es,
        "Peut être joué sur la compagnie d’Ûvatha le Spectre (s’il est votre Spectre) à la fin de sa phase de déplacements et périls. Sa compagnie peut se déplacer vers un site supplémentaire ce tour-ci. Une carte de site peut être jouée et une autre phase de déplacements et périls suit immédiatement pour sa compagnie."@fr ;
    meccg_prop:quote "“… going hither and thither in the lands…” —LotRII"@en,
        "“… yendo aquí y allá…” —SdlA I"@es ;
    meccg_prop:rarity "R" .

meccg:LE-249 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Verschleiernde Schatten"@de,
        "Veils of Shadow"@en,
        "Velos de Sombra"@es,
        "Chape d'ombre"@fr,
        "Veils of Shadow"@nl ;
    dc:creator "Eric David Anderson" ;
    dc:identifier "LE-249" ;
    schema1:creator "Eric David Anderson" ;
    schema1:name "Veils of Shadow" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "VeilsofShadow.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Magic. Sorcery. Playable on a sorcery-using character facing an automatic-attack. The number of strikes of all automatic-attacks at the site this turn are reduced to one. Unless he is a Ringwraith, character makes a corruption check modified by -4."@en,
        "Magia. Brujería. Jugable sobre un personaje que pueda utilizar brujería y se enfrente a un ataque automático. El número de golpes de todos los ataques automáticos en el lugar este turno se reduce a uno. A menos que sea un Espectro del Anillo, el personaje debe hacer un chequeo de corrupción modificado con un -4."@es,
        "Magie. Sorcellerie. Peut être jouée sur un personnage capable d’utiliser la sorcellerie et qui affronte une attaque automatique. Le nombre de coups de toutes les attaques automatiques du site est réduit à 1 ce tour-ci. Le personnage fait un test de corruption modifié de -4, sauf s’il est un Spectre."@fr ;
    meccg_prop:quote "“… for here as the Mountain drew near the  air was ever mirky…” —LotRVI"@en,
        "“… pues a medida que la Montaña se acercaba, el aire se volvía más oscuro…” —SdlA III"@es,
        "[...] à l’approche de la Montagne, l’air était de plus en plus fuligineux [...] —SdAVI "@fr ;
    meccg_prop:rarity "R" .

meccg:LE-25 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Muzgash"@de,
        "Muzgash"@en,
        "Muzgash"@es,
        "Muzgash"@fr,
        "Muzgash"@nl ;
