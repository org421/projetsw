meccg:LE-301 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Schwarzer Schuppenpanzer"@de,
        "Black-mail Coat"@en,
        "Cota de Malla Negra"@es,
        "Chemise de mailles noires"@fr,
        "Black-mail Coat"@nl ;
    dc:creator "Audrey Corman" ;
