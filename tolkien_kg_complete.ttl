        "Indûr the Ringwraith"@en,
        "Indûr el Espectro del Anillo"@es,
        "Indûr le Spectre"@fr,
        "Indûr the Ringwraith"@nl ;
    dc:creator "Tom Kidd" ;
    dc:identifier "LE-54" ;
    schema1:creator "Tom Kidd" ;
    schema1:name "Indûr the Ringwraith" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "10" ;
    meccg_prop:cardImage "IndurtheRingwraith.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. Manifestation of Indûr Dawndeath. Can use sorcery and spirit-magic. -1 direct influence in Heralded Lord mode. -3 prowess in Fell Rider mode. As your Ringwraith, at the beginning of each of his end-of-turn phases, he may tap to take a magic card from your discard pile to your hand."@en,
        "Único. Manifestación de Indûr Muerte del Alba. Puede utilizar brujería y magia espiritual. -1 a su influencia directa en modo Señor de los Hombres. -3 a su poder en modo Jinete Maligno. Como tu Espectro del Anillo, al principio de cada una de sus fases de final de turno, puede ser girado para coger una carta de magia de tu pila de descartes y ponerla en tu mano."@es,
        "Unique. Manifestation d’Indûr Aubemort. Peut utiliser la sorcellerie et la magie des esprits. -1 à l’influence directe en mode Seigneur proclamé. -3 à la prouesse en mode Aile Noire. S’il est votre Spectre, au début de chacune des phases de fin de tour, il peut s’engager pour mettre une carte de magie de votre pile de défausse dans votre main."@fr ;
    meccg_prop:directInfluence "5" ;
    meccg_prop:homeSite "Any site in Udûn or Imlad Morgul" ;
    meccg_prop:prowess "9" ;
    meccg_prop:race "Ringwraith" ;
    meccg_prop:rarity "F1" ;
    meccg_prop:skills "Warrior/Diplomat" .

meccg:LE-55 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Khamûl der Ringgeist"@de,
        "Khamûl the Ringwraith"@en,
        "Khamûl el Espectro del Anillo"@es,
        "Khamûl le Spectre"@fr,
        "Khamûl the Ringwraith"@nl ;
    dc:creator "John Howe" ;
    dc:identifier "LE-55" ;
    schema1:creator "John Howe" ;
    schema1:name "Khamûl the Ringwraith" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "9" ;
    meccg_prop:cardImage "KhamultheRingwraith.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. Manifestation of Khamûl the Easterling. Can use sorcery. -2 direct influence in Heralded Lord mode. +1 prowess in Fell Rider mode. -2 to the body of any Elf character targeted by a strike from Khamûl. As your Ringwraith, one Ringwraith follower in his company may be controlled with no influence. You may bring this follower into play during your organization phase."@en,
        "Único. Manifestación de Khamûl el Oriental. Puede utilizar brujería. -2 a su influencia directa en modo Señor de los Hombres. +1 a su poder en modo Jinete Maligno. -2 a la resistencia de cualquier personaje Elfo que sea objetivo de un golpe de Khamûl. Como tu Espectro del Anillo, puede controlar sin influencia un Espectro del Anillo seguidor. Puedes poner en juego este seguidor durante tu fase de organización."@es,
        "Unique. Manifestation de Khamûl l’Oriental. Peut utiliser la sorcellerie. -2 à l’influence directe en mode Seigneur proclamé. +1 à la prouesse en mode Aile Noire. -2 à l’endurance de tout personnage elfe visé par un coup de Khamûl. S’il est votre Spectre, un Spectre-suivant de sa compagnie peut être contrôlé sans influence. Vous pouvez mettre ce suivant en jeu pendant votre phase d’organisation."@fr ;
    meccg_prop:directInfluence "4" ;
    meccg_prop:homeSite "Dol Guldur" ;
    meccg_prop:prowess "9" ;
    meccg_prop:race "Ringwraith" ;
    meccg_prop:rarity "F1" ;
    meccg_prop:skills "Warrior/Ranger/Diplomat" .

meccg:LE-56 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Ren der Ringgeist"@de,
        "Ren the Ringwraith"@en,
        "Ren el Espectro del Anillo"@es,
        "Ren le Spectre"@fr,
        "Ren the Ringwraith"@nl ;
    dc:creator "Romas Kukalis" ;
    dc:identifier "LE-56" ;
    schema1:creator "Romas Kukalis" ;
    schema1:name "Ren the Ringwraith" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "10" ;
    meccg_prop:cardImage "RentheRingwraith.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. Manifestation of Ren the Unclean. Can use sorcery and shadow-magic. -2 direct influence in Heralded Lord mode. +2 prowess in Fell Rider mode. As your Ringwraith, if at a Darkhaven [{DH}], he may tap during your organization phase to modify all corruption checks made this turn by minions in any one of your companies by +2."@en,
        "Único. Manifestación de Ren el Impío. Puede utilizar brujería y magia de las sombras. -2 a su influencia directa en modo Señor de los Hombres. +2 a su poder en modo Jinete Maligno. Como tu Espectro del Anillo, si se encuentra en un Refugio Oscuro [{DH}], puede ser girado durante tu fase de organización para modificar con +2 todos los chequeos de corrupción realizados este turno por servidores en cualquiera de tus compañías."@es,
        "Unique. Manifestation de Ren l’Impur. Peut utiliser la sorcellerie et la magie de l’ombre. -2 à l’influence directe en mode Seigneur proclamé. +2 à la prouesse en mode Aile Noire. S’il est votre Spectre, et à un Havre Noir [{K}]{[V}, il peut s’engager pendant votre phase d’organisation pour modifier de +2 tous les tests de corruption fait ce tour-ci par les séides de l’une de vos compagnies."@fr ;
    meccg_prop:directInfluence "4" ;
    meccg_prop:homeSite "Any site in Gorgoroth" ;
    meccg_prop:prowess "8" ;
    meccg_prop:race "Ringwraith" ;
    meccg_prop:rarity "F1" ;
    meccg_prop:skills "Sage/Diplomat" .

meccg:LE-57 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Ûvatha der Ringgeist"@de,
        "Ûvatha the Ringwraith"@en,
        "Ûvatha el Espectro del Anillo"@es,
        "Ûvatha le Spectre"@fr,
        "Ûvatha the Ringwraith"@nl ;
    dc:creator "Quinton Hoover" ;
    dc:identifier "LE-57" ;
    schema1:creator "Quinton Hoover" ;
    schema1:name "Ûvatha the Ringwraith" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "9" ;
    meccg_prop:cardImage "UvathatheRingwraith.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. Manifestation of Ûvatha the Horseman. Can use spirit-magic. -3 direct influence in Heralded Lord mode. -1 prowess in Fell Rider mode. He may join another Ringwraith’s company during your organization phase and requires no influence to control. As your Ringwraith, if at a Darkhaven [{DH}], he may tap during your organization phase to move one resource event card from your discard pile to your play deck and reshuffle."@en,
        "Único. Manifestación de Ûvatha el Jinete. Puede utilizar magia espiritual. -3 a su influencia directa en modo Señor de los Hombres. -1 a su poder en modo Jinete Maligno. Puede unirse a la compañía de otro Espectro del Anillo durante tu fase de organización sin que requiera influencia para ser controlado. Como tu Espectro del Anillo, si se encuentra en un Refugio Oscuro [{DH}], puede ser girado durante tu fase de organización para coger una carta de recurso de suceso de tu pila de descartes y barajarlo en tu mazo de juego."@es,
        "Unique. Manifestation d’Ûvatha le Cavalier. Peut utiliser la magie des esprits. -3 à l’influence directe en mode Seigneur proclamé. -1 à la prouesse en mode Aile Noire. Il peut se joindre à la compagnie d’un autre Spectre pendant votre phase d’organisation et ne requiert aucune influence pour être contrôlé. S’il est votre Spectre, et à un Havre Noir [{K}], il peut s’engager pendant votre phase d’organisation pour mettre une carte de ressource d’événement de votre pile de défausse dans votre pioche (remélangez-la)."@fr ;
    meccg_prop:directInfluence "5" ;
    meccg_prop:homeSite "Any site in Khand" ;
    meccg_prop:prowess "9" ;
    meccg_prop:race "Ringwraith" ;
    meccg_prop:rarity "F1" ;
    meccg_prop:skills "Warrior/Scout/Ranger" .

meccg:LE-58 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Der Hexenkönig"@de,
        "The Witch-king"@en,
        "El Rey Brujo"@es,
        "Le Roi-Sorcier"@fr,
        "The Witch-king"@nl ;
    dc:creator "Daniel Horne" ;
    dc:identifier "LE-58" ;
    schema1:creator "Daniel Horne" ;
    schema1:name "The Witch-king" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "12" ;
    meccg_prop:cardImage "TheWitchking.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. Manifestation of The Witch-king of Angmar. Can use spirit-magic and shadow-magic. +3 direct influence in Heralded Lord mode. +1 prowess in Fell Rider mode. As your Ringwraith, up to two Ringwraith followers in his company may be controlled with no influence. You may bring these followers into play during separate organization phases."@en,
        "Único. Manifestación de El Rey Brujo de Angmar. Puede utilizar magia espiritual y magia de las sombras. +3 a su influencia directa en modo Señor de los Hombres. +1 a su poder en modo Jinete Maligno. Como tu Espectro del Anillo, puede controlar sin influencia hasta dos Espectros del Anillo seguidores en su compañía. Puedes poner en juego estos seguidores durante dos fases de organización separadas."@es,
        "Unique. Manifestation du Roi-Sorcier d’Angmar. Peut utiliser la magie des esprits et la magie de l’ombre. +3 à l’influence directe en mode Seigneur proclamé. +1 à la prouesse en mode Aile Noire. S’il est votre Spectre, jusqu’à 2 Spectres-suivants dans sa compagnie peuvent être contrôlés sans influence. Vous pouvez mettre ces suivants en jeu pendant des phases d’organisation distinctes. "@fr ;
    meccg_prop:directInfluence "3" ;
    meccg_prop:homeSite "Any site in Imlad Morgul" ;
    meccg_prop:prowess "9" ;
    meccg_prop:race "Ringwraith" ;
    meccg_prop:rarity "F2" ;
    meccg_prop:skills "Warrior/Sage/Diplomat" .

meccg:LE-59 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Hinterhalt"@de,
        "Ambusher"@en,
        "Emboscada"@es,
        "Coupe-jarret"@fr,
        "Ambusher"@nl ;
    dc:creator "Angus McBride" ;
    dc:identifier "LE-59" ;
    schema1:creator "Angus McBride" ;
    schema1:name "Ambusher" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "-" ;
    meccg_prop:cardImage "Ambusher.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Men. Two strikes. Attacker chooses defending characters."@en,
        "Hombres. Dos golpes. El atacante elige a los personajes defensores."@es,
        "Humains. 2 coups. L’attaquant choisit les personnages défenseurs. "@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:prowess "10" ;
    meccg_prop:quote " “… stealing up the slopes, singly or in long files, keeping always to the shade of grove or thicket, or crawling, hardly visible in their brown and green raiment, through grass and brake.” —LotRII"@en,
        "“… rondando por las colinas, en solitario o en largas filas, siempre a la sombra de los bosques o los arbustos, o arrastrándose, casi invisibles con su atuendo pardo o verde, a través de la hierba y el brezo.” —SdlA I"@es,
        "[...] se glissant vers le sommet des pentes, seuls ou en longues files, en restant dans les ombres des bosquets et des fourrés, ou en rampant à peine visibles dans leurs tenues de brun et de vert, à travers les herbes et les halliers. —SdAII"@fr ;
    meccg_prop:race "Men" ;
    meccg_prop:rarity "CB+CS1" .

