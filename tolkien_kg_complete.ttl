meccg:AS-16 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Herr des Hauses"@de,
        "Master of the House"@en,
        "Señor de la Casa"@es,
        "Maître de la Maison"@fr,
        "Master of the House"@nl ;
    dc:creator "Brad Williams" ;
