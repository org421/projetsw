    meccg_prop:marshallingPoints "2" ;
    meccg_prop:mind "6" ;
    meccg_prop:prowess "5" ;
    meccg_prop:quote "“Only Legolas still stepped as lightly as ever, his feet hardly seeming to press the grass, leaving no footprints as he passed…” —LotRIII"@en,
        "“Solo Legolas caminaba con la ligereza de siempre apoyándose apenas en la hierba, no dejando ninguna huella detrás…” —SdlA II"@es,
        "Seul Legolas poursuivait sa marche d’un pas aussi léger que jamais, son pied semblant à peine effleurer l’herbe et ne laissant aucune trace au passage [...] —SdAIII"@fr ;
    meccg_prop:race "Elf" ;
    meccg_prop:rarity "U" ;
