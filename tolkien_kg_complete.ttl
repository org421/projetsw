    meccg_prop:cardImage "Corpsecandle.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Undead. One strike. If this attack is not canceled, every character in the company makes a corruption check before defending characters are selected."@en,
        "Muerto Viviente. Un golpe. Si este ataque no es cancelado, cada personaje de la compañía debe hacer un chequeo de corrupción antes de elegir a los personajes defensores."@es,
        "Non-mort. 1 coup. Si cette attaque n’est pas annulée, chaque personnage de la compagnie fait un test de corruption avant que les personnages défenseurs soient choisis."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:prowess "7" ;
    meccg_prop:quote "“‘In the pools when the candles were lit. They lie in all the pools, pale faces, deep deep under the dark water.’” —LotRII"@en,
        "“En los estanques donde arden las velas. Yacen en todos los manantiales, caras pálidas en las profundidades del agua oscura.” —SdlA I"@es,
        "“Dans les étangs quand les chandelles étaient allumées. Ils reposent dans les étangs, de pâles visages, loin loin sous l’eau sombre.” —SdAII"@fr ;
    meccg_prop:race "Undead" ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-68 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Wilde Wölfe"@de,
