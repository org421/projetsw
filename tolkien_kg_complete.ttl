    meccg_prop:cardText "Unique. Healing effects affect all characters in her company."@en,
        "Único. Los efectos curativos afectan a todos los personajes de su compañía."@es,
        "Unique. Les effets de guérison affectent tous les personnages de sa compagnie."@fr ;
    meccg_prop:directInfluence "1" ;
