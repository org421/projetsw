    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. +1 direct influence against any faction playable at Easterling Camp. -1 to all corruption checks."@en,
        "Único. +1 a su influencia directa contra cualquier facción jugable en el Campamento Oriental. -1 a todos los chequeos de corrupción."@es,
        "Unique. +1 à l’influence directe sur les factions jouables au Camp des Orientaux. -1 à tous ses jets de corruption."@fr ;
    meccg_prop:directInfluence "0" ;
    meccg_prop:homeSite "Easterling Camp" ;
