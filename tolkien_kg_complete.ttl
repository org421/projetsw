tolkien:Durin a schema1:Person,
        tolkien_class:Character ;
    rdfs:label "Durin"@en ;
    schema1:alternateName "\"the Deathless\"" ;
    schema1:birthDate "Possibly awoke between YT 1132 & YT 1150, pp. 211-2In one of the texts associated with the chapter Of Aulë and Yavanna of The Silmarillion in The War of the Jewels, it is said that the awakening of the Dwarves might have taken place at the time of the departure of the Eldar over the sea - in other words, either in c. YT 1132 (when the Vanyar and the Noldor departed) or in c. YT 1150 (when the Teleri departed)." ;
    schema1:birthPlace tolkien:Mount_Gundabad ;
    schema1:children tolkien:At_least_one_son%2C_p._275 ;
    schema1:deathDate "Late First Age" ;
    schema1:deathPlace tolkien:Khazad-d%C3%BBm ;
    schema1:description "\"Durin I the Deathless\" by Artigas" ;
    schema1:familyName "House of Durin" ;
    schema1:gender "Male" ;
    schema1:homeLocation tolkien:Gundabad,
        tolkien:Khazad-d%C3%BBm,
