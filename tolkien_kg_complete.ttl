        "Vôteli"@it,
        "ヴォーテリ"@ja,
        "Vôteli"@nl ;
    dc:creator "Stefano Baldo" ;
    dc:identifier "TW-185" ;
    schema1:creator "Stefano Baldo" ;
    schema1:name "Vôteli" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:body "6" ;
    meccg_prop:cardImage "Voteli.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. +2 direct influence against the Lossoth faction. Against Nazgûl and Ringwraiths, +5 to her prowess and the Nazgûl/Ringwraith's body is halved (rounded up)."@en,
        "Único. +2 a su influencia directa contra la facción de los Lossoth. Contra Nazgûl y Espectros del Anillo, +5 a su poder y la resistencia del Nazgûl/Espectro del Anillo se reduce a la mitad (redondeando hacia arriba)."@es,
        "Unique. +2 à l’influence directe sur la faction des Lossoth. Contre un Nazgûl ou un Spectre, +5 à la prouesse et l’endurance de celui-ci est diminuée de moitié (arrondissez au supérieur)."@fr ;
    meccg_prop:directInfluence "1" ;
    meccg_prop:homeSite "Lossadan Camp" ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:mind "3" ;
    meccg_prop:prowess "3" ;
    meccg_prop:quote "“The Lossoth… can run on the ice with bones on their feet, and have carts without wheels.” —LotR"@en,
        "“Se dice que los lossoth son capaces de correr sobre el hielo con huesos sujetos a los pies y que tienen carros sin ruedas.” —SdlA Apéndices"@es,
        "Les Lossoth [...] peuvent courir sur la glace avec des os fixés aux pieds et [on dit] qu’ils ont des chariots sans roues. —SdA"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "CB" ;
    meccg_prop:skills "Ranger/Sage" .

meccg:TW-186 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Vygavril"@de,
        "Vygavril"@en,
        "Vygavril"@es,
        "Vygavril"@fi,
        "Vygavril"@fr,
        "Vygavril"@it,
        "ヴィガヴリル"@ja,
        "Vygavril"@nl ;
    dc:creator "Jo Hartwig" ;
    dc:identifier "TW-186" ;
    schema1:creator "Jo Hartwig" ;
    schema1:name "Vygavril" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:body "7" ;
    meccg_prop:cardImage "Vygavril.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. +2 direct influence against the Southron faction. Against Nazgûl and Ringwraiths, +6 to her prowess and the Nazgûl/Ringwraith's body is halved (rounded up)."@en,
        "Única. +2 a su influencia directa contra la facción de los Sureños. Contra Nazgûl y Espectros del Anillo, +6 a su poder y la resistencia del Nazgûl/Espectro del Anillo se reduce a la mitad (redondeando hacia arriba)."@es,
        "Unique. +2 à l’influence directe sur la faction des Suderons. Contre un Nazgûl ou un Spectre, +6 à la prouesse et l’endurance de celui-ci est diminuée de moitié (arrondissez au supérieur)."@fr ;
    meccg_prop:directInfluence "1" ;
    meccg_prop:homeSite "Southron Oasis" ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:mind "3" ;
    meccg_prop:prowess "2" ;
    meccg_prop:quote "“Estaba emparentada con la mujer de Sangahyando, un Príncipe de la infame Casa de Castamir, pero como a su madre y a la madre de su madre, le gustaba lo suficiente la libertad como para que la lucha contra la Sombra fuera un interés de todos, y siempre recordó que las gentes de Gondor eran sus parientes.” —Sabiduría Kuduk"@es ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "R" ;
    meccg_prop:skills "Scout/Diplomat" .

meccg:TW-187 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Wacho"@de,
        "Wacho"@en,
        "Wacho"@es,
        "Wacho"@fi,
        "Wacho"@fr,
        "Wacho"@it,
        "ワコ"@ja,
        "Wacho"@nl ;
    dc:creator "Stefano Baldo" ;
    dc:identifier "TW-187" ;
    schema1:creator "Stefano Baldo" ;
    schema1:name "Wacho" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:body "8" ;
    meccg_prop:cardImage "Wacho.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. +2 direct influence against the Woodmen faction."@en,
        "Único. +2 a su influencia directa contra la facción de los Hombres del Bosque."@es,
        "Unique. +2 à l’influence directe sur la faction des Hommes des Bois."@fr ;
    meccg_prop:directInfluence "0" ;
    meccg_prop:homeSite "Woodmen-town" ;
    meccg_prop:marshallingPoints "0" ;
    meccg_prop:mind "2" ;
    meccg_prop:prowess "1" ;
    meccg_prop:quote "“Grimbeorn the Old, son of Beorn, counted him as his right hand… for Wacho was bold, ever-vigilant and tirelessly roamed the mountains and forests by the Anduin Vales.” —Kuduk Lore"@en,
        "“Grimbeorn el Viejo, hijo de Beorn. le consideraba su mano derecha… pues Wacho era intrépido y atento, y recorría incansablemente las montañas y los bosques cercanos a los Valles del Anduin.” —Sabiduría Kuduk"@es,
        "Grimbeorn l’Ancien, fils de Beorn, le considérait comme son bras droit [...] car Wacho était hardi, toujours vigilant, et il parcourait sans cesse les montagnes et les forêts de la Vallée de l’Anduin. —Légende kuduk"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "U" ;
    meccg_prop:skills "Scout/Sage" .

meccg:TW-188 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Glückliche Zusammenkunft"@de,
        "A Chance Meeting"@en,
        "Un Encuentro Casual"@es,
        "Sattumalta Tavattu"@fi,
        "Une rencontre opportune"@fr,
        "Un Incontro Casuale"@it,
        "偶然の出会い"@ja,
        "A Chance Meeting"@nl ;
    dc:creator "Randy Gallegos" ;
    dc:identifier "TW-188" ;
    schema1:creator "Randy Gallegos" ;
    schema1:name "A Chance Meeting" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "AChanceMeeting.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "A non-Wizard character (even a Hobbit) may be brought into play with direct influence at any Free-hold [{F}], Border-hold [{B}], or Ruins & Lairs [{R}]. This does not count against the one character per turn limit. May be played on your turn during any phase the company is at a site."@en,
        "Un personaje no Mago (incluso un Hobbit) puede entrar en juego mediante la influencia directa en cualquier Bastión Libre [{F}], Bastión Fronterizo [{B}] o Ruinas y Guaridas [{R}]. No cuenta para el límite de poner un personaje en juego cada turno. Puede ser jugada en tu turno durante cualquier fase en la que la compañía se encuentre en un lugar."@es,
        "Un personnage non Sorcier (même un Hobbit) peut être mis en jeu avec l’influence directe à n’importe quel fief libre [{F}], fief frontalier [{B}] ou ruines et antres [{R}]. Cela ne compte pas dans la limite d’un personnage par tour. Peut être joué à votre tour pendant n’importe quelle phase durant laquelle la compagnie se trouve à un site."@fr ;
    meccg_prop:quote "“But at last there came about by chance a meeting between Gandalf and Thorin that changed all the fortunes of the House of Durin, and led to other and greater ends beside.” —LotR"@en,
        "“Pero por último hubo un encuentro azaroso entre Gandalf y Thorin que cambio la suerte de la Casa de Durin, y que condujo a otros y más grandes fines.” —SdlA Apéndices"@es,
        "Mais survint une rencontre de pur hasard entre Gandalf et Thorïn qui modifia les fortunes de la Maison de Durïn, et eut d’autres conséquences, plus grandioses encore. —SdA"@fr ;
    meccg_prop:rarity "CB" .

meccg:TW-189 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Ein Freund oder Drei"@de,
        "A Friend or Three"@en,
        "Un Amigo o Tres"@es,
        "Pari Kolme Ystävää"@fi,
        "Un ami ou trois"@fr,
        "Un Amico o Tre"@it,
        "友だちのひとり、いや三人"@ja,
        "A Friend or Three"@nl ;
    dc:creator "Quinton Hoover" ;
    dc:identifier "TW-189" ;
    schema1:creator "Quinton Hoover" ;
    schema1:name "A Friend or Three" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "AFriendorThree.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "One influence check or corruption check by a character in a company receives a +1 modification for each character in his company."@en,
        "Un chequeo de influencia o un chequeo de corrupción realizado por un personaje recibe una modificación de +1 por cada personaje que se encuentre en su compañía."@es,
        "Pour chaque personnage dans la compagnie, Un ami ou trois donne un modificateur de +1 à un test d’influence ou à un test de corruption fait par un personnage de la même compagnie."@fr ;
    meccg_prop:quote "“‘I was coming… with a friend or two…’ said the wizard… ‘One or three you meant, I see!’ said Beorn.” —Hob"@en,
        "“‘Venia yo… con un amigo o dos…’ dijo el Mago… ‘¡Uno o tres, querías decir, ya veo!’ dijo Beorn.” —Hob"@es,
        "“Je venais [...] avec un ami ou deux...” dit le Sorcier [...] “Disons plutôt un ou trois !” dit Beorn. —Hob"@fr ;
    meccg_prop:rarity "CB2" .

meccg:TW-19 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Ruf der See"@de,
        "Call of the Sea"@en,
        "La Llamada del Mar"@es,
        "Ikävä Merelle"@fi,
        "Appel de la mer"@fr,
        "Richiamo del Mare"@it,
        "海の呼び声"@ja,
        "Call of the Sea"@nl ;
    dc:creator "Mark Poole" ;
    dc:identifier "TW-19" ;
    schema1:creator "Mark Poole" ;
    schema1:name "Call of the Sea" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "CalloftheSea.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Playable on a Elf character. The character’s player makes a roll. Return the character to the player’s hand if this result plus his unused general influence is less than 10. This result is modified by -3 if the character’s company moved this turn using a site path containing a Coastal Sea [{c}].Any one item held by a character removed in this fashion may automatically be transferred to another character in his company (all other non-follower cards target character controls are discarded)."@en,
        "Jugable sobre un personaje Elfo. El jugador que controla el personaje hace una tirada: vuelve a poner el personaje en la mano de su jugador si el resultado más su influencia general sin utilizar es inferior a 10. Este resultado debe ser modificado con un -3 si la compañía del personaje se ha movido este turno a través de un itinerario que contiene una región de Costa [{c}].Cualquier personaje devuelto a la mano de esta manera puede transferir automáticamente un objeto a otro personaje de su compañía (todas las demás cartas que controle el personaje objetivo que no sean seguidores son descartadas)."@es,
        "Peut être joué sur un personnage Elfe. Le joueur du personnage doit faire un jet. Si le résultat plus son influence générale inemployée est inférieur à 10, remettez le personnage dans la main du joueur. Ce résultat est modifié de -3 si la compagnie du personnage s’est déplacée ce tour-ci avec un itinéraire contenant une mer côtière [{c}]. Un objet quelconque du personnage ainsi retiré peut être automatiquement transféré à un autre personnage de sa compagnie (toutes les autres cartes non suivant que le personnage contrôle sont défaussées)."@fr ;
    meccg_prop:rarity "U" .

meccg:TW-190 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Palantír Vorbereiten"@de,
        "Align Palantír"@en,
        "Alinear Palantír"@es,
        "Palantirin Suuntaus"@fi,
        "Contrôler un Palantír"@fr,
        "Allineare Palantír"@it,
        "パランティアの同調"@ja,
        "Align Palantír"@nl ;
    dc:creator "Eric David Anderson" ;
    dc:identifier "TW-190" ;
    schema1:creator "Eric David Anderson" ;
    schema1:name "Align Palantír" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "AlignPalantir.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Sage only. Playable on a Palantír with a sage in the company. Bearer now has the ability to use the Palantír. If the Palantír is stored, this card is stored too. Discard Align Palantír if the company carrying the Palantír moves.Cannot be duplicated on a given Palantír."@en,
        "Solo sabios. Jugable sobre una Palantír con un sabio en la compañía. El portador tiene la habilidad de utilizar la Palantír. Si la Palantír es almacenada, esta carta también es almacenada. Descarta Alinear Palantír si la compañía que contiene la Palantír se mueve.No puede ser duplicada sobre una misma Palantír."@es,
        "Sage seulement. Ne peut être joué que si un Palantír est dans sa compagnie. Conserver avec lePalantír ; le porteur a maintenant la capacité de l’utiliser. Si le Palantír est mis en réserve, cette carte est mise en réserve aussi. Défaussez Contrôler un Palantír si la compagnie qui porte le Palantír se déplace. Ne peut être doublé sur un Palantír donné."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:quote "“‘… For this assuredly is the palantír of Orthanc from the treasury of Elendil, set here by the Kings of Gondor…’” —LotRIII"@en,
        "“‘… Porque esta es sin duda la Palantír de Orthanc del tesoro de Elendil, traída aquí por los reyes de Gondor…’” —SdlA II"@es,
        "“Car c’est sans nul doute le Palantír d’Orthanc, provenant du trésor d’Elendil, déposé ici par les rois de Gondor.” —SdAIII"@fr ;
    meccg_prop:rarity "U" .

meccg:TW-191 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Anduin"@de,
        "Anduin River"@en,
        "Río Anduin"@es,
        "Anduin"@fi,
        "L'Anduin"@fr,
        "Fiume Anduin"@it,
        "アンドゥイン河"@ja,
        "Anduin River"@nl ;
    dc:creator "Mark Poole" ;
    dc:identifier "TW-191" ;
    schema1:creator "Mark Poole" ;
    schema1:name "Anduin River" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "AnduinRiver.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Playable at the end of the organization phase on a company containing a ranger. If the company uses region cards for its site path, tap the ranger to move as if the following pairs of regions were adjacent: Rohan and Dagorlad, Anórien and Dagorlad, Anórien and Ithilien, Lebennin and Ithilien, Lebennin and Harondor.Alternatively, if the site moved to is in one of the regions listed above, the hazard limit is reduced by two (to a minimum of 2). Cannot be duplicated on a given company."@en,
        "Jugable al final de la fase de organización sobre una compañía que contenga un montaraz. Gira un montaraz para que su compañía se mueva como si las siguientes regiones se encontraran adyacentes: Rohan y Dagorlad, Anórien y Dagorlad, Anórien e Ithilien, Lebennin e Ithilien, Lebennin y Harondor.Alternativamente, si el sitio al que se ha movido la compañía está en una de las regiones mencionadas anteriormente, el límite de adversidades se reduce en dos (hasta un mínimo de 2). No puede ser duplicada sobre una misma compañía."@es,
        "Peut être joué à la fin de la phase d’organisation sur une compagnie qui contient un rôdeur. Si la compagnie utilise le déplacement régional, engagez le rôdeur pour la déplacer comme si les couples de régions suivants étaient adjacents : Rohan et Dagorlad, Anórien et Dagorlad, Anórien et Ithilien, Lebennin et Ithilien, Lebennin et Harondor. Ou bien, si le site d’arrivée se trouve dans l’une de ces régions, la limite de périls est réduite de 2 (minimum 2). Ne peut être doublé sur une compagnie donnée."@fr ;
    meccg_prop:rarity "CB2" .

meccg:TW-192 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Andúril, die Flamme des Westens"@de,
        "Andúril, the Flame of the West"@en,
        "Andúril, la Llama del Oeste"@es,
        "Anduril, Lännen Lieska"@fi,
        "Andúril, la Flamme de l'Ouest"@fr,
        "Andúril, la Fiamma dell'Occidente"@it,
        "\"\"西方の焔\"\"アンドゥリル"@ja,
        "Andúril, the Flame of the West"@nl ;
    dc:creator "N. Taylor Blanchard" ;
    dc:identifier "TW-192" ;
    schema1:creator "N. Taylor Blanchard" ;
    schema1:name "Andúril, the Flame of the West" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "AnduriltheFlameoftheWest.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Sage only during the site phase at an untapped site where Information is playable. Tap the sage and the site. Sage makes a corruption check modified by -3. Keep sage tapped until Andúril is stored at a Haven [{H}]. Once stored, you may discard a stored Reforging and place Andúril with Narsil.In addition to Narsil’s effects, Andúril gives its bearer 4 marshalling points, +4 prowess (to a maximum of 11), +1 direct influence, and one more corruption point. Andúril may be tapped to untap a Dúnadan character in the same company, but its bearer must make a corruption check modified by -1."@en,
        "Único. Solo sabios durante la fase de lugares en un lugar enderezado donde se pueda jugar Información. Gira el sabio y el lugar. El sabio debe hacer un chequeo de corrupción modificado en un -3. Mantén al sabio girado hasta que Andúril sea almacenada en un Refugio [{H}]. Una vez almacenada, puedes descartar una Reforja almacenada y colocar Andúril junto a Narsil.Además de los efectos de Narsil, el portador de Andúril recibe 4 puntos de victoria, +4 al poder (hasta un máximo de 11), +1 a la influencia directa y 1 punto de corrupción. Andúril puede ser girada para enderezar un personaje Dúnadan en la misma compañía, pero su portador debe hacer un chequeo de corrupción modificado en un -1."@es,
        "Unique. Sage uniquement. Ne peut être jouée que pendant la phase de site à un site non engagé où les informations sont jouables. Engagez le sage et le site. Le sage fait un test de corruption modifié de -3. Gardez-le engagé jusqu’à ce qu’Andúril soit mise en réserve à un Havre [{H}]. Une fois en réserve, vous pouvez défausser une carte de Reforgeage mise en réserve et mettre Andúril avec Narsil.En plus des effets de Narsil, Andúril donne à son porteur 4 points de rassemblement, +4 en prouesse (maximum 11), +1 d’influence directe et 1 point de corruption en plus. Andúril peut être engagée pour désengager un Dúnadan de la même compagnie, mais son porteur doit faire un test de corruption modifié de -1."@fr ;
    meccg_prop:directInfluence "0(1)" ;
    meccg_prop:marshallingPoints "1(4)" ;
    meccg_prop:prowess "0(4)" ;
    meccg_prop:rarity "R" .

meccg:TW-193 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Das Schattenheer"@de,
        "Army of the Dead"@en,
        "Ejército de los Muertos"@es,
        "Vainajien armeija"@fi,
        "Armée des Morts"@fr,
        "Esercito dei Morti"@it,
        "死者の軍勢"@ja,
        "Army of the Dead"@nl ;
    dc:creator "Lubov" ;
    dc:identifier "TW-193" ;
    schema1:creator "Lubov" ;
    schema1:name "Army of the Dead" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "ArmyoftheDead.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Playable at Vale of Erech.  May only be played by Aragorn II on the same turn that he plays Paths of the Dead. May not be influenced by an opponent."@en,
        "Única. Jugable en el Valle de Erech.Solo puede ser jugada por Aragorn II en el mismo turno en que se juega Senderos de los Muertos. No puede ser influenciada por un oponente."@es,
        "Unique. Ne peut être jouée qu’au Val d’Erech. Ne peut être jouée que par Aragorn II le même tour que celui où il a joué les Chemins des Morts. Ne peut être influencée par un adversaire."@fr ;
    meccg_prop:marshallingPoints "6" ;
    meccg_prop:quote "“I see shapes of Men and of horses, and pale banners like shreds of cloud, and spears like winter-thickets on a misty night. The Dead are following.” —LotRV"@en,
        "“Veo formas de Hombres y de caballos, y estandartes pálidos como jirones de nubes, y lanzas como zarzas invernales en una noche de niebla. Los muertos nos siguen.” —SdlA III"@es,
        "“Je vois des formes d’hommes et de chevaux, et de pâles étendards semblables à des lambeaux de nuage, et des lances comme des gaulis dans une nuit brumeuse d’hiver. Les Morts nous suivent.” —SdAV"@fr ;
    meccg_prop:race "Special" ;
    meccg_prop:rarity "R" .

meccg:TW-194 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Aschenberge"@de,
        "Ash Mountains"@en,
        "Montañas de la Ceniza"@es,
        "Tuhkavuoret"@fi,
        "Monts Cendrés"@fr,
        "Monti Cenere"@it,
        "灰の山脈"@ja,
        "Ash Mountains"@nl ;
    dc:creator "Kevin Ward" ;
    dc:identifier "TW-194" ;
    schema1:creator "Kevin Ward" ;
    schema1:name "Ash Mountains" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "AshMountains.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Playable at the end of the organization phase on a company containing a ranger. If the company uses region cards for its site path, tap the ranger to move as if the following pairs of regions were adjacent: Dagorlad and Gorgoroth, Horse Plains and Gorgoroth. The company faces an attack at the beginning of its movement/hazard phase: Orcs — 4 strikes with 8 prowess.Alternatively, if the site moved to is in one of the regions listed above, the hazard limit is reduced by 2 (to a minimum of 2). Cannot be duplicated on a given company."@en,
        "Jugable al final de la fase de organización sobre una compañía que contenga un montaraz. Gira un montaraz para que su compañía se mueva como si las siguientes parejas de regiones se encontraran adyacentes: Dagorlad y Gorgoroth, Llanuras de los Caballos y Gorgoroth. La compañía deberá enfrentarse a un ataque al principio de la fase de movimiento/adversidades: Orcos: 4 golpes con poder 8.Alternativamente, si el sitio al que se ha movido la compañía está en una de las regiones mencionadas anteriormente, el límite de adversidades se reduce en dos (hasta un mínimo de 2). No puede ser duplicada sobre una misma compañía."@es,
        "Peuvent être joués à la fin de la phase d’organisation sur une compagnie qui contient un rôdeur. Si la compagnie utilise le déplacement régional, engagez le rôdeur pour la déplacer comme si les couples de régions suivants étaient adjacents : Dagorlad et Gorgoroth, Plaines des Chevaux et Gorgoroth. La compagnie affronte une attaque au début de sa phase de déplacement et de périls : Orques — 4 coups avec 8 en prouesse. Ou bien, si le site d’arrivée se trouve dans l’une de ces régions, la limite de périls est réduite de 2 (minimum 2). Ne peuvent être doublés sur une compagnie donnée."@fr ;
    meccg_prop:rarity "CB" .

meccg:TW-195 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Athelas"@de,
        "Athelas"@en,
        "Athelas"@es,
        "Athelas"@fi,
        "Athelas"@fr,
        "Athelas"@it,
        "アセラス"@ja,
        "Athelas"@nl ;
    dc:creator "Angelo Montanini" ;
    dc:identifier "TW-195" ;
    schema1:creator "Angelo Montanini" ;
    schema1:name "Athelas" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "Athelas.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "A Dúnadan can tap and use this item to heal a character in his company (change from wounded to well, character remains tapped).Aragorn II can also tap and use this item to remove a corruption card from a character in his company.Discard after use."@en,
        "Puedes girar un Dúnadan para utilizar este objeto y curar a un personaje que se encuentre en su compañía (el personaje pasa de estar herido a ileso, pero permanece girado).También puedes girar a Aragorn II y utilizar este objeto para eliminar una carta de corrupción que tenga un personaje de su compañía.Descartar después de utilizarla."@es,
        "Un Dúnadan peut s’engager et utiliser cet objet pour soigner un personnage de sa compagnie (qui passe de blessé à engagé). Aragorn II peut également s’engager et utiliser cet objet pour enlever une carte de corruption à un personnage de sa compagnie. Défaussez après usage."@fr ;
    meccg_prop:rarity "U" .

meccg:TW-196 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Schöner Goldener Ring"@de,
        "Beautiful Gold Ring"@en,
        "Hermoso Anillo de Oro"@es,
        "Kaunis Kultasormus"@fi,
        "Joli anneau d'or"@fr,
        "Bell'Anello d'Oro"@it,
        "「美しい」金の指輪"@ja,
        "Beautiful Gold Ring"@nl ;
    dc:creator "Larry Forcella" ;
    dc:identifier "TW-196" ;
    schema1:creator "Larry Forcella" ;
    schema1:name "Beautiful Gold Ring" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "BeautifulGoldRing.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Discard Beautiful Gold Ring when tested. If tested, make a roll to determine which ring card may be immediately played:• The One Ring (12+);• a Dwarven Ring (10,11,12+);• a Magic Ring (1,2,3,4,5,6,7);• a Lesser Ring (any result)."@en,
        "Descarta el Hermoso Anillo de Oro después de haberlo examinado. Si es examinado, haz una tirada para determinar qué carta de anillo puede ser jugada inmediatamente después:• El Anillo Único (12+);• Anillo Enano (10, 11, 12+);• Anillo Mágico (1, 2, 3, 4, 5, 6, 7);• Anillo Menor (cualquier resultado)."@es,
        "Défaussez le Joli anneau d’or quand il est vérifié. S’il subit une vérification, faites un jet pour déterminer quelle carte d’anneau peut être immédiatement jouée : • L’Anneau Unique (12 et +) ; • Un anneau Nain (10, 11, 12 et +) ; • Un anneau magique (1, 2, 3, 4, 5, 6, 7) ; • Un anneau moindre (n’importe quel résultat)."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:rarity "CA2" .

meccg:TW-197 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Beorninger"@de,
        "Beornings"@en,
        "Beórnidas"@es,
        "Beorningit"@fi,
        "Beornides"@fr,
        "Beorniani"@it,
        "ビヨルン一党"@ja,
        "Beornings"@nl ;
    dc:creator "Angelo Montanini" ;
    dc:identifier "TW-197" ;
    schema1:creator "Angelo Montanini" ;
    schema1:name "Beornings" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "Beornings.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Playable at Beorn’s House if the influence check is greater than 7. Standard Modifications: Men (+1)."@en,
        "Única. Jugable en la Casa de Beornsi el chequeo de influencia es superior a 7.Modificaciones Estándar: Hombres (+1)."@es,
        "Uniques. Peuvent être joués à la Maison de Beorn si le test d’influence est supérieur à 7.Modificateurs standards : Humains (+1)."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:quote "“‘… if it were not for the Beornings, the passage from Dale to Rivendell would long ago have become impossible. They are valiant men…’” —LotRII"@en,
        "“‘… si no fuera por los Beórnidas, ir del Valle a Rivendel hubiese sido imposible desde hace mucho tiempo. Son hombres valientes…’” —SdlA I"@es,
        "“N’étaient les Beornides, le passage du Val à Fondcombe serait depuis longtemps devenu impossible. Ce sont de vaillants hommes [...]” —SdAII"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "F1" .

meccg:TW-198 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Bill, das Pony"@de,
        "Bill the Pony"@en,
        "Bill el Pony"@es,
        "Bil Poni"@fi,
        "Bill le Poney"@fr,
        "Bill il pony"@it,
        "小馬のビル"@ja,
        "Bill the Pony"@nl ;
    dc:creator "Gail McIntosh" ;
    dc:identifier "TW-198" ;
    schema1:creator "Gail McIntosh" ;
    schema1:name "Bill the Pony" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:body "10" ;
    meccg_prop:cardImage "BillthePony.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Playable at Bree or Bag End; playable even if the site is tapped.If at a non-Haven/non-Under-deeps site and if his company’s size is three or less, you may discard Bill the Pony at the end of his company’s turn and replace its site with the nearest Haven [{H}]."@en,
        "Único. Jugable en Bree o en Bolsón Cerrado; jugable aunque el lugar esté girado.Si no se encuentra en un Refugio ni en un Lugar de las Profundidades y el tamaño de su compaía es de tres o menos, puedes descartar a Bill el Pony al final del turno y reemplazar el lugar en el que se encuentra por el Refugio [{H}] más cercano."@es,
        "Unique. Ne peut être joué qu’à Bree ou Cul-de-Sac ; peut être joué même si le site est engagé. S’il se trouve à un site non Havre, non Abîmes et si la taille de sa compagnie est de trois ou moins, vous pouvez défausser Bill le Poney à la fin du tour de sa compagnie et remplacer son site par le Havre [{H}] le plus proche. Cela est considéré comme un déplacement, sans phase de déplacements et périls. Pour un joueur Sorcier Déchu, il s’agit du site indiqué sur la version héros du site actuel."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:mind "1" ;
    meccg_prop:prowess "-2" ;
    meccg_prop:rarity "U" ;
    meccg_prop:skills "Ally" .

meccg:TW-199 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Abwehr"@de,
        "Block"@en,
        "Bloqueo"@es,
        "Torjunta"@fi,
        "Blocage"@fr,
        "Parata"@it,
        "ブロック"@ja,
        "Block"@nl ;
    dc:creator "Angus McBride" ;
    dc:identifier "TW-199" ;
    schema1:creator "Angus McBride" ;
    schema1:name "Block" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "Block.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Warrior only. Warrior does not tap against one strike (unless he is wounded by the strike)."@en,
        "Solo guerreros. El guerrero no se gira contra un golpe (a menos que resulte herido por el golpe)."@es,
        "Guerrier seulement. Le guerrier ne s’engage pas contre un coup (à moins d’être blessé par le coup)."@fr ;
    meccg_prop:quote "“… there was a twang of bowstrings: several arrows whistled over them, and some fell among them. One smote Frodo between the shoulders… but the arrow fell back, foiled by his hidden coat of mail.” —LotRII"@en,
        "“… en ese mismo momento se oyó el ruido seco de unos arcos: algunas flechas pasaron por encima de ellos y otras cayeron a las barcas. Una alcanzó a Frodo entre los hombros… pero la flecha rebotó entre la malla escondida.” —SdlA I"@es,
        "[...] se fit entendre le bruit de cordes d’arc : plusieurs flèches sifflèrent au-dessus de leurs têtes, et certaines tombèrent parmi eux. L’une d’elles atteignit Frodon entre les épaules [...] mais, parée par sa cotte de mailles cachée, la flèche retomba. —SdAII"@fr ;
    meccg_prop:rarity "CA" .

meccg:TW-2 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Adûnaphel"@de,
        "Adûnaphel"@en,
        "Adûnaphel"@es,
        "Adûnaphel"@fi,
        "Adûnaphel"@fr,
        "Adûnaphel"@it,
        "アドゥナフェル"@ja,
        "Adûnaphel"@nl ;
    dc:creator "Liz Danforth" ;
    dc:identifier "TW-2" ;
    schema1:creator "Liz Danforth" ;
    schema1:name "Adûnaphel" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "10" ;
    meccg_prop:cardImage "Adunaphel.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique.Nazgûl (7th). May be played as a hazard creature (with one strike) or as a permanent-event.As a creature, may also be played keyed to Brown Lands, Dagorlad, Gorgoroth, and Western Mirkwood; and may also be played at sites in these regions.If played as a permanent-event, it will remain in play until tapped during the opponent’s movement/hazard phase (tapping counts against the hazard limit). When tapped, Adûnaphel becomes a short-event and causes any one character to tap."@en,
        "Única.Nazgûl (7ª). Puede ser jugada como una adversidad-criatura (con un golpe) o como un suceso permanente.Como criatura, también puede ser jugada situada en: Tierras Pardas, Dagorlad, Gorgoroth, y Oeste del Bosque Negro; y puede ser jugada en los lugares de estas regiones.Si es jugada como un suceso permanente, permanece en juego hasta que sea girada durante la fase de movimiento/adversidades del oponente (girarla cuenta para el límite de adversidades). Cuando es girada, Adûnaphel se convierte en un suceso breve que hace girar a un personaje."@es,
        "Unique. Nazgûl (7e). 1 coup. En tant que créature, peut être jouée en association avec les Terres Brunes, Dagorlad, Gorgoroth et la Forêt Noire Occidentale ainsi qu’aux sites de ces régions. En tant qu’événement permanent, elle reste en jeu jusqu’à être engagée pendant la phase de déplacements et périls de l’adversaire (cela compte dans la limite de périls). Engagée, Adûnaphel devient un événement court et impose à un personnage de s’engager."@fr ;
    meccg_prop:marshallingPoints "5" ;
    meccg_prop:prowess "15" ;
    meccg_prop:race "Nazgûl" ;
    meccg_prop:rarity "R" .

meccg:TW-20 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Höhlendrache"@de,
        "Cave-drake"@en,
        "Dragón de las Cavernas"@es,
        "Luolakäärme"@fi,
        "Drake des cavernes"@fr,
        "Drago delle Caverne"@it,
        "洞穴のドレイク"@ja,
        "Cave-drake"@nl ;
    dc:creator "David Deitrick" ;
    dc:identifier "TW-20" ;
    schema1:creator "David Deitrick" ;
    schema1:name "Cave-drake" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "-" ;
    meccg_prop:cardImage "Cavedrake.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Dragon. Two strikes. Attacker chooses defending characters."@en,
        "Dragón. Dos golpes. El atacante elige a los personajes defensores."@es,
        "Dragon. 2 coups. L’attaquant choisit les personnages défenseurs. "@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:prowess "10" ;
    meccg_prop:quote "“About this time Dragons reappear in the far North and begin to afflict the Dwarves.” —LotR"@en,
        "“En esta época, los Dragones reaparecieron en el Norte y comenzaron a atacar a los Enanos.” —SdlA Apéndices"@es,
        "Aux environs de la même époque, les dragons réapparaissent dans le Grand Nord et se mettent à harceler les Nains. —SdA"@fr ;
    meccg_prop:race "Dragon" ;
    meccg_prop:rarity "CA2" .

meccg:TW-200 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Zwerge des Blauen Gebirges"@de,
        "Blue Mountain Dwarves"@en,
        "Enanos de las Montañas Azules"@es,
        "Sinivuorten Kääpiöt"@fi,
        "Nains des Montagnes Bleues"@fr,
        "Nani dei Monti Azzurri"@it,
        "青の山脈のドワーフ"@ja,
        "Blue Mountain Dwarves"@nl ;
    dc:creator "Angelo Montanini" ;
    dc:identifier "TW-200" ;
    schema1:creator "Angelo Montanini" ;
    schema1:name "Blue Mountain Dwarves" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "BlueMountainDwarves.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Playable at Blue Mountain Dwarf-hold  if the influence check is greater than 9. Standard Modifications: Elves (-2), Dwarves (+2)."@en,
        "Única. Jugable en la Fortaleza Enana de las Montañas Azulessi el chequeo de influencia es superior a 9.Modificaciones Estándar: Elfos (-2), Enanos (+2)."@es,
        "Uniques. Peuvent être joués à la Citadelle Naine des Montagnes Bleues si le test d’influence est supérieur à 9. Modificateurs standard : Elfes (-2), Nains (+2)."@fr ;
    meccg_prop:marshallingPoints "3" ;
    meccg_prop:quote "“Now they had fair halls in the mountains, and stores of goods, and their days did not seem so hard…” —LotR"@en,
        "“Ahora tenían hermosas estancias en las montañas y almacenes de bienes, y sus días no parecían tan duros…” —SdlA Apéndices"@es,
        "Désormais, ils avaient de belles salles dans les montagnes, et des réserves de marchandises, et leurs journées ne semblaient plus si difficiles [...] —SdA"@fr ;
    meccg_prop:race "Dwarf" ;
    meccg_prop:rarity "U" .

meccg:TW-201 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Buch von Mazarbul"@de,
        "Book of Mazarbul"@en,
        "Libro de Mazarbul"@es,
        "Mazarbulin Kirja"@fi,
        "Livre de Mazarbul"@fr,
        "Libro di Mazarbul"@it,
        "マザルブルの書"@ja,
        "Book of Mazarbul"@nl ;
    dc:creator "N. Taylor Blanchard" ;
    dc:identifier "TW-201" ;
    schema1:creator "N. Taylor Blanchard" ;
    schema1:name "Book of Mazarbul" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "BookofMazarbul.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Only playable at Moria. May be stored at a Dwarf-hold for 5 marshalling points. If its bearer is a sage, tap Book of Mazarbul during your organization phase to increase your hand size by 1 until your next untap phase."@en,
        "Único. Jugable en Moria. Puede ser almacenado en una Fortaleza Enana, en cuyo caso otorga 5 puntos de victoria. Si el portador es un sabio, gira el Libro de Mazarbul durante tu fase de organización para incrementar el tamaño de tu mano en 1 hasta tu próxima fase de enderezamiento."@es,
        "Unique. Ne peut être joué qu’à la Moria. Peut être mis en réserve dans une citadelle Naine pour 5 points de rassemblement. Si le porteur est un sage, engagez le Livre de Mazarbul pendant votre phase d’organisation pour augmenter de 1 la taille de votre main jusqu’à votre prochaine phase de désengagement."@fr ;
    meccg_prop:marshallingPoints "1(5)" ;
    meccg_prop:quote "“… it was so stained… that little of it could be read.” —LotRII"@en,
        "“… estaba tan manchado de negro… que poco podía leerse.” —SdlA I"@es,
        "[...] il était tellement souillé [...] que l’on ne pouvait en déchiffrer grand chose. —SdAII"@fr ;
    meccg_prop:rarity "U" .

meccg:TW-202 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Brücke"@de,
        "Bridge"@en,
        "Puente"@es,
        "Silta"@fi,
        "Pont"@fr,
        "Ponte"@it,
        "橋"@ja,
        "Bridge"@nl ;
    dc:creator "Stefano Baldo" ;
    dc:identifier "TW-202" ;
    schema1:creator "Stefano Baldo" ;
    schema1:name "Bridge" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "Bridge.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Playable at the end of the movement/hazard phase on a company that moved to a Haven [{H}]. That company may move to an additional site on the same turn. Another site card may be played and a movement/hazard phase immediately follows for that company."@en,
        "Jugable al final de la fase de movimiento/adversidades sobre una compañía que se haya movido hasta un Refugio [{H}]. Esa compañía puede moverse a un lugar adicional en el mismo turno. Se puede jugar otra carta de lugar y realizar inmediatamente una fase de movimiento/adversidades para esa compañía."@es,
        "Peut être joué à la fin de la phase de déplacements et périls sur une compagnie qui s’est déplacée vers un Havre [{H}]. Cette compagnie peut se déplacer vers un site de plus ce même tour. Une autre carte de site peut être jouée et une phase de déplacements et périls s’ensuit pour cette compagnie. Votre main doit retrouver sa taille normale avant votre seconde phase de déplacements et périls."@fr ;
    meccg_prop:rarity "U" .

meccg:TW-203 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Klarer Himmel"@de,
        "Clear Skies"@en,
        "Cielo Despejado"@es,
        "Kaunis Sää"@fi,
        "Ciel dégagé"@fr,
        "Cieli Sereni"@it,
        "晴れた空"@ja,
        "Clear Skies"@nl ;
    dc:creator "Kevin Ward" ;
    dc:identifier "TW-203" ;
    schema1:creator "Kevin Ward" ;
    schema1:name "Clear Skies" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "ClearSkies.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Environment. Playable only if Gates of Morning is in play. The prowess of each character is modified by +2."@en,
        "Ambiental. Solo se puede jugar si están en juego las Puertas del Amanecer. El poder de todos los personajes se ve modificado en un +2."@es,
        "Environnement. Ne peut être joué que si les Portes du Matin sont en jeu. La prouesse de chaque personnage est modifiée de +2."@fr ;
    meccg_prop:quote "“Over all the sky was blue, and the sun of afternoon glowed upon the hill and cast long green shadows beneath the trees.” —LotRII"@en,
        "“Arriba el cielo era azul, y el sol de la tarde resplandecía en la loma y echaba largas sombras verdes entre los árboles.” —SdlA I"@es,
        "Par dessus tout le ciel était bleu, et le soleil de l’après-midi brillait sur la colline et dessinait de longues ombres vertes sous les arbres. —SdAII"@fr ;
    meccg_prop:rarity "R" .

meccg:TW-204 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Versteck"@de,
        "Concealment"@en,
        "Ocultamiento"@es,
        "Lymypaikka"@fi,
        "Camouflage"@fr,
        "Occultamento"@it,
