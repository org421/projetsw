        "Anneau magique de férocité"@fr,
        "Magic Ring of Savagery"@nl ;
    dc:creator "Ronald Chironna" ;
    dc:identifier "LE-321" ;
    schema1:creator "Ronald Chironna" ;
    schema1:name "Magic Ring of Savagery" ;
    meccg_prop:alignment "Minion" ;
