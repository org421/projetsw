    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Playable at Wose Passage-hold if the influence check is greater than 8. Standard Modifications: none."@en,
        "Única. Jugable en el Fuerte de Paso de los Wosessi el chequeo de influencia es superior a 8.Modificaciones Estándar: ninguna."@es,
        "Uniques. Peuvent être joués au Tumulus wose si le test d’influence est supérieur à 8.Modificateurs standards : Aucun."@fr ;
    meccg_prop:marshallingPoints "3" ;
    meccg_prop:quote "“‘Remnants of an older time they be, living few and secretly, wild and wary as the beasts.’” —LotRV"@en,
        "“‘Vestigios de un tiempo ya remoto, viven secretamente, en grupos pequeños, y son cautos e indómitos como bestias.’” —SdlA III"@es,
        "“Ils sont un Vestige du temps passé ; ils vivent en petit nombre et secrètement, sauvages et aussi méfiants que des bêtes.” —SdAV"@fr ;
    meccg_prop:race "Wose" ;
    meccg_prop:rarity "R" .

