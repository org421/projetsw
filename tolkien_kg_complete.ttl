    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. +2 direct influence against the Variags of Khand faction."@en,
        "Única. +2 a su influencia directa contra la facción de los Variags de Khand."@es,
        "Unique. +2 à l’influence directe sur la faction des Variags de Khand."@fr ;
