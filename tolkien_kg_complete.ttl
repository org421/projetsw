    rdfs:label "Versuchung des Erschaffens"@de,
        "Lure of Creation"@en,
        "Atracción de la Creación"@es,
        "Luomisen Kiusaus"@fi,
        "Attrait de la création"@fr,
        "Brama di Creazione"@it,
        "創造の誘い"@ja,
        "Lure of Creation"@nl ;
    dc:creator "Ron Rousselle II" ;
