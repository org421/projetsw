    meccg_prop:rarity "R2" ;
    meccg_prop:skills "Warrior" .

meccg:AS-20 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Wächter des Truchsessen"@de,
        "Steward’s Guard"@en,
        "Guardia del Senescal"@es,
        "La garde de l'intendant"@fr,
        "Steward's Guard"@nl ;
    dc:creator "Brad Williams" ;
    dc:identifier "AS-20" ;
    schema1:creator "Brad Williams" ;
    schema1:name "Steward’s Guard" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "-" ;
    meccg_prop:cardImage "StewardsGuard.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Dúnedain. Five strikes. Detainment against hero and covert companies. May be played keyed to Wold & Foothills, Rohan, Anórien, Lebennin, Brown Lands, Dagorlad, Ithilien, or Harondor."@en,
        "Dúnedain. Cinco golpes. Retención contra compañías de héroes o encubiertas. Pueden ser jugados situados en: Páramo y Colinas, Rohan, Anórien, Lebennin, Tierras Pardas, Dagorlad, Ithilien, o Harondor."@es,
        "Dúnedain. 5 coups. Dilatoire contre les compagnies de héros et les compagnies voilées. Peut être jouée en association avec le Plateau, le Rohan, l’Anórien, le Lebennin, les Terres Brunes, le Dagorlad, l’Ithilien ou l’Harondor."@fr ;
    meccg_prop:marshallingPoints "1*" ;
    meccg_prop:prowess "8" ;
    meccg_prop:quote "“‘By our valour… the terror of Morgul kept at bay; and thus alone are peace and freedom maintained in the lands behind us, bulwark of the West.’” —LotRII"@en,
        "“Nuestro valor… ha contenido el terror de Morgul, y solo así han sido aseguradas la paz y la libertad en las tierras que están detrás de nosotros, el baluarte del Oeste.” —SdlA I"@es,
        "“Par notre valeur [...] la terreur de Morgul tenue aux abois, et c’est ainsi seulement que la paix et la liberté sont assurées aux terres qui sont derrière nous, rempart de l’Ouest.” —SdAII"@fr ;
    meccg_prop:race "Dúnedain" ;
    meccg_prop:rarity "C2" .

meccg:AS-21 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Standhafte Männer von Gondor"@de,
        "Stout Men of Gondor"@en,
        "Valientes Hombres de Gondor"@es,
        "Farouches Hommes du Gondor"@fr,
        "Stout Men of Gondor"@nl ;
    dc:creator "Ron Walotsky" ;
    dc:identifier "AS-21" ;
    schema1:creator "Ron Walotsky" ;
    schema1:name "Stout Men of Gondor" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "-" ;
    meccg_prop:cardImage "StoutMenofGondor.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Men. Six strikes. Detainment against hero and covert companies. May be played keyed to Old Pûkel-land, Old Pûkel Gap, Andrast, Anfalas, Lamedon, Belfalas, Lebennin, Anórien, or Rohan; or at sites in these regions."@en,
        "Hombres. Seis golpes. Retención contra compañías de héroes o encubiertas. Pueden ser jugados situados en: Tierra del Viejo Púkel, Desfiladero del Viejo Púkel, Andrast, Anfalas, Lamedon, Belfalas, Lebennin, Anórien, o Rohan; o en los lugares de dichas regiones."@es,
        "Humains. 6 coups. Dilatoire contre les compagnies de héros et les compagnies voilées. Peuvent être joués en association avec le Pays des Vieux Biscornus, la Passe des Vieux Biscornus, l’Andrast, l’Anfalas, le Lamedon, le Belfalas, le Lebennin, l’Anórien ou le Rohan ainsi qu’aux sites de ces régions."@fr ;
    meccg_prop:marshallingPoints "1*" ;
    meccg_prop:prowess "7" ;
    meccg_prop:quote "“‘But still we fight on, holding all the west shores of Anduin; and those who shelter behind us give us praise…’” —LotRII"@en,
        "“Pero continuamos la lucha, defendiendo toda la costa occidental del Anduin, y quienes buscan refugio detrás de nosotros nos alaban.” —SdlA I"@es,
        "“Mais nous continuâmes à nous battre, tenant toutes les rives ouest de l’Anduin, et ceux qui s’abritent derrière nous nous adressent des louanges [...]” —SdAII"@fr ;
    meccg_prop:race "Men" ;
    meccg_prop:rarity "C3" .

meccg:AS-22 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Bergtrolle"@de,
        "Trolls from the Mountains"@en,
        "Trolls de las Montañas"@es,
        "Trolls des montagnes"@fr,
        "Trolls from the Mountains"@nl ;
    dc:creator "Omar Rayyan" ;
    dc:identifier "AS-22" ;
    schema1:creator "Omar Rayyan" ;
    schema1:name "Trolls from the Mountains" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "5" ;
    meccg_prop:cardImage "TrollsfromtheMountains.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Trolls. Three strikes."@en,
        "Trolls. Tres golpes."@es,
        "Trolls. 3 coups."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:prowess "12" ;
    meccg_prop:quote "“‘For a couple o’ pins,’ says Troll, and grins…‘ I’ll eat thee too, and gnaw thy shins.’” —LotRI"@en,
        "“ʻUn poco más,ʼ dijo el troll sonriendo, ʻy a ti también te comeré y roeré las tibias. ¡Un bocado de carne fresca me caerá bien! Te clavaré los dientes ahora mismo.ʼ” —SdlA I"@es,
        "“Pour un peu, dit Troll avec une grimace, je te mangerais aussi et rongerais tes tibias.” —SdAI"@fr ;
    meccg_prop:race "Trolls" ;
    meccg_prop:rarity "C2" .

meccg:AS-23 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Verräterische Augen"@de,
        "A Lie in Your Eyes"@en,
        "Una mentira en tus ojos"@es,
        "Un mensonge dans vos yeux"@fr,
        "A Lie in Your Eyes"@nl ;
    dc:creator "Zina Saunders" ;
    dc:identifier "AS-23" ;
    schema1:creator "Zina Saunders" ;
    schema1:name "A Lie in Your Eyes" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "ALieinYourEyes.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Playable on an untapped non-Ringwraith, non-Wizard character. Your opponent may either: tap the character, tap an ally the character controls, or choose for you to make a roll. If the result is greater than the character’s mind plus 6, the character is discarded (along with all non-follower cards he controls)."@en,
        "Jugable sobre un personaje enderezado que no sea Espectro del Anillo ni Mago. Tu oponente puede: girar el personaje, girar un aliado que controle el personaje, o elegir que tú hagas una tirada. Si el resultado es superior a la mente del personaje más seis, el personaje es descartado (junto con todas las cartas que controle que no sean seguidores)."@es,
        "Peut être joué sur un personnage désengagé non Spectre, non Sorcier. Votre adversaire peut soit : engager le personnage, engager un allié que le personnage contrôle, ou choisir que vous fassiez un jet. Si le résultat est supérieur à l’esprit du personnage plus 6, le personnage est défaussé (ainsi que toutes les cartes qu’il contrôle)."@fr ;
    meccg_prop:quote "“‘That won’t do… What did you see, and what did you say?’” —LotRIII"@en,
        "“ʻEso no basta… ¿Qué es lo que viste, y qué es lo que dijiste?ʼ” —SdlA II"@es,
        "“Cela ne suffit pas, dit sévèrement Gandalf. Qu’avez-vous vu et qu’avez-vous dit ?” —SdAIII"@fr ;
    meccg_prop:rarity "R2" .

meccg:AS-24 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Allein und ratlos"@de,
        "Alone and Unadvised"@en,
        "Solo y Sin Consejo"@es,
        "Seul et malavisé"@fr,
        "Alone and Unadvised"@nl ;
    dc:creator "Liz Danforth" ;
    dc:identifier "AS-24" ;
    schema1:creator "Liz Danforth" ;
    schema1:name "Alone and Unadvised" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "AloneandUnadvised.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Corruption. Playable on a non-Wizard, non-Ringwraith character in a company with 3 or fewer characters. Target character makes a corruption check at the end of his movement/hazard phase for each region he moved through. All of his corruption checks are modified by adding the number of characters in his company. During his organization phase, the character may tap to attempt to remove this card. Make a roll—if the result is greater than 6, discard this card. Discard this card if his company has 4 or more characters. Cannot be duplicated on a given character."@en,
        "Corrupción. Jugable sobre un personaje que no sea Mago ni Espectro del Anillo en una compañía con tres o menos personajes. El personaje objetivo hace un chequeo de corrupción al final de su fase de movimiento/adversidades por cada región por la que se haya movido a través. Todos sus chequeos de corrupción son modificados añadiendo el número de personajes en su compañía. Durante su fase de organización, el personaje puede girarse para intentar eliminar esta carta. Haz una tirada—si el resultado es superior a 6, descarta esta carta. Descarta esta carta si su compañía tiene 4 o más personajes. No puede ser duplicada sobre un mismo personaje."@es,
        "Corruption. Peut être joué sur un personnage non Spectre, non Sorcier dans une compagnie avec 3 personnages ou moins. Le personnage visé fait un test de corruption à la fin de sa phase de déplacements et périls pour chaque région qu’il a traversée. Tous ses tests de corruption sont modifiés en ajoutant le nombre de personnages dans sa compagnie. Pendant sa phase d’organisation, le personnage peut s’engager pour tenter de retirer cette carte, faites un jet. Si le résultat est supérieur à 6, défaussez cette carte. Défaussez cette carte si sa compagnie compte 4 personnages ou plus. Ne peut être doublé sur un personnage donné."@fr ;
    meccg_prop:rarity "C3" .

meccg:AS-25 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Komm' zur rechten Zeit"@de,
        "Come at Need"@en,
        "Acudir en Momentos Difíciles"@es,
        "Arrivé à point nommé"@fr,
        "Come at Need"@nl ;
    dc:creator "Cortney Skinner" ;
    dc:identifier "AS-25" ;
    schema1:creator "Cortney Skinner" ;
    schema1:name "Come at Need" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "ComeatNeed.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Playable if you have an ally able to be attacked in your hand. When this card is played, place one ally from your hand “off to the side” with it (the ally gives no marshalling points). The ally must be able to be attacked. If an opponent’s company moves to a site where the ally is playable, it faces a single-strike attack (with no type) with the attributes of the ally, except the prowess is increased by 7. The attack is detainment if the ally and the company are both minion or both hero; and this card is discarded afterwards. If defeated, discard this card and place the ally in your opponent’s marshalling point pile—he receives the ally’s marshalling points as kill points. You may return the ally to your hand and discard this card during your organization phase."@en,
        "Jugable si tienes un aliado que pueda ser atacado en tu mano. Cuando esta carta es jugada, coloca un aliado que esté en tu mano “a un lado” con ella (el aliado no proporciona puntos de victoria). El aliado debe poder ser atacado. Si una compañía de tu oponente se mueve a un lugar donde el aliado es jugable, se enfrenta a un ataque de un golpe (sin tipo) con los atributos del aliado, excepto su poder que aumenta en 7. El ataque es de retención si el aliado y la compañía son ambos servidores o héroes; y esta carta es descartada a continuación. Si es derrotado, descarta esta carta y coloca el aliado en la pila de puntos de victoria de tu oponente—recibe los puntos de victoria del aliado como puntos por muertes. Puedes devolver el aliado a tu mano y descartar esta carta durante tu fase de organización."@es,
        "Peut être joué si vous avez dans votre main un allié pouvant être attaqué. Lorsque cette carte est jouée, mettez un allié de votre main “sur le côté” sous cette carte (l’allié ne donne aucun point de rassemblement). Si une compagnie de l’adversaire se déplace vers un site où l’allié peut être mis en jeu, elle affronte une attaque avec un seul coup (aucun type) qui possède les caractéristiques de l’allié et +7 à la prouesse. L’attaque est dilatoire si l’allié et la compagnie sont tous deux des séides ou tous deux des héros ; et cette carte est défaussée ensuite. Si l’attaque est battue, défaussez cette carte et mettez l’allié dans la pile de points de rassemblement de votre adversaire - il reçoit les points de rassemblement de l’allié comme points de mort. Vous pouvez remettre l’allié dans votre main et défausser cette carte pendant votre phase d’organisation."@fr ;
    meccg_prop:rarity "C2" .

meccg:AS-26 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Frühe Ernte"@de,
        "Early Harvest"@en,
        "Cosecha temprana"@es,
        "Récolte précoce"@fr,
        "Early Harvest"@nl ;
    dc:creator "Pascal Yung" ;
    dc:identifier "AS-26" ;
    schema1:creator "Pascal Yung" ;
    schema1:name "Early Harvest" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "EarlyHarvest.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Playable on a faction that is normally playable at a Border-hold [{B}] (except Army of the Dead). Make a roll modified by -1 if the faction is a minion faction. Return the faction to opponent’s hand if the result plus the normal marshalling points the faction gives is greater than 12."@en,
        "Jugable sobre una facción que normalmente sea jugable en un Bastión Fronterizo [{B}] (excepto El Ejército de los Muertos). Haz una tirada modificada con un -1 si la facción es de servidores. Devuelve la facción a la mano de tu oponente si el resultado más los puntos de victoria que normalmente otorga lafacción es superior a 12."@es,
        "Peut être jouée sur une faction normalement jouable à un fief frontalier [{B}] (sauf l’Armée des Morts). Faites un jet modifié de -1 si la faction est une faction de séides. Remettez la faction dans la main de l’adversaire si le résultat plus les points de rassemblement normaux que vaut la faction est supérieur à 12."@fr ;
    meccg_prop:quote "“… the vines were laden… and everywhere there was so much corn that at Harvest every barn was stuffed.” —LotRVI"@en,
        "“… las viñas estaban llenas… y en todos lados había tanto trigo que al cosecharlo todos los graneros estaban llenos a rebosar.” —SdlA III"@es,
        "[...] les vignes étaient chargées de raisin [...] et partout il y eut tant de blé qu’à la Moisson toutes les granges furent bourrées. —SdAVI"@fr ;
    meccg_prop:rarity "C2" .

meccg:AS-27 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Verzauberter Strom"@de,
        "Enchanted Stream"@en,
        "Arroyo Encantado"@es,
        "La rivière enchantée "@fr,
        "Enchanted Stream"@nl ;
    dc:creator "Brad Williams" ;
    dc:identifier "AS-27" ;
    schema1:creator "Brad Williams" ;
    schema1:name "Enchanted Stream" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "EnchantedStream.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Playable on a moving company with at least one Wilderness [{w}] in its site path. A ranger in the company can tap to cancel this card before it resolves. The company cannot voluntarily split or move to a new site unless it taps all of its untapped characters to a maximum of two during its organization phase. Discard during any organization phase if the  company is at a Haven/Darkhaven [{DH}]."@en,
        "Jugable sobre una compañía que se esté moviendo con al menos una Tierra Salvaje [{w}] en su itinerario. Un montaraz en la compañía puede girarse para cancelar esta carta antes de que se resuelva. Durante su fase de organización, la compañía no puede dividirse voluntariamente ni moverse hasta un nuevo lugar a menos que gire todos sus personajes enderezados hasta un máximo de dos. Descartar durante cualquier fase de organización si la compañía se encuentra en un Refugio/Refugio Oscuro [{DH}]."@es,
        "Peut être jouée sur une compagnie qui se déplace avec au moins une contrée sauvage [{w}] dans son itinéraire. Un rôdeur de la compagnie peut s’engager pour annuler cette carte avant qu’elle ne soit résolue. La compagnie ne peut se diviser volontairement ou se déplacer vers un nouveau site, à moins que ses personnages désengagés ne s’engagent pendant sa phase d’organisation (maximum 2). Défaussez cette carte pendant toute phase d’organisation où la compagnie se trouve à un Havre [{H}] ou un Havre Noir [{K}]."@fr ;
    meccg_prop:rarity "C3" .

meccg:AS-28 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Rrüfung des Treueeids"@de,
        "Fealty Under Trial"@en,
        "Fidelidad Puesta a Prueba"@es,
        "Allégeance mise à l'épreuve"@fr,
        "Fealty Under Trial"@nl ;
    dc:creator "Omar Rayyan" ;
    dc:identifier "AS-28" ;
    schema1:creator "Omar Rayyan" ;
    schema1:name "Fealty Under Trial" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "FealtyUnderTrial.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Playable on a minion in a Darkhaven [{DH}] or Barad-dûr. Make a roll adding the marshalling points (as though they were stored) and corruption points of all items and events played with target minion. All items and storable events played with target minion are then automatically stored (no corruption checks are made). Then, if the result was greater than 15, discard the minion (and all other cards played with him)."@en,
        "Jugable sobre un servidor que se encuentre en un Refugio Oscuro [{DH}] o en Barad-dûr. Haz una tirada y añade los puntos de victoria (como si estuvieran almacenados) y los puntos de corrupción de todos los objetos y sucesos jugados sobre el servidor objetivo. Todos los objetos y sucesos almacenables jugados sobre el servidor son almacenados automáticamente (sin hacer chequeos de corrupción). A continuación, si el resultado fue superior a 15, descarta el servidor (y todas las demás cartas jugadas sobre él)."@es,
        "Peut être jouée sur un séide à un Havre Noir [{K}] ou à Barad-dûr. Faites un jet en y ajoutant les points de rassemblement (comme s’ils étaient mis en réserve) et les points de corruption de tous les objets et événements joués avec le séide visé. Tous les objets et événements joués avec le séide visé et qui peuvent être mis en réserve sont alors automatiquement mis en réserve (aucun test de corruption n’est effectué). Ensuite, si le résultat est supérieur à 15, défaussez le séide (et toutes les autres cartes jouées avec lui)."@fr ;
    meccg_prop:rarity "C2" .

meccg:AS-29 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Furcht! Feuer! Feinde!"@de,
        "FEAR! FIRE! FOES!"@en,
        "¡Peligro! ¡Fuego! ¡Enemigos!"@es,
        "DANGER ! AU FEU ! L'ENNEMI !"@fr,
        "FEAR! FIRE! FOES!"@nl ;
    dc:creator "Michael Kucharski" ;
    dc:identifier "AS-29" ;
    schema1:creator "Michael Kucharski" ;
    schema1:name "FEAR! FIRE! FOES!" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "FEARFIREFOES.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Playable on a Free-hold [{F}] or Border-hold [{B}]. An additional automatic-attack is created at the site this turn: 5 strikes with 8 prowess (detainment, no attack type). Alternatively, playable on a detainment automatic-attack a minion company is facing. The attack becomes normal (not detainment) and has -1 prowess."@en,
        "Jugable sobre un Bastión Libre [{F}] o un Bastión Fronterizo [{B}]. Se crea un ataque automático adicional en el lugar este turno: 5 golpes de poder 8 (retención, el ataque no tiene tipo).Alternativamente, jugable sobre un ataque automático de retención al que se enfrente una compañía de servidores. El ataque se vuelve normal (no de retención) y tiene un -1 al poder."@es,
        "Peut être joué sur un fief libre [{F}] ou un fief frontalier [{B}]. Une attaque automatique supplémentaire est créée au site ce tour-ci : 5 coups avec 8 en prouesse (dilatoire, aucun type). Ou bien, peut être joué sur une attaque automatique dilatoire qu’une compagnie de séides affronte. L’attaque devient normale (pas dilatoire) et sa prouesse est modifiée de -1."@fr ;
    meccg_prop:quote "“The Brandybucks were blowing the Horn-call  of Buckland…” —LotRI"@en,
        "“Los Brandigamo estaban tocando el cuerno de llamada de Los Gamos…” —SdlA III"@es,
        "Les Brandebouc sonnaient l’appel du cor du Pays de Bouc [...] —SdAI"@fr ;
    meccg_prop:rarity "C3" .

meccg:AS-3 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Mîonid"@de,
        "Mîonid"@en,
        "Mîonid"@es,
        "Mîonid"@fr,
        "Míonid"@nl ;
    dc:creator "Omar Rayyan" ;
    dc:identifier "AS-3" ;
    schema1:creator "Omar Rayyan" ;
    schema1:name "Mîonid" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "8" ;
    meccg_prop:cardImage "Mionid.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. +2 direct influence against any faction playable at Variag Camp."@en,
        "Único. +2 a su influencia directa contra cualquier facción jugable en el Campamento Variag."@es,
        "Unique. +2 à l’influence directe sur toute faction jouable au Camp Variag."@fr ;
    meccg_prop:directInfluence "0" ;
    meccg_prop:homeSite "Variag Camp" ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:mind "4" ;
    meccg_prop:prowess "5" ;
    meccg_prop:quote "“Many of the Wainriders… passed south of Mordor and made alliance with men of Khand and of Near Harad…” —LotR"@en,
        "“Muchos de los Aurigas se encaminaron al sur de Mordor y se aliaron con los hombres de Khand y del Cercano Harad...” —SdlA Apéndices"@es,
        "[...] les Orientaux des chariots passèrent nombreux au sud du Mordor et ils s’allièrent aux Hommes du Khand et du Proche Harad. —SdA"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "U2" ;
    meccg_prop:skills "Warrior/Ranger" .

meccg:AS-30 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Schäumende Raserei"@de,
        "Full of Froth and Rage"@en,
        "Rabiosas y Echando Espuma"@es,
        "Écumantes et pleines de rage"@fr,
        "Full of Froth and Rage"@nl ;
    dc:creator "Ted Nasmith" ;
    dc:identifier "AS-30" ;
    schema1:creator "Ted Nasmith" ;
    schema1:name "Full of Froth and Rage" ;
    meccg_prop:alignment "Neutral" ;
