    meccg_prop:marshallingPoints "3" ;
    meccg_prop:quote "“‘… the Woses, the Wild Men of the Woods… they use poisoned arrows, it is said, and they are woodcrafty beyond compare.’” —LotRV"@en,
        "“‘… los Hombres Salvajes de los Bosques… se dice que tienen flechas envenenadas, y nadie conoce tan bien como ellos los secretos de los bosques.’” —SdlA III"@es,
        "“[...] les Woses, les Hommes Sauvages des Bois [...] ils se servent de flèches empoisonnées, à ce qu’on dit, et ce sont des chasseurs incomparables.” —SdAV"@fr ;
    meccg_prop:race "Wose" ;
