    rdfs:label "Alte Festung der Tiefe"@de,
        "Ancient Deep-hold"@en,
        "Antigua Fortaleza Subterránea"@es,
        "Antique forteresse des Abîmes"@fr,
        "Ancient Deep-hold"@nl ;
    dc:creator "Doug Kovacs" ;
    dc:identifier "BA-83" ;
    schema1:creator "Doug Kovacs" ;
    schema1:name "Ancient Deep-hold" ;
