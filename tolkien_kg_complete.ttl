        "Barrow-wight"@en,
        "Tumulario"@es,
        "Haudanhaamu"@fi,
        "Être des galgals"@fr,
        "Spettro dei Tumuli"@it,
        "塚人"@ja,
        "Barrow-wight"@nl ;
    dc:creator "Lori Deitrick" ;
