    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. +2 direct influence against the Hillmen faction."@en,
        "Único. +2 a su influencia directa contra la facción de los Montañeses."@es,
        "Unique. +2 à l’influence directe sur la faction des Hommes de Collines."@fr ;
    meccg_prop:directInfluence "1" ;
    meccg_prop:homeSite "Cameth Brin" ;
    meccg_prop:marshallingPoints "0" ;
    meccg_prop:mind "1" ;
    meccg_prop:prowess "0" ;
    meccg_prop:quote "“‘Halbarad Dúnadan, Ranger of the North I am,’ cried the man. ‘We seek one Aragorn son of Arathorn, and we heard that he was in Rohan.’” —LotRV"@en,
        "“ʻYo soy Halbarad Dúnadan, Montaraz del Norteʼ respondió el hombre ʻBuscamos a un tal Aragorn hijo de Arathorn, y habíamos oído que está en Rohan.ʼ” —SdlA III"@es,
        "“Je suis Halbarad Dúnadan, Rôdeur du Nord, cria l’homme. Nous cherchons un certain Aragorn fils d’Arathorn, et nous avons entendu dire qu’il était en Rohan.” —SdAV"@fr ;
    meccg_prop:race "Dúnadan" ;
    meccg_prop:rarity "U" ;
    meccg_prop:skills "Sage/Diplomat" .

