    meccg_prop:cardImage "Carambor.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. May tap at the end of his company's movement/hazard phase to allow it to move to an additional site on the same turn. Another site card may be played and another movement/hazard phase immediately follows for his company. The new site path must contain at least one Wilderness [{w}]."@en,
        "Único. Puede ser girado al final de su fase de movimiento/adversidades para permitir que su compañía se mueva a un lugar adicional este mismo turno. Puede jugarse una nueva carta de lugar y la compañía realiza inmediatamente otra fase de movimiento/adversidades. El nuevo itinerario de la compañía debe tener al menos una Tierra Salvaje [{w}]."@es,
        "Unique. Peut s’engager à la fin de la phase de déplacement et périls de sa compagnie pour lui permettre de se déplacer vers un autre site dans le même tour. Une autre carte de site peut être jouée et une autre phase de déplacements et périls suit immédiatement pour sa compagnie. Le nouvel itinéraire doit contenir au moins une contrée sauvage [{w}]."@fr ;
    meccg_prop:directInfluence "0" ;
    meccg_prop:homeSite "Carn Dûm" ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:mind "6" ;
    meccg_prop:prowess "5" ;
    meccg_prop:race "Elf" ;
    meccg_prop:rarity "R" ;
    meccg_prop:skills "Warrior/Scout/Ranger" .

meccg:LE-50 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Adûnaphel der Ringgeist"@de,
        "Adûnaphel the Ringwraith"@en,
        "Adûnaphel la Espectro del Anillo"@es,
        "Adûnaphel la Spectre"@fr,
        "Adûnaphel the Ringwraith"@nl ;
    dc:creator "Heather Hudson" ;
    dc:identifier "LE-50" ;
    schema1:creator "Heather Hudson" ;
    schema1:name "Adûnaphel the Ringwraith" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "10" ;
    meccg_prop:cardImage "AdunapheltheRingwraith.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. Manifestation of Adûnaphel. Can use spirit-magic. +2 direct influence in Heralded Lord mode. -2 prowess in Fell Rider mode. As your Ringwraith, if at a Darkhaven [{DH}], she may tap to cancel one hazard creature attack not played at a site against any one of your companies."@en,
        "Única. Manifestación de Adûnaphel. Puede utilizar magia espiritual. +2 a su influencia directa en modo Señor de los Hombres. -2 a su poder en modo Jinete Maligno. Como tu Espectro del Anillo, si se encuentra en un Refugio Oscuro [{DH}], puede ser girada para cancelar un ataque de una adversidad-criatura que no esté situado en un lugar contra una de tus compañías."@es,
        "Unique. Manifestation d’Adûnaphel. Peut utiliser la magie des esprits. +2 à l’influence directe en mode Seigneur proclamé. -2 à la prouesse en mode Aile Noire. Si elle est votre Spectre, et à un Havre Noir [{K}], elle peut s’engager pour annuler une attaque d’un péril de créature contre l’une de vos compagnies et qui n’est pas joué à un site."@fr ;
    meccg_prop:directInfluence "4" ;
    meccg_prop:homeSite "Urlurtsu Nurn" ;
    meccg_prop:prowess "8" ;
    meccg_prop:race "Ringwraith" ;
    meccg_prop:rarity "F1" ;
    meccg_prop:skills "Warrior/Scout/Diplomat" .

meccg:LE-51 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Akhôrahil der Ringgeist"@de,
        "Akhôrahil the Ringwraith"@en,
        "Akhôrahil el Espectro del Anillo"@es,
        "Akhôrahil le Spectre"@fr,
        "Akhôrahil the Ringwraith"@nl ;
    dc:creator "Stephen Graham Walsh" ;
    dc:identifier "LE-51" ;
    schema1:creator "Stephen Graham Walsh" ;
    schema1:name "Akhôrahil the Ringwraith" ;
    meccg_prop:alignment "Minion" ;
