meccg:TW-376 a schema1:Place,
        meccg_class:Card,
        meccg_class:Site ;
    rdfs:label "Beorns Haus"@de,
        "Beorn’s House"@en,
        "Casa de Beorn"@es,
        "Beornin Talo"@fi,
        "Maison de Beorn"@fr,
