meccg:LE-368 a schema1:Place,
        meccg_class:Card,
        meccg_class:Site ;
    rdfs:label "Drúadanwald"@de,
        "Drúadan Forest"@en,
        "Bosque Drúadan"@es,
        "Forêt du Drúadan"@fr,
        "Drúadan Forest"@nl ;
    dc:creator "Gail McIntosh" ;
    dc:identifier "LE-368" ;
    schema1:about tolkien:Dr%C3%BAadan_Forest ;
    schema1:creator "Gail McIntosh" ;
    schema1:name "Drúadan Forest" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "DruadanForest.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Nearest Darkhaven: Minas MorgulAutomatic-attacks:Men — 3 strikes with 6 prowess"@en,
        "Refugio Oscuro más cercano: Minas MorgulAtaques Automáticos:Hombres — 3 golpes de poder 6"@es,
        "Havre Noir le plus proche : Minas MorgulAttaques automatiques :Humains — 3 coups avec 6 en prouesse"@fr ;
    meccg_prop:quote "“… the forgotten wain-road long ago had run down… but now for many lives of men trees had had their way with it, and it had vanished, broken and buried under the leaves of uncounted years.” —LotRV"@en,
        "“… el camino de carros olvidado se había abandonado hacía tiempo… pero durante muchas vidas de los hombres, los árboles se habían apoderado de él, y había desaparecido, quebrantado y enterrado bajo las hojas de incontables años.” —SdlA III"@es,
        "[...] la route charretière oubliée descendait jadis [...] mais à présent, depuis bien des générations d’hommes, les arbres en avaient disposé à leur façon, et elle avait disparu, défoncée et enterrée sous les feuilles d’années sans nombre. —SdAV"@fr ;
    meccg_prop:rarity "U" ;
    tolkien_prop:depicts tolkien:Dr%C3%BAadan_Forest .

meccg:LE-372 a schema1:Place,
