    meccg_prop:alignment "Hero" ;
    meccg_prop:body "+2" ;
    meccg_prop:cardImage "HauberkofBrightMail.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Armor. Warrior only: +2 to body to a maximum of 9."@en,
        "Armadura. Solo guerreros: +2 a la resistencia hasta un máximo de 9."@es,
        "Armure. Guerrier seulement : +2 à l’endurance (maximum 9)."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:quote "“Each one of his folk was clad in a hauberk of steel mail that hung to his knees…” —Hob"@en,
        "“Todos los enanos de la tropa estaban ataviados con cotas de malla de acero que les llegaban a las rodillas…” —Hob"@es,
        "Chacun de ses gens était habillé d’un haubert de mailles d’acier qui descendait jusqu’aux genoux [...] —Hob"@fr ;
    meccg_prop:rarity "CA" .

meccg:TW-255 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Heilkräuter"@de,
        "Healing Herbs"@en,
        "Hierbas Curativas"@es,
        "Rohtoyrtit"@fi,
        "Herbes médicinales"@fr,
        "Erbe Curative"@it,
        "治癒の薬草"@ja,
        "Healing Herbs"@nl ;
    dc:creator "Quinton Hoover" ;
    dc:identifier "TW-255" ;
    schema1:creator "Quinton Hoover" ;
    schema1:name "Healing Herbs" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "HealingHerbs.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "The bearer can tap and discard this item to heal a character in his company, changing the character’s status from wounded to well and untapped.Alternatively, the bearer can tap and discard this item to untap a character in his company that is not wounded."@en,
        "Puedes girar al portador y descartar este objeto para curar a un personaje de su compañía (el personaje pasa de estar herido a ileso y enderezado).Alternativamente, puedes girar al portador y descartar este objeto para enderezar a un personaje en su compañía."@es,
        "Le porteur peut s’engager et défausser cet objet pour soigner un personnage de sa compagnie (qui passe de blessé à désengagé). Cela n’empêche pas de réaliser un test d’endurance. Ou bien, le porteur peut s’engager et défausser cet objet pour désengager un personnage non blessé de sa compagnie."@fr ;
    meccg_prop:rarity "CA2" .

meccg:TW-256 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Versteck"@de,
        "Hiding"@en,
        "Escondrijo"@es,
        "Piileskely"@fi,
        "Dissimulation"@fr,
        "Nascondersi"@it,
        "隠れる"@ja,
        "Hiding"@nl ;
    dc:creator "Quinton Hoover" ;
    dc:identifier "TW-256" ;
    schema1:creator "Quinton Hoover" ;
    schema1:name "Hiding" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "Hiding.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Scout only. Playable at the end of the organization phase. Scout’s company may not move to another site this turn. Cancels all hazard creature attacks against the scout’s company this turn."@en,
        "Solo exploradores. Jugable al final de la fase de organización. La compañía del explorador no puede moverse a otro lugar este turno. Cancela todos los ataques de adversidades-criatura contra la compañía del explorador este tuno."@es,
        "Éclaireur seulement. Ne peut être jouée qu’à la fin de la phase d’organisation. La compagnie de l’éclaireur ne peut se déplacer vers un autre site ce tour. Annule toutes les attaques de périls de créatures contre la compagnie de l’éclaireur ce tour."@fr ;
    meccg_prop:quote "“They were clad in shadowy-grey, and could not be seen among the tree-stems, unless they moved suddenly.” —LotRII"@en,
        "“Llevaban ropas de un color gris sombra, y no se les distinguía de entre las ramas, a no ser que se movieran bruscamente.” —SdlA I"@es,
        "Ils étaient vêtus d’un gris d’ombre, et on ne pouvait les distinguer parmi les branches s’ils ne faisaient quelque mouvement brusque [...] —SdAII"@fr ;
    meccg_prop:rarity "R" .

meccg:TW-257 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Hügelmenschen"@de,
        "Hillmen"@en,
        "Montañeses"@es,
        "Vuorilaiset"@fi,
        "Hommes des Collines"@fr,
        "Uomini dei Colli"@it,
        "山男"@ja,
        "Hillmen"@nl ;
    dc:creator "Angelo Montanini" ;
    dc:identifier "TW-257" ;
    schema1:creator "Angelo Montanini" ;
    schema1:name "Hillmen" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "Hillmen.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Playable at Cameth Brin if the influence check is greater than 9. Standard Modifications: Men (+1)."@en,
        "Única. Jugable en Cameth Brinsi el chequeo de influencia es superior a 9.Modificaciones Estándar: Hombres (+1)."@es,
        "Uniques. Peuvent être joués à Cameth Brin si le test d’influence est supérieur à 9.Modificateurs standards : Humains (+1)."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:quote "“These were a remnant of the peoples that had dwelt in the vales of the White Mountains in ages past… But in the Dark Years others had removed to the southern dales of the Misty Mountains…” —LotR"@en,
        "“Eran los descendientes de los pueblos que habían vivido en los valles de las Montañas Nubladas en épocas pasadas… Pero durante los Años Oscuros otros los habían empujado a los valles meridionales de las Montañas Nubladas…” —SdlA Apéndices"@es,
        "Ils étaient un vestige des gens qui avaient jadis résidé dans les vallées des Montagnes Blanches [...] Mais dans les Années Sombres d’autres s’étaient déplacés vers les vallons méridionaux des Monts Brumeux [...] —SdA"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "U" .

meccg:TW-258 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Hobbits"@de,
        "Hobbits"@en,
        "Hobbits"@es,
        "Hobitit"@fi,
        "Hobbits"@fr,
        "Hobbit"@it,
        "ホビット"@ja,
        "Hobbits"@nl ;
    dc:creator "Quinton Hoover" ;
    dc:identifier "TW-258" ;
    schema1:creator "Quinton Hoover" ;
    schema1:name "Hobbits" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "Hobbits.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Playable at Bag End if the influence check is greater than 8. Standard Modifications: Hobbits (+4)."@en,
        "Única. Jugable en Bolsón Cerradosi el chequeo de influencia es superior a 8.Modificaciones Estándar: Hobbits (+4)."@es,
        "Uniques. Peuvent être joués à Cul-de-Sac si le test d’influence est supérieur à 8.Modificateurs standards : Hobbits (+4)."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:quote "“They are… a little people… inclined to be fat in the stomach… dress in bright colors… and wear no shoes, because their feet grow natural leathery soles and thick warm brown hair like the stuff on their heads…” —Hob"@en,
        "“Son… gente diminuta… menos corpulenta y fornida… vestían ropas de brillantes colores… muy rara vez usaban zapatos, pues las plantas de los pies eran en ellos duras como el cuero, y los pies mismos estaban cubiertos de un espeso pelo rizado muy parecido al pelo de sus cabezas…” —Hob"@es,
        "Ils forment [...] un petit peuple [...] avec une tendance à l’embonpoint, [...] habillés de couleurs brillantes [...] et ne portant aucunes chaussures, car leurs pieds ont des semelles de cuir naturelles et des poils bruns épais et chauds tout comme leurs cheveux [...] —Hob"@fr ;
    meccg_prop:race "Hobbit" ;
    meccg_prop:rarity "R" .

meccg:TW-259 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Horn von Anor"@de,
        "Horn of Anor"@en,
        "Cuerno de Arnor"@es,
        "Anorin Torvi"@fi,
        "Cor d'Anor"@fr,
        "Corno di Anor"@it,
        "アノールの角笛"@ja,
        "Horn of Anor"@nl ;
    dc:creator "Angelo Montanini" ;
    dc:identifier "TW-259" ;
    schema1:creator "Angelo Montanini" ;
    schema1:name "Horn of Anor" ;
    meccg_prop:alignment "Hero" ;
    meccg_prop:cardImage "HornofAnor.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "+2 to direct influence against factions. Cannot be duplicated on a given character."@en,
        "+2 a la influencia directa contra facciones.No puede ser duplicado en un mismo personaje."@es,
        "+2 à l’influence directe sur une faction. Ne peut être doublé sur un personnage donné."@fr ;
    meccg_prop:directInfluence "0(2)" ;
    meccg_prop:quote "“‘… a great horn of the wild ox of the East, bound with silver, and written with ancient characters. … if it be blown at need anywhere within the bounds of Gondor, as the realm was of old, its voice will not pass unheeded.’” —LotRIV"@en,
        "“‘… un gran cuerno de asta, de buey salvaje del este, guarnecido de plata y adornado con caracteres antiguos… si se le hace sonar en un momento de necesidad dentro de los confines de Gondor, tal como era el reino en otros tiempos, la llamada no será desoída.’” —SdlA II"@es,
        "“[...] un grand cor fait d’une corne de bœuf sauvage de l’Est, montée en argent et gravée de caractères anciens [...] sonné en cas de besoin n’importe où dans les limites du Gondor, tel que le royaume était jadis, il sera répondu à sa voix.” —SdAIV"@fr ;
    meccg_prop:rarity "CB" .

meccg:TW-26 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Daelomin"@de,
        "Daelomin"@en,
        "Daelomin"@es,
        "Daelomin"@fi,
        "Daelomin"@fr,
        "Daelomin"@it,
