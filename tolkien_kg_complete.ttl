    meccg_prop:mind "4" ;
    meccg_prop:prowess "0" ;
    meccg_prop:quote "“Like the best vintages… she was rich in nature and complex in character.” —Kuduk Lore"@en,
        " “Como los mejores viñedos… era de naturaleza rica y carácter complejo” —Sabiduría Kuduk"@es,
        "Comme les meilleurs crus, elle était d’une riche nature et de tempérament complexe. —Légende kuduk"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "R" ;
    meccg_prop:skills "Scout/Sage/Diplomat" .

