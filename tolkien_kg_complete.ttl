    meccg_prop:quote "“… a grim dark band, four score at least of large, swart, slant-eyed Orcs…” —LotRIII"@en,
        "“… una banda gris y oscura, de al menos cuarenta orcos cetrinos y de ojos rasgados…” —SdlA II"@es,
        "[...] une sinistre et sombre bande, d’au moins quatre-vingts Orques verruqueux, grands, aux yeux obliques [...] —SdAIlI"@fr ;
    meccg_prop:race "Orcs" ;
