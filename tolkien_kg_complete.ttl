        "Dwarven Ring of Thélor's Tribe"@nl ;
    dc:creator "Melissa Benson" ;
    dc:identifier "TW-218" ;
    schema1:creator "Melissa Benson" ;
    schema1:name "Dwarven Ring of Thélor’s Tribe" ;
    meccg_prop:alignment "Hero" ;
