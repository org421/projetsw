    meccg_prop:cardImage "Trollchief.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Olog-hai. Leader. Discard on a body check result of 9. +3 direct influence against Trolls, Orcs, Troll factions, and Orc factions."@en,
        "Olog-hai. Líder. Descartar con un chequeo de resistencia de 9. +3 a su influencia directa contra Trolls, Orcos, facciones de Trolls, y facciones de Orcos."@es,
        "Olog-Haï. Chef. Défaussez-le sur un résultat de 9 au test d’endurance. +3 à l’influence directe sur les Trolls, les factions de Trolls, les Orques et les factions d’Orques."@fr ;
    meccg_prop:directInfluence "0" ;
    meccg_prop:homeSite "Any Dark-hold" ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:mind "6" ;
    meccg_prop:prowess "6" ;
    meccg_prop:quote "“‘They are mighty. But Trolls are only counterfeits, made by the Enemy in the Great Darkness, in mockery of Ents…’” —LotRIII"@en,
        "“ʻPero los trolls son solo una impostura, fabricados por el Enemigo en la Gran Oscuridad, una falsa imitación de los Ents…ʼ” —SdlA III"@es,
        "“Ils sont extrêmement forts. Mais ce ne sont que des contrefaçons, créées par l’Ennemi au cours des Grandes Ténèbres en dérision des Ents [...]” —SdAIII"@fr ;
    meccg_prop:race "Troll" ;
    meccg_prop:rarity "U+F1" ;
    meccg_prop:skills "Warrior" .

