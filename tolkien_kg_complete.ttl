    meccg_prop:cardText "Unique. Uruk-hai. Discard on a body check result of 8."@en,
        "Único. Uruk-hai. Descartar con un chequeo de resistencia de 8."@es,
        "Unique. Uruk-Haï. Défaussez-le sur un résultat de 8 au test d’endurance."@fr ;
