meccg:TW-46 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Indûr von Mûmakan"@de,
        "Indûr Dawndeath"@en,
        "Indûr Muerte del Alba"@es,
        "Indûr Kalmankoitto"@fi,
        "Indûr Aubemort"@fr,
        "Indûr Albadimorte"@it,
        "夜明けの死\"\"インドゥア"@ja,
        "Indûr Dawndeath"@nl ;
    dc:creator "Liz Danforth" ;
    dc:identifier "TW-46" ;
    schema1:creator "Liz Danforth" ;
