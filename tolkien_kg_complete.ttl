    meccg_prop:quote "“‘… a worthy wizard… has much lore of herbs and beasts…’” —LotRII"@en,
        "“ʻ… un mago de valor… sabe mucho de hierbas y bestias.ʼ” —SdlA I"@es,
        "[...] un digne magicien [...] il a une grande connaissance des herbes et des bêtes [...] —SdAII"@fr ;
    meccg_prop:race "Wizard" ;
    meccg_prop:rarity "F2" ;
