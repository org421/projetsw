meccg:TW-16 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Bert (Bûrat)"@de,
        "“Bert” (Bûrat)"@en,
        "“Berto” (Bûrat)"@es,
        "Bertti Bûrat)"@fi,
        "“Bert” (Bûrat)"@fr,
        "Bert (Bûrat)"@it,
        "\"バート\"（ブーラト）"@ja,
        "Bert (Bûrat)"@nl ;
    dc:creator "Liz Danforth" ;
    dc:identifier "TW-16" ;
    schema1:creator "Liz Danforth" ;
    schema1:name "“Bert” (Bûrat)" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "-" ;
    meccg_prop:cardImage "BertBurat.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. Troll. One strike. If played against a company that faced “William” or “Tom” this turn, each character wounded by “Bert” discards all non-special items he bears."@en,
        "Único. Troll. Un golpe. Si es jugado contra una compañía que se haya enfrentado a “Guille” o “Tom” este turno, cada personaje herido por “Berto” debe descartarse de todos los objetos no especiales que porte."@es,
        "Unique. Troll. 1 coup. S’il est joué après “William” ou “Tom” et s’il est associé au même site d’itinéraire contre la même compagnie, chaque personnage blessé par “Bert” doit se défausser de tous les objets non spéciaux qu’il porte."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:prowess "12" ;
    meccg_prop:quote "“The trolls had just decided to roast the dwarves now and eat them later—that was Bert’s idea” —Hob"@en,
        "“Los trolls acababan de decidir asar a los enanos ahora y comérselos más tarde — esa fue la idea de Berto.” —Hob"@es,
        "Les trolls venaient de décider de rôtir les nains dès maintenant et de les manger plus tard — c’était l’idée de Bert. —Hob"@fr ;
    meccg_prop:race "Trolls" ;
    meccg_prop:rarity "U" .

