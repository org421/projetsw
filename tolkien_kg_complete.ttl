    meccg_prop:quote "“… an old wife, Ioreth, the eldest of the women who served in that house…” —LotRV"@en,
        "“… Ioreth, una mujer vieja, la más anciana de las servidoras de la casa…” —SdlA III"@es,
        "[...] une vieille femme, Ioreth, la plus âgée de celles qui servaient dans cette maison [...] —SdAV"@fr ;
    meccg_prop:race "Dúnadan" ;
    meccg_prop:rarity "U2" ;
