    meccg_prop:cardText "Unique. Can use shadow-magic."@en,
        "Único. Puede utilizar magia de las sombras."@es,
        "Unique. Peut utiliser la magie de l’ombre."@fr ;
    meccg_prop:directInfluence "2" ;
