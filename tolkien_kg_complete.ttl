meccg:LE-100 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Wilde Trolle"@de,
        "Wild Trolls"@en,
        "Trolls Salvajes"@es,
        "Trolls sauvages"@fr,
        "Wild Trolls"@nl ;
    dc:creator "Steve Otis" ;
