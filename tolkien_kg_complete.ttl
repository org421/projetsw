    meccg_prop:cardImage "Whip.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Orc or Troll only: provides +2 direct influence against one character with a mind and prowess less than the bearer’s. Cannot be duplicated on a given character.[πp]"@en,
        "Solo Orcos o Trolls: +2 a la influencia directa contra un personaje cuya mente y poder sean inferiores a los del portador. No puede ser duplicado sobre un mismo personaje.[πp]"@es,
        "Orque ou Troll seulement : +2 à l’influence directe sur un personnage avec un esprit et une prouesse inférieurs à ceux du porteur. Ne peut être doublé sur un personnage donné. "@fr ;
    meccg_prop:quote "“‘There now!’ he laughed, flicking at their legs. ‘Where there’s a whip there’s a will my slugs.’” —LotRVI"@en,
        "“ʻ¡Ahora!ʼ gritó riendo, azotándoles las piernas ʻDonde hay un látigo hay voluntad, babosas.ʼ” —SdlA III"@es,
        "“Là, maintenant ! disait-il en riant, tout en leur donnant des petits coups de lanière sur les jambes. Où il y a un fouet, il y a du cœur, mes loches.” —SdAVI"@fr ;
    meccg_prop:rarity "U" .

meccg:LE-35 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Ork-Veteran"@de,
        "Orc Veteran"@en,
        "Veterano Orco"@es,
        "Vétéran Orque"@fr,
