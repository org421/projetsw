meccg:DM-181 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Baugúr"@de,
        "Baugúr"@en,
        "Baugúr"@es,
        "Baugúr"@fr,
        "Baugúr"@nl ;
    dc:creator "Jo Hartwig" ;
    dc:identifier "DM-181" ;
    schema1:creator "Jo Hartwig" ;
    schema1:name "Baugúr" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "8" ;
    meccg_prop:cardImage "Baugur.jpg" ;
    meccg_prop:cardSet "DM" ;
    meccg_prop:cardSetName "Dark Minions" ;
    meccg_prop:cardText "Unique.Half-orc. Agent. Leader. Discard on a body check result of 8. +2 direct influence against Orcs and Orc factions. Agent only: Cannot move to Free-holds [{F}] and Border-holds [{B}]."@en,
        "Único.Medio-orco. Agente. Líder. Descartar con un chequeo de resistencia de 8. +2 a su influencia directa contra Orcos y facciones de Orcos. Solo Agente: No puede moverse a un Bastión Libre [{F}] y Bastión Fronterizo [{B}]."@es,
        "Unique. Semi-Orque. Agent. Chef. Défaussez-le sur un résultat de 8 au test d’endurance. +2 à l’influence directe sur les Orques et les factions d’Orques. Agent seulement : ne peut se déplacer vers un fief libre [{F}] ou un fief frontalier [{B}]."@fr ;
    meccg_prop:directInfluence "1" ;
    meccg_prop:homeSite "Isengard" ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:mind "4" ;
    meccg_prop:prowess "4" ;
    meccg_prop:quote "“‘But these creatures of Isengard, these half-orcs and goblinmen that the foul craft of Saruman has bred, they will not quail at the sun,’ said Gamling.” —LotRIII"@en,
        "“ʻPero estas criaturas de Isengard, estos semi-orcos y hombres-bestiales fabricados por las artes inmundas de Saruman, no retrocederán a la luz del solʼ, dijo Gamelin” —SdlA II"@es,
        "“Mais ces créatures de l’Isengard, ces demi Orques et Hommes gobelins fabriqués par l’art immonde de Saroumane, elles ne fléchiront pas devant le soleil, dit Gamelin [...]” —SdAIII"@fr ;
    meccg_prop:race "Orc" ;
    meccg_prop:rarity "P" ;
    meccg_prop:skills "Warrior" .

meccg:DM-182 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Freca"@de,
        "Freca"@en,
        "Freca"@es,
        "Freca"@fr,
        "Freca"@nl ;
    dc:creator "Jo Hartwig" ;
    dc:identifier "DM-182" ;
    schema1:creator "Jo Hartwig" ;
    schema1:name "Freca" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "8" ;
    meccg_prop:cardImage "Freca.jpg" ;
    meccg_prop:cardSet "DM" ;
    meccg_prop:cardSetName "Dark Minions" ;
    meccg_prop:cardText "Unique. Agent. +1 direct influence against Riders of Rohan and Dunlendings."@en,
        "Único. Agente. +1 a su influencia directa contra la facción de los Jinetes de Rohan y los Dunlendinos."@es,
        "Unique. Agent. +1 à l’influence directe sur les Cavaliers de Rohan et les Dunéens "@fr ;
    meccg_prop:directInfluence "2" ;
    meccg_prop:homeSite "Edoras, Dunnish Clan-hold" ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:mind "5" ;
    meccg_prop:prowess "4" ;
    meccg_prop:quote "“Only in Dunland did Men of this race hold to their old speech and manners: a secret folk, unfriendly to the Dúnedain, hating the Rohirrim.” —LotR"@en,
        "“Sólo en las Tierras Brunas los Hombres de esta raza conservaron su propia lengua y costumbres; era éste un pueblo poco comunicativo, estaba enemistado con los Dúnedain, y odiaba a los Rohirrim.” —SdlA Apéndices"@es,
        "C’est seulement au Pays de Dun que les Hommes de cette race avaient conservé leur ancien parler et leurs coutumes d’autrefois : une peuplade mystérieuse, furtive, hostile aux Dúnedain et haïssant les Rohirrim. —SdAVI"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "P" ;
    meccg_prop:skills "Warrior/Diplomat" .

meccg:DM-19 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Leamon"@de,
        "Leamon"@en,
        "Leamon"@es,
        "Leamon"@fr,
        "レアモン"@ja,
        "Leamon"@nl ;
    dc:creator "Quinton Hoover" ;
    dc:identifier "DM-19" ;
    schema1:creator "Quinton Hoover" ;
    schema1:name "Leamon" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "8" ;
    meccg_prop:cardImage "Leamon.jpg" ;
    meccg_prop:cardSet "DM" ;
    meccg_prop:cardSetName "Dark Minions" ;
    meccg_prop:cardText "Unique. Agent."@en,
        "Único. Agente."@es,
        "Unique. Agent."@fr ;
    meccg_prop:directInfluence "0" ;
    meccg_prop:homeSite "Cameth Brin, Dunnish Clan-hold" ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:mind "3" ;
    meccg_prop:prowess "5" ;
    meccg_prop:quote "“Leamon grew up at Cameth Brin, in the shadow of the great ‘Troll Tower,’ and he carried an ageless spear a forefather won from a Dúnadan venturer of fabled Lond Daer.” —Kuduk Lore"@en,
        "“Leamon creció en Cameth Brin, en las sombras de la gran ʻTorre de los Trollsʼ, y empuñaba una antiquísima lanza que uno de sus ancestros ganó a un aventurero dúnadan procedente de la fabulosa Lond Daer.” —Sabiduría Kuduk"@es,
        "Leamon grandit à Cameth Brin, dans l’ombre de la grande “Tour Trolle” . Il portait une lance hors d’âge qu’un aïeul avait prise à un aventurier Dúnadan de la fabuleuse Lond Daer. —Légnde kuduk"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "C1" ;
    meccg_prop:skills "Warrior" .

meccg:DM-2 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Badula"@de,
        "Baduila"@en,
        "Baduila"@es,
        "Baduila"@fr,
        "バドゥイラ"@ja,
        "Baduila"@nl ;
    dc:creator "Stephen Schwartz" ;
    dc:identifier "DM-2" ;
    schema1:creator "Stephen Schwartz" ;
    schema1:name "Baduila" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "8" ;
    meccg_prop:cardImage "Baduila.jpg" ;
    meccg_prop:cardSet "DM" ;
    meccg_prop:cardSetName "Dark Minions" ;
    meccg_prop:cardText "Unique. Agent. Agent only: if you choose to discard Baduila at target company’s new site, company must return to its site of origin."@en,
        "Único. Agente. Solo Agente: si eliges descartar a Baduila en el nuevo lugar de la compañía objetivo, la compañía debe regresar a su lugar de origen."@es,
        "Unique. Agent. Agent seulement : Si vous choisissez de défausser Baduila au nouveau site de la compagnie visée, celle-ci doit revenir à son site d’origine."@fr ;
    meccg_prop:directInfluence "2" ;
    meccg_prop:homeSite "Goblin-gate, Mount Gundabad" ;
    meccg_prop:marshallingPoints "3" ;
    meccg_prop:mind "8" ;
    meccg_prop:prowess "6" ;
    meccg_prop:quote "“They are valliant men and keep open the High Pass and the Ford of Carrock. But their tolls are high… and they are not overfond of dwarves.” —LotRII"@en,
        "“Son hombres valientes, y mantienen abierto el Paso Alto y el Vado de la Carroca. Pero el peaje es elevado… y no gustan mucho de los enanos.” —SdlA I"@es,
        "Ce sont de vaillants hommes, et ils maintiennent ouverts le Haut Col et le Gué de Carrock. Mais leurs péages sont élevés […] et ils n’aiment pas trop les Nains. —SdAII"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "R2" ;
    meccg_prop:skills "Warrior/Scout/Ranger" .

meccg:DM-20 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Nimloth"@de,
        "Nimloth"@en,
        "Nimloth"@es,
        "Nimloth"@fr,
        "ニムロス"@ja,
        "Nimloth"@nl ;
    dc:creator "Ted Nasmith" ;
    dc:identifier "DM-20" ;
    schema1:creator "Ted Nasmith" ;
    schema1:name "Nimloth" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "8" ;
    meccg_prop:cardImage "Nimloth.jpg" ;
    meccg_prop:cardSet "DM" ;
    meccg_prop:cardSetName "Dark Minions" ;
    meccg_prop:cardText "Unique. Agent. +2 direct influence against Elves and Elf Factions. Agent only: may move to a Haven [{H}]."@en,
        "Única. Agente. +2 a la influencia directa contra Elfos y facciones de Elfos. Solo Agente: puede moverse a un Refugio [{H}]."@es,
        "Unique. Agent. +2 à l’influence directe sur les Elfes et les factions d’Elfes. Agent seulement : Peut se déplacer vers un Havre [{H}]."@fr ;
    meccg_prop:directInfluence "1" ;
    meccg_prop:homeSite "Thranduil’s Halls, Sarn Goriwing" ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:mind "4" ;
    meccg_prop:prowess "3" ;
    meccg_prop:quote "“‘White Blossom,’ they called her, for she was named after the kinswoman of Celeborn, the mother of Dior the Jewel-bearer’s children: Eluréd, Eluín, and fair Elwing, mother of Elrond.” —Kuduk Lore"@en,
        "“La llamaban ʻFlor Blancaʼ, pues así fue bautizada en recuerdo de la pariente de Celeborn, la madre de Dior y los hijos del Portador de la Joya: Eluréd Eluín y la hermosa Elwing, la madre de Elrond.” —Sabiduría Kuduk"@es,
        "“Fleur Blanche.” était son nom, en l’honneur de la parente de Celeborn, la mère des enfants de Dior le porteur de joyau : Eluréd, Eluín et la belle Elwing, mère d’Elrond.” —Légende kuduk"@fr ;
    meccg_prop:race "Elf" ;
    meccg_prop:rarity "C1" ;
    meccg_prop:skills "Scout/Ranger" .

meccg:DM-21 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Ôm-buri-Ôm"@de,
        "Ôm-buri-Ôm"@en,
        "Ôm-buri-Ôm"@es,
        "Ôm-buri-Ôm"@fr,
        "オム＝ブリ＝オム"@ja,
        "Ôm-buri-Ôm"@nl ;
    dc:creator "Daniel Horne" ;
    dc:identifier "DM-21" ;
