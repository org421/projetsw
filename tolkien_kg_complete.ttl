    meccg_prop:cardImage "GlitteringCaves.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Nearest Darkhaven: Geann a-LischPlayable: Items (minor, major)Automatic-attacks:Pûkel-creature — 1 strike with 9 prowess"@en,
        "Refugio Oscuro más cercano: Geann a-LischJugable: Objetos (menores, mayores)Ataques Automáticos:Criatura Pûkel — 1 golpe de poder 9"@es,
        "Havre Noir le plus proche : Geann a-LischJouable : Objet (mineur, majeur)Attaques automatiques :Biscornu — 1 coup avec 9 en prouesse"@fr ;
    meccg_prop:quote "“‘… immeasurable halls, filled with an everlasting music of water that tinkles into pools…” —LotRIII"@en,
        "“ʻ… inmensas estancias, llenas de una interminable melodía de agua que tintinea en los manantiales…ʼ”—SdlA II"@es,
        "“[...] des salles incommensurables, emplies de la musique éternelle de l’eau tintant dans des fontaines [...]” —SdAIII"@fr ;
    meccg_prop:rarity "U" ;
    tolkien_prop:depicts tolkien:Glittering_Caves .

