    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Nearest Darkhaven: Dol GuldurPlayable: Items (minor, major, greater, gold ring)Automatic-attacks:Dragon — 1 strike with 15 prowess"@en,
        "Refugio Oscuro más cercano: Dol GuldurJugable: Objetos (menores, mayores, grandes, anillos de oro)Ataques Automáticos:Dragón — 1 golpe de poder 15"@es,
        "Havre Noir le plus proche : Dol GuldurJouable :  Objet (mineur, majeur, supérieur, anneau d'or)Attaques automatiques :Dragon — 1 coup avec 15 en prouesse"@fr ;
    meccg_prop:quote "“‘Up there, in the lone peak, you’ll find more than  just ice and rock. It’s full of gold! Of course,  there’s a price…’” —Kuduk Lore"@en,
        "“ʻAllá arriba, en el pico solitario, encontrarás algo más que hielo y rocas. ¡Está lleno de oro! Naturalmente, tiene un precio…ʼ” —Sabiduría Kuduk"@es,
        "“Là-haut, dans le pic solitaire, vous trouverez plus que de la glace et de la roche. C’est plein d’or ! Bien sûr, il y a un prix à payer [...]” —Légende kuduk "@fr ;
    meccg_prop:rarity "U2" .

meccg:AS-15 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Círdan der Schiffsbauer"@de,
        "Lord of the Haven"@en,
        "Señor de los Puertos"@es,
        "Seigneur du Havre"@fr,
        "Lord of the Haven"@nl ;
    dc:creator "David A. Cherry" ;
    dc:identifier "AS-15" ;
    schema1:creator "David A. Cherry" ;
    schema1:name "Lord of the Haven" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "9" ;
    meccg_prop:cardImage "LordoftheHaven.jpg" ;
    meccg_prop:cardSet "AS" ;
    meccg_prop:cardSetName "Against the Shadow" ;
    meccg_prop:cardText "Unique. Elf. Manifestation of Círdan. One strike. Detainment against hero companies. As a creature, may be played keyed to Lindon or any Coastal Sea [{c}] region; or at sites in these regions. As a short-event, tap up to two target characters in one company at a site in, or moving through, a Coastal Sea [{c}] region."@en,
        "Único. Elfo. Manifestación de Círdan. Un golpe. Retención contra compañías de héroes.Como criatura, puede ser jugado situado en Lindon o cualquier región de Costa [{c}]; o en los lugares de dichas regiones.Como suceso breve, gira hasta dos personajes objetivo en una compañía situada en, o que se esté moviendo a través de, una región de Costa [{c}]."@es,
        "Unique. Elfe. Manifestation de Círdan. 1 coup. Dilatoire contre les compagnies de héros. En tant que créature, peut être joué en association avec le Lindon ou n’importe quelle mer côtière [{c}] ainsi qu’aux sites de ces régions. En tant qu’événement court, engagez jusqu’à deux personnages visés d’une compagnie à un site dans, ou qui traverse, une région de mer côtière [{c}]."@fr ;
    meccg_prop:marshallingPoints "3*" ;
    meccg_prop:prowess "13" ;
    meccg_prop:race "Elves" ;
    meccg_prop:rarity "R2" .

