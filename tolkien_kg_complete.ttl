    meccg_prop:body "-" ;
    meccg_prop:cardImage "Orclieutenant.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Orcs. One strike. If played on a company that has already faced an Orc attack this turn, Orc-lieutenant receives +4 prowess."@en,
        "Orco. Un golpe. Si es jugado sobre una compañía que se ha enfrentado a un ataque de Orcos este turno, el Lugarteniente Orco recibe +4 al poder."@es,
        "Orque. 1 coup. S’il est joué sur une compagnie qui a déjà affronté une attaque Orque ce tour, le Lieutenant Orque reçoit +4 à sa prouesse."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:prowess "7" ;
    meccg_prop:quote "“Then suddenly, without warning, Uglûk sprang forwards, and with two swift strokes swept the heads off two of his opponents.” —LotRIII"@en,
        "“En seguida, sin ningún aviso, Uglûk saltó hacia adelante, lanzó dos golpes rápidos y las cabezas de dos orcos rodaron por el suelo.” —SdlA II"@es,
        "Puis tout à coup, sans crier gare, Ouglouk bondit en avant et, de deux coups rapides, il trancha la tête de deux de ses opposants. —SdAIIl"@fr ;
    meccg_prop:race "Orcs" ;
    meccg_prop:rarity "U" .

