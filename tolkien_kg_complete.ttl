meccg:LE-67 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Leichenlicht"@de,
        "Corpse-candle"@en,
        "Vela Cadavérica"@es,
        "Chandelle de cadavre"@fr,
        "Corpse-candle"@nl ;
    dc:creator "Steven Cavallo" ;
    dc:identifier "LE-67" ;
    schema1:creator "Steven Cavallo" ;
    schema1:name "Corpse-candle" ;
    meccg_prop:alignment "Neutral" ;
