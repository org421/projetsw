    meccg_prop:prowess "3" ;
    meccg_prop:quote "“‘There’s only one thing these maggots can do: they can see like gimlets in the dark.’” —LotRIII"@en,
        "“ʻHay una sola cosa que puedan hacer estos gusanos: tienen ojos que penetran como taladros en la oscuridad.ʼ” —SdlA II"@es,
        "“Ces larves ne sont capables que d’une chose : ils ont les yeux perçants comme des vrilles dans les ténèbres.” —SdAIII"@fr ;
    meccg_prop:race "Orc" ;
    meccg_prop:rarity "C3" ;
