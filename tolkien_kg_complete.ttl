    schema1:image <https://tolkiengateway.net/wiki/Durin#/media/File:Artigas_-_Durin_I_the_Deathless.jpg> ;
    schema1:jobTitle "King of Durin's Folk",
        "King of Khazad-dûm" ;
    schema1:knowsLanguage "Khuzdul" ;
    schema1:mainEntityOfPage tolkien:Durin ;
    schema1:memberOf tolkien:Seven_Fathers_of_the_Dwarves,
        "Dwarves" ;
    schema1:name "Durin" ;
    schema1:parent tolkien:Aul%C3%AB,
        tolkien:Il%C3%BAvatar,
        tolkien:f%C3%ABa ;
    foaf:depiction <https://tolkiengateway.net/wiki/Durin#/media/File:Artigas_-_Durin_I_the_Deathless.jpg> ;
    foaf:gender "male" ;
    foaf:isPrimaryTopicOf tolkien:Durin ;
    tolkien_prop:affiliation tolkien:Seven_Fathers_of_the_Dwarves ;
    tolkien_prop:age "2,395+Years of the Sun. Each Year of the Trees is equal to 9.582 Years of the Sun, and the Years of the Trees ended in the year 1500. So, 9.582 x 250 = 2,395." ;
    tolkien_prop:house tolkien:House_of_Durin ;
    tolkien_prop:notableFor "Founding Khazad-dûm" ;
