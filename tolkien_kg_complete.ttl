meccg:LE-101 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Aufstacheln der Verteidiger"@de,
        "Arouse Defenders"@en,
        "Perturbar a los Defensores"@es,
        "Rameuter les défenseurs"@fr,
        "Arouse Defenders"@nl ;
    dc:creator "Nicholas Jainschigg" ;
    dc:identifier "LE-101" ;
    schema1:creator "Nicholas Jainschigg" ;
    schema1:name "Arouse Defenders" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "ArouseDefenders.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a Free-hold [{F}] or Border-hold [{B}]. This turn, the prowess of one automatic-attack (your choice) at target site is increased by 2 and cannot be canceled. Cannot be duplicated on a given site."@en,
        "Jugable sobre un Bastión Libre [{F}] o un Bastión Fronterizo [{B}]. Este turno, el poder de un ataque automático (a tu elección) en el lugar objetivo aumenta en 2 y no puede ser cancelado. No puede ser duplicada en un mismo lugar."@es,
        "Peut être joué sur un fief libre [{F}] ou un fief frontalier [{B}]. Ce tour-ci, une attaque automatique (de votre choix) sur le site visé a sa prouesse augmentée de 2 et ne peut pas être annulée. Ne peut être doublé sur un site donné."@fr ;
    meccg_prop:quote "“‘Come!’ said Aragorn. ‘This is the hour when we draw swords together!’” —LotRIII"@en,
        "“ʻ¡Vamos!ʼ dijo Aragorn ʻ¡Ha llegado la hora de las espadas!ʼ” —SdlA II"@es,
        "“Venez ! dit Aragorn C’est le moment de tirer l’épée ensemble !” —SdAIII"@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-102 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Aufstacheln der Bewohner"@de,
        "Arouse Denizens"@en,
        "Perturbar a los Moradores"@es,
        "Rameuter les résidents"@fr,
        "Arouse Denizens"@nl ;
    dc:creator "Pamela Shanteau" ;
    dc:identifier "LE-102" ;
    schema1:creator "Pamela Shanteau" ;
    schema1:name "Arouse Denizens" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "ArouseDenizens.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a Ruins & Lairs [{R}]. This turn, the prowess of one automatic-attack (your choice) at target site is increased by 3.Cannot be duplicated on a given site."@en,
        "Jugable sobre unas Ruinas y Guaridas [{R}]. Este turno, el poder de un ataque automático (a tu elección) en el lugar objetivo aumenta en un 3.No puede ser duplicada en un mismo lugar."@es,
        "Peut être joué sur un site de ruines et antres [{R}]. Ce tour-ci, la prouesse d’une attaque automatique du site visé est augmentée de 3. Ne peut être doublé sur un site donné."@fr ;
    meccg_prop:quote "“… hundreds of black bears dancing slow heavy dances round and round in the moonlight…” —Hob"@en,
        "“… cientos de osos negros bailando lentas danzas en corros bajo la luz de la luna.” —Hob"@es,
        "[...] des centaines d’ours noirs dansaient lentement et avec lourdeur tout en rond sous la lune [...] —Hob"@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-103 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Erwachen der Verteidiger"@de,
        "Awaken Defenders"@en,
        "Despertar a los Defensores"@es,
        "Éveiller les défenseurs"@fr,
        "Awaken Defenders"@nl ;
    dc:creator "John C. Duke" ;
    dc:identifier "LE-103" ;
    schema1:creator "John C. Duke" ;
    schema1:name "Awaken Defenders" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "AwakenDefenders.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "The number of strikes for each automatic-attack at a Free-hold [{F}] or Border-hold [{B}] is doubled. Additionally, each detainment automatic-attack at a Free-hold [{F}] or Border-hold [{B}] becomes a normal automatic-attack. Cannot be duplicated."@en,
        "Se dobla el número de golpes de cada ataque automático en un Bastión Libre [{F}] o un Bastión Fronterizo [{B}]. Además, cada ataque automático de retención en un Bastión Libre [{F}] o Bastión Fronterizo [{B}] se convierte en un ataque automático normal. No puede ser duplicada."@es,
        "Le nombre de coups de chaque attaque automatique à un fief libre [{F}] ou un fief frontalier [{B}] est doublé. De plus chaque attaque automatique dilatoire sur un fief libre [{F}] ou un fief frontalier [{B}] devient une attaque automatique normale. Ne peut être doublé."@fr ;
    meccg_prop:quote "“… the light of the fires showed up many a mark for archers of such skill as Gondor once had boasted.” —LotRI"@en,
        "“… la luz del fuego era suficiente para llamar la atención de arqueros como los que antaño había tenido Gondor.” —SdlA I"@es,
        "[...] la lumière des feux offrait beaucoup de cibles parfaites pour des archers d’un talent tel que ceux que possédaient jadis ceux du Gondor. —SdAI"@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-104 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Erwachen der Bewohner"@de,
        "Awaken Denizens"@en,
        "Despertar a los Moradores"@es,
        "Éveiller les résidents"@fr,
        "Awaken Denizens"@nl ;
    dc:creator "David Monette" ;
    dc:identifier "LE-104" ;
    schema1:creator "David Monette" ;
    schema1:name "Awaken Denizens" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "AwakenDenizens.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "The number of strikes for each automatic-attack at a Ruins & Lairs [{R}] site is doubled.Cannot be duplicated."@en,
        "Se dobla el número de golpes para cada ataque automático en unas Ruinas y Guaridas [{R}]. No puede ser duplicada."@es,
        "Le nombre de coups de chaque attaque automatique à un site de ruines et antres [{R}] est doublé. Ne peut être doublé."@fr ;
    meccg_prop:quote "“‘… I have a sense of watchfulness, and of fear, that I have never had here before.’” —LotRIII"@en,
        "“ʻ… tengo una sensación de que me están vigilando, y un miedo que nunca hasta ahora había sentido.ʼ”—SdlA III"@es,
        "“[...] j’ai une impression de vigilance et de peur comme jamais auparavant.” —SdAIII"@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-105 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Ruf der Heimat"@de,
        "Call of Home"@en,
        "La Llamada del Hogar"@es,
        "Appel du foyer"@fr,
        "Call of Home"@nl ;
    dc:creator "Jon Foster" ;
    dc:identifier "LE-105" ;
    schema1:creator "Jon Foster" ;
    schema1:name "Call of Home" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "CallofHome.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a non-Ringwraith, non-Wizard character not bearing The One Ring. The character's player makes a roll. The character returns to his player’s hand if the result plus his player’s unused general influence is less than 10.Any one item held by the removed character may automatically be transferred to another character in his company (all other non-follower cards he controls are discarded)."@en,
        "Jugable sobre un personaje que no sea Mago, Espectro del Anillo, ni el portador de El Anillo Único. El jugador que controla el personaje hace una tirada. El personaje vuelve a la mano de su jugador si el resultado más la influencia general sin utilizar del jugador es inferior a 10.Cualquier objeto portado por el personaje eliminado puede ser transferido automáticamente a otro personaje de su compañía (todas las demás cartas que controle el personaje objetivo y que no sean seguidores son descartadas)."@es,
        "Peut être joué sur un personnage non Sorcier, non Spectre, non porteur de L’Anneau Unique. Le joueur du personnage fait un jet. Si le résultat plus son influence générale inemployée est inférieur à 10, remettez le personnage dans la main du joueur. Un objet quelconque du personnage ainsi retiré peut être automatiquement transféré à un autre personnage (même blessé) de sa compagnie (toutes les autres cartes non suivant que le personnage contrôle sont défaussées)."@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-106 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Kraft der Verzweiflung"@de,
        "Chill Them with Fear"@en,
        "Atemorizarles"@es,
        "Faites-leur peur"@fr,
        "Chill Them with Fear"@nl ;
    dc:creator "Christina Wald" ;
    dc:identifier "LE-106" ;
    schema1:creator "Christina Wald" ;
    schema1:name "Chill Them with Fear" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "ChillThemwithFear.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "All Elf, Dwarf, Dúnadan, and Hobbit attacks receive +2 prowess and +2 strikes (+1 prowess and +1 strike if Doors of Night is in play). Cannot be duplicated."@en,
        "Todos los ataques de Elfos, Dúnedain, Enanos y Hobbits reciben un +2 al poder y +2 golpes (+1 al poder y +1 golpe si están en juego las Puertas de la Noche). No puede ser duplicada."@es,
        "Toute attaque d’Elfe, de Nain, de Dúnadan et de Hobbit reçoit +2 à la prouesse et +2 coups (+1 en prouesse et +1 coup si les Portes de la Nuit sont en jeu). Ne peut être doublé."@fr ;
    meccg_prop:quote "“… yet another weapon, swifter than hunger… dread and despair.” —LotRV"@en,
        "“… tenía otra arma, más rápida que el hambre: el miedo y la desesperación.” —SdlA III"@es,
        "[...] encore une autre arme, plus vive que la faim [...] la terreur et le désespoir. —SdAV"@fr ;
    meccg_prop:rarity "R" .

meccg:LE-107 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Eifersucht"@de,
        "Covetous Thoughts"@en,
        "Pensamientos Ávidos"@es,
        "Convoitise"@fr,
        "Covetous Thoughts"@nl ;
    dc:creator "Cortney Skinner" ;
    dc:identifier "LE-107" ;
    schema1:creator "Cortney Skinner" ;
    schema1:name "Covetous Thoughts" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "CovetousThoughts.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Corruption. Playable only on a minion. At the end of each of his turns, target minion makes a corruption check for each item his company bears that he does not bear. For each check, modify the roll by subtracting the corruption of that item. During his organization phase, the minion may tap to attempt to remove this card. Make a roll—if the result is greater than 5, discard this card. Cannot be duplicated on a given minion."@en,
        "Corrupción. Jugable sobre un servidor. Al final de cada uno de tus turnos, el servidor objetivo hace un chequeo de corrupción por cada objeto que haya en su compañía y no esté en su poder. Modifica cada chequeo restando los puntos de corrupción de ese objeto.Durante su fase de organización, el servidor puede girarse para intentar eliminar esta carta. Haz una tirada—si el resultado es superior a 5, descarta esta carta. No puede ser duplicada sobre un mismo servidor."@es,
        "Corruption. Ne peut être jouée que sur un séide. À la fin de chacun de ses tours, le séide visé fait un test de corruption pour chaque objet que sa compagnie possède et qu’il ne porte pas. Pour chaque test, modifiez le jet en soustrayant la corruption de l’objet. Pendant la phase d’organisation, le séide peut s’engager pour tenter de l’enlever. Faites un jet. Si le résultat est supérieur à 5, défaussez cette carte. Ne peut être doublée sur un séide donné."@fr ;
    meccg_prop:rarity "U" .

meccg:LE-108 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Dunkelheit unter Bäumen"@de,
        "Darkness Under Tree"@en,
        "Oscuridad Bajo los Árboles"@es,
        "Ténèbres sous les arbres"@fr,
        "Darkness Under Tree"@nl ;
    dc:creator "David Monette" ;
    dc:identifier "LE-108" ;
    schema1:creator "David Monette" ;
    schema1:name "Darkness Under Tree" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "DarknessUnderTree.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on an untapped Orc, Troll, or Man character if Doors of Night is in play. Tap the character."@en,
        "Jugable sobre un personaje Orco, Troll, u Hombre enderezado si están en juego las Puertas de la Noche. Gira el personaje."@es,
        "Peuvent être jouées sur un personnage Orque, Troll ou Humain si les Portes de la Nuit sont en jeu. Engagez le personnage."@fr ;
    meccg_prop:quote "“… there now a forest loomed. Great trees, bare and silent, stood, rank on rank, with tangled bow and hoary head; their twisted roots were buried in the long green grass. Darkness was under them.” —LotRIII"@en,
        "“… allí se elevaba un bosque. Grandes árboles, pelados y silenciosos, se elevaban, fila tras fila, con sus ramas enredadas y sus copas tupidas: sus retorcidas raíces se enterraban bajo la larga hierba verde. Bajo ellos reinaba la oscuridad.” —SdlA II"@es,
        "[...] une forêt s’étendait là. De grands arbres, nus et silencieux, se dressaient, en rangs innombrables, troncs enchevêtrés et cimes ébouriffées ; leurs racines tordues étaient enfoncées dans une haute herbe verte. Les ténèbres s’étendaient sous eux. —SdAIII"@fr ;
    meccg_prop:rarity "R" .

meccg:LE-109 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Verzweiflung des Herzens"@de,
        "Despair of the Heart"@en,
        "Desesperanza del Corazón"@es,
        "Désespoir du cœur "@fr,
        "Despair of the Heart"@nl ;
    dc:creator "Angus McBride" ;
    dc:identifier "LE-109" ;
    schema1:creator "Angus McBride" ;
    schema1:name "Despair of the Heart" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "DespairoftheHeart.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Corruption. Playable on a non-Hobbit, non-Wizard, non-Ringwraith character. Target character receives 2 corruption points and makes a corruption check each time a character in his company becomes wounded. During his organization phase, the character may tap to attempt to remove this card. Make a roll—if the result is greater than 4, discard this card. Cannot be duplicated on a given character."@en,
        "Corrupción. Jugable sobre un personaje que no sea Hobbit, Mago ni Espectro del Anillo. El personaje objetivo recibe 2 puntos de corrupción y hace un chequeo de corrupción cada vez que uno de los personajes de su compañía resulta herido.Durante su fase de organización, el personaje puede girarse para intentar eliminar esta carta. Haz una tirada—si el resultado es superior a 4, descarta esta carta. No puede ser duplicada sobre un mismo personaje."@es,
        "Corruption. Peut être joué sur un personnage non Sorcier, non Spectre, non Hobbit. Le personnage visé reçoit 2 points de corruption et fait un test de corruption chaque fois qu’un personnage de sa compagnie est blessé. Le test de corruption est effectué avant le test d’endurance. Pendant sa phase d’organisation, un personnage avec cette carte peut s’engager pour tenter de la retirer. Faites un jet. Si le résultat est supérieur à 4, défaussez cette carte. Ne peut être doublé sur un personnage donné."@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-11 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Gorbag"@de,
        "Gorbag"@en,
        "Gorbag"@es,
        "Gorbag"@fr,
        "Gorbag"@nl ;
    dc:creator "Jon Foster" ;
    dc:identifier "LE-11" ;
    schema1:creator "Jon Foster" ;
    schema1:name "Gorbag" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:body "9" ;
    meccg_prop:cardImage "Gorbag.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. Uruk-hai. Leader. Discard on a body check result of 9. +3 direct influence against Orcs and Orc factions."@en,
        "Único. Uruk-hai. Líder. Descartar con un chequeo de resistencia de 9. +3 a su influencia directa contra Orcos y facciones de Orcos."@es,
        "Unique. Uruk-Haï. Chef. Défaussez-le sur un résultat de 9 au test d’endurance. +3 à l’influence directe sur les Orques et les factions d’Orques."@fr ;
    meccg_prop:directInfluence "0" ;
    meccg_prop:homeSite "Minas Morgul" ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:mind "6" ;
    meccg_prop:prowess "6" ;
    meccg_prop:quote "“‘… you and me’ll slip off and set up somewhere on our own with a few trusty lads, somewhere where there’s good loot nice and handy, and no big bosses.” —LotRII"@en,
        "“… si tenemos alguna oportunidad de escapar tú y yo por nuestra cuenta, con algunos muchachos de confianza, a algún lugar donde haya un botín bueno y fácil de conseguir, y nada de grandes patrones.” —SdlA II"@es,
        "“[...] toi et moi, on filerait quelque part pour notre propre compte avec quelques types de confiance, quelque part où il y aurait un bon butin facile et à portée, sans grands patrons.” —SdAIV"@fr ;
    meccg_prop:race "Orc" ;
    meccg_prop:rarity "F1" ;
    meccg_prop:skills "Warrior/Scout" .

meccg:LE-110 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Tore der Nacht"@de,
        "Doors of Night"@en,
        "Puertas de la Noche"@es,
        "Portes de la Nuit"@fr,
        "Doors of Night"@nl ;
    dc:creator "John Howe" ;
    dc:identifier "LE-110" ;
    schema1:creator "John Howe" ;
    schema1:name "Doors of Night" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "DoorsofNight.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Environment. When Doors of Night is played, all resource environment cards in play are immediately discarded, and all resource environment effects are canceled.Cannot be duplicated."@en,
        "Ambiental. Cuando las Puertas de la Noche son jugadas, todas las cartas de recursos ambientales en juego son descartadas inmediatamente, y todos los efectos de recursos ambientales son cancelados.No puede ser duplicada."@es,
        "Environnement. Quand les Portes de la Nuit sont jouées, toutes les cartes d’environnement en jeu sont aussitôt défaussées, et tous les effets de ressources d’environnement sont annulés. Ne peuvent être doublées."@fr ;
    meccg_prop:quote "“One by one white stars sprang forth as the sky faded.” —LotRII"@en,
        "“Una tras otra fueron asomando las estrellas blancas, en el cielo que se apagaba” —SdlA I"@es,
        "Une par une, des étoiles blanches apparaissaient avec la décoloration du ciel. —SdAII"@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-111 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Grausamer Winter"@de,
        "Fell Winter"@en,
        "Crudo Invierno"@es,
        "Hiver féroce"@fr,
        "Fell Winter"@nl ;
    dc:creator "Ronald Chironna" ;
    dc:identifier "LE-111" ;
    schema1:creator "Ronald Chironna" ;
    schema1:name "Fell Winter" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "FellWinter.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Environment. Each Border-hold [{B}] receives an additional automatic-attack: Wolves — 3 strikes with 7 prowess. Additionally, if Doors of Night is in play, treat all Free-domains [{f}] as Border-lands [{b}] and all Border-lands [{b}] as Wildernesses [{w}]. Cannot be duplicated."@en,
        "Ambiental. Cada Bastión Fronterizo [{B}] gana un ataque automático adicional: Lobos — 3 golpes de poder 7.Adicionalmente, si están en juego las Puertas de la Noche, trata todas las Regiones Libres [{f}] como Tierras Fronterizas [{b}] y todas las TierrasFronterizasFronterizas [{b}] como Tierras Salvajes [{w}]. No puede ser duplicada."@es,
        "Environnement. Chaque fief frontalier [{B}] reçoit une attaque automatique supplémentaire : Loups — 3 coups avec 7 en prouesse. De plus si les Portes de la Nuit sont en jeu, considérez tous les domaines libres [{f}] comme des terres frontalières [{b}] et toutes les terres frontalières [{b}] comme des contrées sauvages [{w}]. Ne peut être doublé."@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-112 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Törichte Worte"@de,
        "Foolish Words"@en,
        "Palabras Necias"@es,
        "Paroles stupides"@fr,
        "Foolish Words"@nl ;
    dc:creator "Angus McBride" ;
    dc:identifier "LE-112" ;
    schema1:creator "Angus McBride" ;
    schema1:name "Foolish Words" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "FoolishWords.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a character. Any riddling roll, offering attempt, or influence attempt by target character is modified by -4. If placed on-guard, it may be revealed and played when a character in the company declares such an attempt. During his organization phase, the character may tap to attempt to remove this card. Make a roll—if the result is greater than 7, discard this card. Cannot be duplicated on a given character."@en,
        "Jugable sobre un personaje. Cualquier tirada de acertijos, intento de oferta, o intento de influencia por parte del personaje objetivo es modificada con un -4. Si es colocada en guardia, puede ser revelada y jugada cuando un personaje de la compañía declara uno de dichos intentos. Durante su fase de organización, el personaje puede girarse para intentar eliminar esta carta. Haz una tirada—si el resultado es superior a 7, descarta esta carta. No puede ser duplicada sobre un mismo personaje."@es,
        "Peuvent être jouées sur n’importe quel personnage. Tout jet de devinette, tentative de don, ou d’influence du personnage visé est modifié de -4. Placée en sentinelle, cette carte peut être révélée et jouée quand un personnage de la compagnie déclare une telle tentative. Pendant sa phase d’organisation, le personnage qui a cette carte peut s’engager pour tenter de l’enlever. Faites un jet. Si le résultat est supérieur à 7, défaussez cette carte. Ne peuvent être doublées sur un personnage donné."@fr ;
    meccg_prop:rarity "CB+CS2" .

meccg:LE-113 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Gier"@de,
        "Greed"@en,
        "Codicia"@es,
        "Cupidité"@fr,
        "Greed"@nl ;
    dc:creator "Donato Giancola" ;
    dc:identifier "LE-113" ;
    schema1:creator "Donato Giancola" ;
    schema1:name "Greed" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "Greed.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a site. Until the end of the turn, each non-Hobbit, non-Wizard, non-Ringwraith character at the site must make a corruption check each time an item is played at the site. The character playing an item need not make a corruption check. When a character makes one of these checks, it is modified by subtracting the corruption points the item would normally give  the character if he controlled it. Cannot be duplicated on a given site."@en,
        "Jugable sobre un lugar. Hasta el final del turno, cada personaje que no sea Hobbit, Mago, ni Espectro del Anillo en el lugar debe hacer un chequeo de corrupción cada vez que se juega un objeto en el lugar. El personaje que pone en juego el objeto no necesita hacer el chequeo de corrupción. Cuando un personaje realiza uno de estos chequeos, es modificado restando los puntos de corrupción que el objeto otorgaría normalmente al personaje si lo controlara. No puede ser duplicada sobre un mismo lugar."@es,
        "Peut être jouée sur un site. Jusqu’à la fin du tour, tout personnage non Hobbit, non Sorcier, non Spectre au site doit faire un test de corruption chaque fois qu’un objet y est joué. Le personnage qui joue l’objet n’a pas besoin de faire un test de corruption. Ces tests sont modifiés en soustrayant les points de corruption que l’objet donnerait au personnage s’il le contrôlait. Ne peut être doublé sur un site donné."@fr ;
    meccg_prop:rarity "CB+CS2" .

meccg:LE-114 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Maßlose Ausschweifungen"@de,
        "Heedless Revelry"@en,
        "Jolgorio Descuidado"@es,
        "Festivités insouciantes"@fr,
        "Heedless Revelry"@nl ;
    dc:creator "Chris Trevas" ;
    dc:identifier "LE-114" ;
    schema1:creator "Chris Trevas" ;
    schema1:name "Heedless Revelry" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "HeedlessRevelry.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a non-Ringwraith company that is not moving. Make a roll for each untapped non-Wizard character in the company; modify this roll by -2 for hero characters. If the result is greater than the character’s mind, the character becomes tapped. Alternatively, may be revealed as an on-guard card on a company in response to the play of an item, ally, or faction (does not interfere with the playing of the card it is revealed in response to). Tap all untapped non-Ringwraith, non-Wizard characters in the company."@en,
        "Jugable sobre una compañía que no contenga ningún Espectro del Anillo y no se esté moviendo. Haz una tirada por cada personaje enderezado que no sea Mago; modifica esa tirada con un -2 para personajes héroes. Si el resultado es superior a la mente del personaje, el personaje queda girado.Alternativamente, puede ser revelada como una carta en guardia sobre una compañía en respuesta a la puesta en juego de un objeto, aliado, o facción (no interfiere con la puesta en juego de la carta a la que responde). Gira a todos los personajes enderezados de la compañía que no sean Magos ni Espectros del Anillo."@es,
        "Peuvent être jouées sur une compagnie non Spectre qui ne se déplace pas. Faites un jet pour chaque personnage non Sorcier désengagé dans la compagnie modifié de -2 pour les personnages héros. Si le résultat est supérieur à l’esprit du personnage, celui-ci est engagé. Ou bien, peuvent être révélées en sentinelle sur une compagnie, en réponse à la mise en jeu d’un objet, d’un allié ou d’une faction (cela n’interfère pas avec cette mise en jeu). Engagez tous les personnages non Sorcier, non Spectre de la compagnie."@fr ;
    meccg_prop:rarity "R" .

meccg:LE-115 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Aufwiegeln der Verteidiger"@de,
        "Incite Defenders"@en,
        "Incitar a los Defensores"@es,
        "Animer les défenseurs"@fr,
        "Incite Defenders"@nl ;
    dc:creator "Brad Williams" ;
    dc:identifier "LE-115" ;
    schema1:creator "Brad Williams" ;
    schema1:name "Incite Defenders" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "InciteDefenders.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a Border-hold [{B}] or Free-hold [{F}]. An additional automatic-attack is created at the site until the end of the turn. This is an exact duplicate (including all existing and eventual modifications to prowess, etc.) of an existing automatic-attack of your choice at the site. This automatic-attack is faced immediately following its original.Cannot be duplicated on a given site."@en,
        "Jugable sobre un Bastión Fronterizo [{B}] o un Bastión Libre [{F}]. Se crea un ataque automático adicional en el lugar hasta el final del turno. Se trata de un duplicado exacto (incluyendo todas las modificaciones existentes y eventuales al poder, etc.) de uno de los ataques automáticos existentes en el lugar (a tu elección). La compañía debe enfrentarse a este ataque automático inmediatamente después del original. No puede ser duplicada sobre un mismo lugar."@es,
        "Peut être joué sur un fief frontalier [{B}] ou un fief libre [{F}]. Crée une attaque automatique supplémentaire au site jusqu’à la fin du tour. Cette attaque est une copie exacte (y compris de tout modificateur existant ou éventuel à la prouesse, etc.) d’une attaque automatique de votre choix à ce site. Elle est subie juste après l’attaque automatique qu’elle copie. Ne peut être doublé sur un site donné. "@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-116 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Aufwiegeln der Bewohner"@de,
        "Incite Denizens"@en,
        "Incitar a los Moradores"@es,
        "Animer les résidents"@fr,
        "Incite Denizens"@nl ;
    dc:creator "Angus McBride" ;
    dc:identifier "LE-116" ;
    schema1:creator "Angus McBride" ;
    schema1:name "Incite Denizens" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "InciteDenizens.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a Ruins & Lairs [{R}]. An additional automatic-attack is created at the site until the end of the turn. This is an exact duplicate (including all existing and eventual modifications to prowess, etc.) of an existing automatic-attack at the site of your choice. This automatic-attack is faced immediately following its original. Cannot be duplicated on a given site."@en,
        "Jugable sobre una Ruinas y Guaridas [{R}]. Se crea un ataque automático adicional en el lugar hasta el final del turno. Se trata de un duplicado exacto (incluyendo todas las modificaciones existentes y eventuales al poder, etc.) de uno de los ataques automáticos existentes en el lugar (a tu elección). La compañía debe enfrentarse a este ataque automático inmediatamente después del original. No puede ser duplicada sobre un mismo lugar."@es,
        "Peut être joué sur un site de ruines et antres [{R}]. Crée une attaque automatique supplémentaire sur le site jusqu’à la fin du tour. Cette attaque est une copie exacte (y compris tout modificateur existant ou éventuel à la prouesse, etc.) d’une des attaques automatiques de votre choix à ce site. Elle est subie juste après l’attaque automatique qu’elle copie. Ne peut être doublée sur un site donné."@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-117 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Langer Winter"@de,
        "Long Winter"@en,
        "Largo Invierno"@es,
        "Long hiver"@fr,
        "Long Winter"@nl ;
    dc:creator "R. Ward Shipman" ;
    dc:identifier "LE-117" ;
    schema1:creator "R. Ward Shipman" ;
    schema1:name "Long Winter" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "LongWinter.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Environment. Each moving company that has at least two Wildernesses [{w}] in its site path must return to its site of origin unless it contains a ranger. Additionally, if Doors of Night is in play, each non-Haven/non-Darkhaven site in play with at least two Wildernesses [{w}] in its site path is tapped. Cannot be duplicated."@en,
        "Ambiental. Cada compañía que tenga al menos dos Tierras Salvajes [{w}] en su itinerario debe regresar a su lugar de origen a menos que contenga un montaraz. Además, si están en juego las Puertas de la Noche, cada lugar en juego que no sea un Refugio/Refugio Oscuro con al menos dos Tierras Salvajes [{w}] en su itinerario es girado.No puede ser duplicada."@es,
        "Environnement. À moins qu’elle ne compte un rôdeur parmi ses membres, chaque compagnie en déplacement qui possède au moins 2 contrées sauvages [{w}] dans son itinéraire doit revenir à son site d’origine. De plus si les Portes de la Nuit sont en jeu, chaque site non Havre et non Havre Noir qui possède au moins 2 contrées sauvages [{w}] dans son itinéraire est engagé. Ne peut être doublé."@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-118 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Verirrt in Grenzlanden"@de,
        "Lost in Border-lands"@en,
        "Perdidos en las Tierras Fronterizas"@es,
        "Perdus en terres frontalières"@fr,
        "Lost in Border-lands"@nl ;
    dc:creator "Stephen Daniele" ;
    dc:identifier "LE-118" ;
    schema1:creator "Stephen Daniele" ;
    schema1:name "Lost in Border-lands" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "LostinBorderlands.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a moving company. Its hazard limit increases by one for every Border-land [{b}] in its site path."@en,
        "Jugable sobre una compañía que se esté moviendo. Su límite de adversidades aumenta en uno por cada Tierra Fronteriza [{b}] en su itinerario."@es,
        "Peut être joué sur une compagnie en déplacement. Sa limite de péril augmente de 1 pour chaque terre frontalière [{b}] dans son itinéraire."@fr ;
    meccg_prop:quote "“But now all the land was empty, and there was a silence that did not seem to be the quiet of peace.” —LotRIII"@en,
        "“Pero ahora todas aquellas tierras estaban vacías, y reinaba un silencio que no se parecía en nada a la tranquilidad de la paz.” —SdlA II"@es,
        "Mais désormais, tout le pays est vide et il y a un silence qui ne ressemble pas au calme de la paix. —SdAIII"@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-119 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Verirrt in Freien Reichen"@de,
        "Lost in Free-domains"@en,
        "Perdidos en las Regiones Libres"@es,
        "Perdus dans les domaines libres"@fr,
        "Lost in Free-domains"@nl ;
    dc:creator "Ted Nasmith" ;
    dc:identifier "LE-119" ;
    schema1:creator "Ted Nasmith" ;
    schema1:name "Lost in Free-domains" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "LostinFreedomains.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Playable on a company moving with a Free-domain [{f}] in its site path.The company may do nothing during its site phase."@en,
        "Jugable sobre una compañía que se esté moviendo con una Región Libre [{f}] en su itinerario.La compañía no puede hacer nada durante su fase de lugares."@es,
        "Peut être joué sur une compagnie en déplacement. La compagnie ne doit rien faire pendant sa phase de site si elle a un domaine libre [{f}] dans son itinéraire."@fr ;
    meccg_prop:quote "“… and they were also no longer certain of the direction in which they were going.” —LotRI"@en,
        "“… y ya no estaban seguros de en qué dirección estaban avanzando.” —SdlA I"@es,
        "[...] en plus ils n’étaient plus certain de leur direction. —SdAI"@fr ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-12 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Grishnákh"@de,
        "Grishnákh"@en,
        "Grishnákh"@es,
        "Grishnákh"@fr,
        "Grishnákh"@nl ;
    dc:creator "Omar Rayyan" ;
    dc:identifier "LE-12" ;
