    meccg_prop:cardText "Weapon. Warrior only: +2 to prowess to a maximum of 8."@en,
        "Arma. Solo guerreros: +2 al poder hasta un máximo de 8."@es,
        "Arme. Guerrier seulement : +2 à la prouesse (maximum 8)."@fr ;
    meccg_prop:marshallingPoints "2" ;
    meccg_prop:prowess "+2" ;
    meccg_prop:quote "“‘They are old swords, very old swords of the High Elves of the West, my kin. They were made in Gondolin for the Goblin-wars.’” —Hob"@en,
        "“‘Son espadas antiguas, muy antiguas, de los Altos Elfos del Oeste, mis parientes. Están hechas en Gondolin para las guerras de los trasgos.’” —Hob"@es,
        "“Ce sont de vieilles épées, de très vieilles épées des Hauts Elfes de l’Ouest, mes parents. Elles furent faites en Gondolin pour les guerres gobelines.” —Hob"@fr ;
    meccg_prop:rarity "CA2" .

meccg:TW-337 a meccg_class:Card,
        meccg_class:Resource ;
    rdfs:label "Wahre Freundschaft"@de,
        "Tempering Friendship"@en,
        "Fiel Amistad"@es,
        "Ystävyyden Vahvistus"@fi,
