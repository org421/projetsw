        "“… orcos patizambos de brazos largos… ”—SdlA II"@es,
        "[...] des Orques aux longs bras et aux jambes torses. —SdAIII"@fr ;
    meccg_prop:race "Orc" ;
    meccg_prop:rarity "CB+CS1" ;
    meccg_prop:skills "Warrior" .

