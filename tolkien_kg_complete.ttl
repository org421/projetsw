    meccg_prop:cardText "Shield. +1 to body to a maximum of 9."@en,
        "Escudo. +1 a la resistencia hasta un máximo de 9."@es,
        "Bouclier. +1 à l’endurance (maximum 9)"@fr ;
    meccg_prop:quote "“Upon their shields… a black field…” —LotRIII"@en,
        "“Sobre sus escudos… un fondo negro…”—SdlA III"@es,
        "Sur les boucliers [...] un fond noir [...] —SdAIII"@fr ;
