    meccg_prop:cardText "Orcs. Four strikes."@en,
        "Orcos. Cuatro golpes."@es,
        "Orques. 4 coups."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:prowess "6" ;
    meccg_prop:quote "“… Uglûk’s followers leaped over him and cut down another with their broad-bladed swords. It was the yellow-fanged guard. His bloody body fell… still clutching his long saw-edged knife.” —LotRIII"@en,
        "“… los seguidores de Uglûk saltaron por encima de él y derribaron a otro con las espadas de hoja ancha. La víctima era el guardián de las garras amarillas. El cuerpo le cayó encima… la mano de orco empuñando todavía aquel largo cuchillo mellado.” —SdlA II"@es,
        "[...] les suivants d’Ouglouk bondirent par-dessus lui pour en faucher un autre de leur épée à large lame. C’était le gardien aux crocs jaunes. Son corps tomba [...] la main encore crispée sur son long poignard dentelé. —SdAIII"@fr ;
    meccg_prop:race "Orcs" ;
    meccg_prop:rarity "CA2" .

meccg:TW-76 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Ork-Kriegsmeute"@de,
        "Orc-warband"@en,
        "Hueste Orca"@es,
        "Örkkien Sotajoukko"@fi,
        "Escouade Orque"@fr,
        "Banda di Orchetti"@it,
        "オーク戦闘団"@ja,
        "Orc-warband"@nl ;
    dc:creator "Heather Hudson" ;
