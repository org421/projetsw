    meccg_prop:marshallingPoints "2" ;
    meccg_prop:mind "5" ;
    meccg_prop:prowess "4" ;
    meccg_prop:quote "“… he passed out of the knowledge of Men of the West, and went alone far into the East and deep into the South, exploring the hearts of Men, both evil and good, and uncovering the plots and devices of Sauron.” —LotR"@en,
        "“… desapareció de las crónicas de los Hombres del Oeste, y viajó lejos al Este, y se internó en el Sur, explorando los corazones de los Hombres, buenos y malos, y desvelando los ardides y las tramas de Sauron.” —SdlA Apéndices"@es,
        "[...] il partit seul dans l’Est et s’enfonça profondément dans le Sud, explorant les cœurs des Hommes, tant mauvais que bons, et déjouant les complots et les stratagèmes des serviteurs de Sauron. —SdA"@fr ;
    meccg_prop:race "Dúnadan" ;
    meccg_prop:rarity "R" ;
    meccg_prop:skills "Warrior/Diplomat" .

