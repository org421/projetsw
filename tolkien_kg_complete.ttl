    meccg_prop:prowess "10" ;
    meccg_prop:quote "“… devouring people waked suddenly from their sleep.” —Hob"@en,
        "“… devorando a gente que despertaba repentinamente de su sueño… Y mucho antes, dijeron, los soldados trasgos vendrían, bajando de las montañas; y los trasgos pueden trepar a los árboles, o derribarlos.”—Hob"@es,
        "Ils dévorent les gens qu’ils sortent brusquement de leur sommeil. —Hob"@fr ;
    meccg_prop:race "Orcs" ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-78 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Pferdeherren"@de,
        "Horse-lords"@en,
        "Señores de los Caballos"@es,
        "Seigneurs des chevaux"@fr,
        "Horse-lords"@nl ;
    dc:creator "Brad Williams" ;
    dc:identifier "LE-78" ;
    schema1:creator "Brad Williams" ;
    schema1:name "Horse-lords" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:body "6" ;
    meccg_prop:cardImage "Horselords.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Men. Each character in the company faces one strike (detainment against covert and hero companies). May be played keyed to Rohan, Wold & Foothills, Gap of Isen, and Anórien; and may also be played at non-Haven sites in these regions. May not be played against a company containing a character with Edoras as a home site."@en,
        "Hombres. Cada personaje de la compañía se enfrenta a un golpe (de retención contra compañías encubiertas o de héroe). Pueden ser jugados situados en: Rohan, Páramo y Colinas, Desfiladero del Isen, y Anórien; y también pueden ser jugados en los lugares que no sean Refugios de dichas regiones. No pueden ser jugados contra una compañía que contenga un personaje cuyo lugar natal sea Edoras."@es,
        "Humains. Chaque personnage de la compagnie affronte 1 coup (dilatoire contre les compagnies voilées et les compagnies de héros). Peuvent être joués en association avec le Rohan, le Plateau, la Trouée de l’Isen et l’Anórien ainsi que aux sites normaux de ces régions. Ils ne peuvent pas être joués contre une compagnie qui contient un personnage avec Edoras en site natal."@fr ;
    meccg_prop:marshallingPoints "2*" ;
    meccg_prop:prowess "10" ;
    meccg_prop:race "Men" ;
    meccg_prop:rarity "CB+CS1" .

meccg:LE-79 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Huorn"@de,
        "Huorn"@en,
        "Ucorno"@es,
        "Huorn"@fr,
        "Huorn"@nl ;
