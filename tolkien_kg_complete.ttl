    meccg_prop:cardImage "Mountainmaggot.jpg" ;
    meccg_prop:cardSet "BA" ;
    meccg_prop:cardSetName "The Balrog" ;
    meccg_prop:cardText "Balrog specific. Discard on a body check result of 7."@en,
        "Específica del Balrog. Descartar con un chequeo de resistencia de 7."@es,
        "Spécifique au Balrog. Défaussez-le sur un résultat de 7 au test d’endurance."@fr ;
    meccg_prop:directInfluence "0" ;
