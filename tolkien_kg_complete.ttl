meccg:LE-5 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Carambor"@de,
        "Carambor"@en,
        "Carambor"@es,
        "Carambor"@fr,
        "Carambor"@nl ;
    dc:creator "Tom Cross" ;
    dc:identifier "LE-5" ;
    schema1:creator "Tom Cross" ;
    schema1:name "Carambor" ;
    meccg_prop:alignment "Minion" ;
