    meccg_prop:prowess "6" ;
    meccg_prop:quote "“… he was a great Orc with a huge iron-clad head, and yet agile and strong.” —LotR"@en,
        "“… era un gran Orco con una enorme cabeza guarne- cida de hierro… ágil y fuerte.” —SdlA Apéndices"@es,
        "[...] c’était un Orque gigantesque, à la tête énorme coiffée de fer, mais une créature rapide et puissante. —SdA"@fr ;
    meccg_prop:race "Orc" ;
    meccg_prop:rarity "C1" ;
    meccg_prop:skills "Warrior/Diplomat" ;
    tolkien_prop:depicts tolkien:Azog .

