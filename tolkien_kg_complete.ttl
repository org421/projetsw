        meccg_class:Card,
        meccg_class:Site ;
    rdfs:label "Cirith Ungol"@de,
        "Cirith Ungol"@en,
        "Cirith Ungol"@es,
        "Cirith Ungol"@fr,
        "Cirith Ungol"@nl ;
    dc:creator "Douglass Chaffee" ;
    dc:identifier "LE-362" ;
    schema1:about tolkien:Cirith_Ungol ;
    schema1:creator "Douglass Chaffee" ;
    schema1:name "Cirith Ungol" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "CirithUngol.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Nearest Darkhaven: Minas Morgul"@en,
        "Refugio Oscuro más cercano: Minas Morgul"@es,
        "Havre Noir le plus proche : Minas Morgul"@fr ;
    meccg_prop:quote "“It was indeed one of the works of Gondor long ago, an eastern outpost of Ithilien…” —LotRVI"@en,
        "“Era en verdad una de las antiguas obras de Gondor, un puesto oriental de avanzada de las defensas de Ithilien, edificado luego de la Última Alianza, cuando los hombres del Oesternesse vigilaban el maléfico país de Sauron, donde todavía acechaban muchas criaturas.”—SdlA III"@es,
        "C’était en fait l’un des ouvrages de Gondor dans un temps très lointain, avant-poste oriental des défenses de l’Ithilien [...] —SdAVI"@fr ;
    meccg_prop:rarity "U" ;
    tolkien_prop:depicts tolkien:Cirith_Ungol .

meccg:LE-363 a schema1:Place,
        meccg_class:Card,
        meccg_class:Site ;
    rdfs:label "Thal"@de,
