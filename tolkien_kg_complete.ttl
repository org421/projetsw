    meccg_prop:cardImage "Dunlendings.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. Manifestation of hero Dunlendings. Playable at Dunnish Clan-hold  if the influence check is greater than 9. Standard Modifications:Hillmen (+2)."@en,
        "Única. Manifestación de los Dunlendinos héroes. Jugable en el Fuerte Dunlendinosi el chequeo de influencia es superior a 9. Modificaciones Estándar:Montañeses (+2)."@es,
        "Uniques. Manifestation des Dunéens héros. Peuvent être joués au Camp fortifié dunéen si le test d’influence est supérieur à 9. Modificateurs standards : Hommes des Collines (+2)."@fr ;
    meccg_prop:marshallingPoints "4" ;
    meccg_prop:quote "“Brazen trumpets sounded… There… were mustered… the wild men of the Dunland fells.” —LotRIII"@en,
        "“Resonaron las trompetas de bronce… montañeses salvajes de las Tierras Oscuras..” —SdlA II"@es,
        "Des trompettes d’airain retentirent [...] Là étaient rassemblés [...] les montagnards sauvages du Pays de Dun. —SdAIII"@fr ;
    meccg_prop:race "Man" ;
    meccg_prop:rarity "R" .

