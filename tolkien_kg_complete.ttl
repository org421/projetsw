meccg:TD-18 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Drachenkrankheit"@de,
        "Dragon-sickness"@en,
        "Mal del Dragón"@es,
        "Fièvre des Dragons"@fr,
        "竜の黄金病"@ja,
        "Dragon-sickness"@nl ;
    dc:creator "Stephen Schwartz" ;
    dc:identifier "TD-18" ;
    schema1:creator "Stephen Schwartz" ;
    schema1:name "Dragon-sickness" ;
    meccg_prop:alignment "Neutral" ;
    meccg_prop:cardImage "Dragonsickness.jpg" ;
    meccg_prop:cardSet "TD" ;
    meccg_prop:cardSetName "The Dragons" ;
    meccg_prop:cardText "Playable on a character bearing a major or greater item. Character makes a corruption check modified by -1."@en,
        "Jugable sobre un personaje que porte un objeto mayor o un gran objeto. El personaje debe hacer un chequeo de corrupción modificado con un -1."@es,
        "Peut être joué sur un personnage qui porte un objet majeur ou supérieur. Le personnage fait un test de corruption modifié de -1."@fr ;
    meccg_prop:quote "“… being of the kind that easily catches such disease he fell under the dragon-sickness, and took most of the gold and fled with it…” —Hob"@en,
        "“… era un hombre propenso a contagiarse de ciertas enfermedades, y había sido atacado por el mal del dragón, y apoderándose de la mayor parte del oro, había huído con él…” —Hob"@es,
        "[...] étant de ceux qui attrapent aisément ce genre de maladie il fut victime de la fièvre des dragons et prit la plupart de l’or pour s’enfuir avec [...] —Hob"@fr ;
    meccg_prop:rarity "C2" .

