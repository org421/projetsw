    meccg_prop:cardText "Site Path From Rivendell: {w}{w}{b}{w}Site Path From Edhellond: {w}{b}{f}{f}{b}{w}"@en,
        "Itinerario desde Rivendel: {w}{w}{b}{w}Itinerario desde Edhellond: {w}{b}{f}{f}{b}{w}"@es,
        "Itinéraire depuis Fondcombe : {w}{w}{b}{w}Itinéraire depuis Edhellond : {w}{b}{f}{f}{b}{w}"@fr ;
    meccg_prop:quote "“‘There are no trees like the trees of that land. For in autumn their leaves fall not, but turn to gold. Not till the spring comes… do they fall, and then the boughs are laden with golden flowers…’” —LotRII"@en,
        "“‘No hay otros árboles como los árboles de aquella tierra. Pues en otoño sus hojas no caen, sino que se vuelven doradas. No caen hasta que llega la primavera, y entonces las ramas están cargadas de flores doradas…’” —SdlA I"@es,
        "“Nuls arbres ne ressemblent à ceux de cette terre. Car, en automne, leurs feuilles ne tombent point, mais se muent en or. “ —SdAII"@fr ;
    meccg_prop:rarity "CB" ;
    tolkien_prop:depicts tolkien:Lothl%C3%B3rien .

