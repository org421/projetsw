    meccg_prop:cardImage "Broin.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. +1 prowess against Orcs and Elves."@en,
        "Único. +1 a su poder contra Orcos y Elfos."@es,
        "Unique. +1 à la prouesse contre les Orques et les Elfes"@fr ;
    meccg_prop:directInfluence "0" ;
    meccg_prop:homeSite "Moria" ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:mind "3" ;
    meccg_prop:prowess "3" ;
    meccg_prop:quote "“Though they could be slain or broken, they could not be reduced to shadows enslaved to another will…” —LotR"@en,
        "“Aunque podían ser muertos o quebrantados, no era posible reducirlos a sombras esclavizadas a otra voluntad…” —SdlA Apéndices"@es,
        "Ils pouvaient être tués ou brisés, mais ils ne pouvaient être réduits à des ombres soumises à une autre volonté [...] —SdA"@fr ;
    meccg_prop:race "Dwarf" ;
    meccg_prop:rarity "R" ;
    meccg_prop:skills "Warrior/Scout" .

meccg:LE-30 a schema1:Person,
        meccg_class:Card,
        meccg_class:Character ;
    rdfs:label "Orkischer Randalierer"@de,
        "Orc Brawler"@en,
        "Soldado Orco"@es,
        "Lutteur Orque"@fr,
        "Orc Brawler"@nl ;
    dc:creator "Douglas Beekman" ;
