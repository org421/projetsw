    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Unique. +2 direct influence against the Men of Dorwinion faction."@en,
        "Único. +2 a su influencia directa contra la facción de los Hombres de Dorwinion."@es,
        "Unique. +2 à l’influence directe sur la faction des Hommes du Dorwinion"@fr ;
    meccg_prop:directInfluence "2" ;
