        "Orcos. Tres golpes."@es,
        "Orques. 3 coups."@fr ;
    meccg_prop:marshallingPoints "1" ;
    meccg_prop:prowess "6" ;
    meccg_prop:quote "“… hundreds of hideous orc-faces grinned at him out of the shadows, hundreds of hideous arms grasped at him from every side.” —LotRIII"@en,
        "“… centenares de orcos lo miraban desde las sombras haciendo muecas, y centenares de brazos horribles se extendían hacia él.” —SdlA II"@es,
        "[...] des centaines de visages orques hideux grimaçaient dans l’ombre, des centaines de bras hideux l’agrippaient de tous côtés. —SdAIII"@fr ;
    meccg_prop:race "Orcs" ;
    meccg_prop:rarity "CA2" .

meccg:TW-75 a meccg_class:Card,
        meccg_class:Hazard ;
    rdfs:label "Ork-Räuberbande"@de,
        "Orc-raiders"@en,
        "Incursores Orcos"@es,
        "Örkkirosvot"@fi,
        "Maraudeurs Orques"@fr,
        "Orchetti Razziatori"@it,
        "オーク襲撃隊"@ja,
        "Orc-raiders"@nl ;
    dc:creator "Heather Hudson" ;
