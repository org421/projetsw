    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Site Path From Dol Guldur:{d}{b}{d}{s}Site Path From Geann a-Lisch: {w}{w}{w}{w}{s}Special: Unless this site is a character’s home site, a non-Orc, non-Troll character may not be brought into play at this site. Any gold ring stored at this site is automatically tested (modify the roll by -2). Any attack against a minion company at this site is canceled."@en,
        "Itinerario desde Dol Guldur:{d}{b}{d}{s}Itinerario desde Geann a-Lisch:{w}{w}{w}{w}{s}Especial: A menos de que se trate de su lugar natal, no se pueden poner en juego en este lugar personajes que no sean Orcos o Trolls. Cualquier anillo de oro almacenado en este lugar es examinado automáticamente (modificando la tirada con un -2). Cualquier ataque contra una compañía de servidores que se encuentre en este lugar es cancelado."@es,
        "Itinéraire depuis Dol Guldur: {d}{b}{d}{s}Itinéraire depuis Geann a-Lisch: {w}{w}{w}{w}{s}"@fr ;
    meccg_prop:rarity "CB+F5" ;
    tolkien_prop:depicts tolkien:Carn_D%C3%BBm .

meccg:LE-361 a schema1:Place,
        meccg_class:Card,
        meccg_class:Site ;
    rdfs:label "Cirith Gorgor"@de,
        "Cirith Gorgor"@en,
        "Cirith Gorgor"@es,
        "Cirith Gorgor"@fr,
        "Cirith Gorgor"@nl ;
    dc:creator "Eric David Anderson" ;
    dc:identifier "LE-361" ;
    schema1:about tolkien:Cirith_Gorgor ;
    schema1:creator "Eric David Anderson" ;
    schema1:name "Cirith Gorgor" ;
    meccg_prop:alignment "Minion" ;
    meccg_prop:cardImage "CirithGorgor.jpg" ;
    meccg_prop:cardSet "LE" ;
    meccg_prop:cardSetName "The Lidless Eye" ;
    meccg_prop:cardText "Nearest Darkhaven: Minas Morgul"@en,
        "Refugio Oscuro más cercano: Minas Morgul"@es,
        "Havre Noir le plus proche : Minas Morgul"@fr ;
    meccg_prop:quote "“This was Cirith Gorgor, the Haunted Pass, the entrance to the land of the Enemy.” —LotRVI"@en,
        "“Era Cirith Gorgor, el Paso Maldito, la entrada a la tierra del Enemigo. La flanqueaban unos altos acantilados, y dos colinas desnudas y casi verticales de osamenta negra emergían de la boca de la garganta.” —SdlA III"@es,
        "C’était Cirith Gorgor, le Pas Hanté, l’entrée du pays de l’Ennemi. —SdAIV"@fr ;
    meccg_prop:rarity "U" ;
    tolkien_prop:depicts tolkien:Cirith_Gorgor .

