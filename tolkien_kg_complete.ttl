    meccg_prop:prowess "1" ;
    meccg_prop:quote "“‘I’ll get there, if I leave everything but my bones behind… And I’ll carry Mr. Frodo up myself…’” —LotRVI"@en,
        "“ʻLlegaré, aunque deje todo menos los huesos por el camino… Y llevaré al Señor Frodo…ʼ” —SdlA III"@es,
        "“J’y arriverai, dussé-je tout laisser derrière hormis mes os, [...] Et je porterai Monsieur Frodon jusqu’en haut [...]” —SdAVI"@fr ;
    meccg_prop:race "Hobbit" ;
    meccg_prop:rarity "U" ;
