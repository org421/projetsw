    meccg_prop:cardImage "Pallando.jpg" ;
    meccg_prop:cardSet "TW" ;
    meccg_prop:cardSetName "The Wizards" ;
    meccg_prop:cardText "Unique. You may keep one more card than normal in your hand.Opponent must discard his cards face-up."@en,
        "Único. Puedes mantener una carta más de lo normal en tu mano. El oponente debe descartarse dejando las cartas boca arriba."@es,
        "Unique. Le joueur qui le contrôle peut avoir une carte de plus dans sa main. L’adversaire doit défausser ses cartes face visible, vous ne pouvez voir que la carte supérieure de sa pile de défausse."@fr ;
    meccg_prop:directInfluence "10" ;
    meccg_prop:homeSite "Grey Havens" ;
    meccg_prop:prowess "6" ;
    meccg_prop:quote "“They came therefore in the shape of Men, though they were never young and aged only slowly…” —LotR"@en,
        "“Llegaron por tanto con aspecto de Hombres, aunque no había jóvenes entre ellos y envejecían muy lentamente, y tenían muchos poderes, mentales y manuales.” —SdlA Apéndices"@es,
        "C’est pourquoi ils vinrent sous figure humaine, bien qu’ils ne fussent jamais jeunes, et ne vieillissent que très lentement [...] —SdA "@fr ;
    meccg_prop:race "Wizard" ;
    meccg_prop:rarity "F2" ;
    meccg_prop:skills "Warrior/Ranger/Sage/Diplomat" .

meccg:TW-176 a schema1:Person,
