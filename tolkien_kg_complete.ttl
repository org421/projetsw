    meccg_prop:quote "“Dragons steal gold and jewels…” —Hob"@en,
        "“Los dragones roban oro y joyas…” —Hob"@es,
        "Les dragons volent de l’or et des joyaux [...] —Hob"@fr ;
    meccg_prop:race "Dragon" ;
    meccg_prop:rarity "R" .

